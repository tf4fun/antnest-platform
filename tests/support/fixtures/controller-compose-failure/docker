#!/usr/bin/env python3
"""One owned-fixture failure after removing its old service, before create."""
import json
import os
from pathlib import Path
import re
import subprocess
import sys

args=sys.argv[1:]
real=os.environ['CONTROLLER_FIXTURE_DOCKER']
marker=Path(os.environ['CONTROLLER_FIXTURE_MARKER'])
assert marker.is_absolute() and '.cache' not in marker.parts and '.cache' not in marker.resolve().parts
assert Path(real).is_absolute() and Path(real).resolve()!=Path(__file__).resolve()
service=os.environ.get('CONTROLLER_FIXTURE_SERVICE','agent-controller')
assert service in ('agent-controller','runtime-controller','temporal')
if args and args[0]=='compose' and 'up' in args and args[-1]==service and not marker.exists():
    target=os.environ['CONTROLLER_FIXTURE_ID']
    name=os.environ['CONTROLLER_FIXTURE_NAME']
    project=os.environ['CONTROLLER_FIXTURE_PROJECT']
    assert re.fullmatch(r'[a-f0-9]{64}',target)
    def call(*argv):
        return subprocess.check_output([real,*argv],timeout=30)
    row=json.loads(call('inspect',target))[0]
    assert row['Id']==target and row['Name']=='/'+name
    assert row['Config']['Labels']['com.docker.compose.project']==project
    assert row['Config']['Labels']['com.docker.compose.service']==service
    fd=os.open(marker,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600)
    with os.fdopen(fd,'w') as stream:json.dump(dict(container=target,phase='remove-before-create'),stream)
    call('stop','-t','10',target)
    stopped=json.loads(call('inspect',target))[0]['State']
    assert stopped['Status']=='exited' and stopped['ExitCode']==0 and not stopped['OOMKilled']
    call('rm','-v',target)
    sys.stderr.write('Injected owned service create failure after normal removal\n')
    sys.exit(73)
os.execv(real,[real,*args])
