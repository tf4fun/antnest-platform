[
  {
    "name": "format-final",
    "command": [
      "make",
      "fmt-check"
    ],
    "env": {
      "COMPOSE_PARALLEL_LIMIT": "1",
      "COMPOSE_ENV_FILES": ".env.example"
    },
    "pause_file": {
      "input": "output",
      "relative": "pause-before-next"
    },
    "timeout_ms": 1200000,
    "grace_ms": 180000
  },
  {
    "name": "shared-final",
    "command": [
      "sh",
      "-c",
      "node --test --test-concurrency=1 tests/support/*.test.mjs tests/support/verification/*.test.mjs tests/integration/deployment/*.test.mjs tests/integration/deployment/temporal/*.test.mjs tests/e2e/*/*.test.mjs"
    ],
    "env": {
      "COMPOSE_PARALLEL_LIMIT": "1",
      "COMPOSE_ENV_FILES": ".env.example"
    },
    "pause_file": {
      "input": "output",
      "relative": "pause-before-next"
    },
    "timeout_ms": 1200000,
    "grace_ms": 180000
  },
  {
    "name": "ui-final",
    "command": [
      "npm",
      "--prefix",
      "services/agent-ui/web",
      "test"
    ],
    "env": {
      "COMPOSE_PARALLEL_LIMIT": "1",
      "COMPOSE_ENV_FILES": ".env.example"
    },
    "pause_file": {
      "input": "output",
      "relative": "pause-before-next"
    },
    "timeout_ms": 1200000,
    "grace_ms": 180000
  },
  {
    "name": "node-lint-final",
    "command": [
      "make",
      "node-lint"
    ],
    "env": {
      "COMPOSE_PARALLEL_LIMIT": "1",
      "COMPOSE_ENV_FILES": ".env.example"
    },
    "pause_file": {
      "input": "output",
      "relative": "pause-before-next"
    },
    "timeout_ms": 1200000,
    "grace_ms": 180000
  }
]
