[
  {
    "name": "rust-fmt",
    "command": [
      "cargo",
      "fmt",
      "--manifest-path",
      {
        "input": "manifest"
      },
      "--all",
      "--check"
    ],
    "timeout_ms": 120000,
    "grace_ms": 30000
  },
  {
    "name": "rust-clippy",
    "command": [
      "cargo",
      "clippy",
      "--manifest-path",
      {
        "input": "manifest"
      },
      "--locked",
      "--all-targets",
      "--",
      "-D",
      "warnings"
    ],
    "timeout_ms": 1200000,
    "grace_ms": 30000
  },
  {
    "name": "rust-test",
    "command": [
      "cargo",
      "test",
      "--manifest-path",
      {
        "input": "manifest"
      },
      "--locked"
    ],
    "timeout_ms": 1200000,
    "grace_ms": 30000
  }
]
