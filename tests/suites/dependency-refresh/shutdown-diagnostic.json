[
  {
    "name": "lifecycle-shutdown",
    "command": ["make", "e2e-lifecycle-shutdown"],
    "accepted_exits": [0, 2],
    "check_resources": true,
    "pin_images": true,
    "env": {
      "COMPOSE_PARALLEL_LIMIT": "1",
      "COMPOSE_ENV_FILES": ".env.example"
    },
    "pause_file": {
      "input": "output",
      "relative": "pause-before-next"
    },
    "timeout_ms": 1200000,
    "grace_ms": 180000
  }
]
