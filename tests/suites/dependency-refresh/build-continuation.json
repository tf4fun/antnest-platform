  {
    "name": "build-egress",
    "command": [
      "docker",
      "build",
      "--pull",
      "--progress=plain",
      "--no-cache",
      "-f",
      "services/runtime-egress/Dockerfile",
      "-t",
      {
        "input": "build_egress_image"
      },
      "."
    ],
    "env": {
      "COMPOSE_PARALLEL_LIMIT": "1",
      "COMPOSE_ENV_FILES": ".env.example"
    },
    "pause_file": {
      "input": "output",
      "relative": "pause-before-next"
    },
    "timeout_ms": 3600000,
    "grace_ms": 180000
  },
