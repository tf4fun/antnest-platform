[
  {
    "name": "acp-database",
    "command": [
      "node",
      "tests/support/dependencies.mjs",
      "--profile",
      "postgres",
      "--output",
      {
        "input": "output",
        "relative": "dependencies"
      },
      "--name",
      "acp-database",
      "--",
      "sh",
      "-c",
      "npm --prefix services/agent-acp-service run test:postgres && npm --prefix services/agent-acp-service run test:audit:v1"
    ],
    "check_resources": true,
    "timeout_ms": 1200000,
    "grace_ms": 30000
  }
]
