[
  {
    "name": "format",
    "command": ["make", "fmt-check"],
    "timeout_ms": 600000
  },
  {
    "name": "ui-types",
    "command": ["npm", "--prefix", "services/agent-ui/web", "run", "typecheck"],
    "timeout_ms": 180000,
    "grace_ms": 15000
  },
  {
    "name": "storage-policy",
    "command": ["make", "test-storage-policy"],
    "timeout_ms": 180000
  },
  {
    "name": "diff-whitespace",
    "command": ["git", "diff", "--check"],
    "timeout_ms": 60000
  }
]
