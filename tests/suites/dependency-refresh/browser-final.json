[
  {
    "name": "workspace-browser",
    "command": ["make", "e2e-workspace-browser"],
    "accepted_exits": [0, 1, 2],
    "check_resources": true,
    "pin_images": true,
    "env": {
      "COMPOSE_PARALLEL_LIMIT": "1",
      "COMPOSE_ENV_FILES": ".env.example"
    },
    "pause_file": {
      "input": "output",
      "relative": "pause-before-next"
    },
    "timeout_ms": 1200000,
    "grace_ms": 180000
  },
  {
    "name": "c4-browser",
    "command": ["node", "tests/e2e/workspace-closeout/c4-run.mjs"],
    "accepted_exits": [0, 1, 2],
    "check_resources": true,
    "pin_images": true,
    "env": {
      "COMPOSE_PARALLEL_LIMIT": "1",
      "COMPOSE_ENV_FILES": ".env.example"
    },
    "pause_file": {
      "input": "output",
      "relative": "pause-before-next"
    },
    "timeout_ms": 1200000,
    "grace_ms": 180000
  }
]
