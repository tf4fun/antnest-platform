[
  {
    "name": "acp-sdk-audit-postgres",
    "command": [
      "node",
      "tests/support/dependencies.mjs",
      "--profile",
      "postgres",
      "--output",
      {
        "input": "output",
        "relative": "dependencies"
      },
      "--name",
      "acp-sdk-audit-postgres-database",
      "--timeout-ms",
      "900000",
      "--grace-ms",
      "15000",
      "--startup-wait-seconds",
      "30",
      "--",
      "npm",
      "--prefix",
      "services/agent-acp-service",
      "run",
      "test:audit:v1"
    ],
    "check_resources": true,
    "env": {
      "COMPOSE_PARALLEL_LIMIT": "1",
      "COMPOSE_ENV_FILES": ".env.example"
    },
    "pause_file": {
      "input": "output",
      "relative": "pause-before-next"
    },
    "timeout_ms": 1200000,
    "grace_ms": 180000
  },
  {
    "name": "postgres",
    "command": [
      "make",
      "test-postgres"
    ],
    "check_resources": true,
    "env": {
      "COMPOSE_PARALLEL_LIMIT": "1",
      "COMPOSE_ENV_FILES": ".env.example"
    },
    "pause_file": {
      "input": "output",
      "relative": "pause-before-next"
    },
    "timeout_ms": 1200000,
    "grace_ms": 180000
  },
  {
    "name": "persistence-opt-in",
    "command": [
      "node",
      "tests/support/dependencies.mjs",
      "--profile",
      "postgres",
      "--output",
      {
        "input": "output",
        "relative": "dependencies"
      },
      "--name",
      "persistence-opt-in-database",
      "--timeout-ms",
      "900000",
      "--grace-ms",
      "15000",
      "--startup-wait-seconds",
      "30",
      "--",
      "sh",
      "-c",
      "node --test --test-concurrency=1 tests/e2e/acp-persistence/*.test.mjs"
    ],
    "check_resources": true,
    "env": {
      "COMPOSE_PARALLEL_LIMIT": "1",
      "COMPOSE_ENV_FILES": ".env.example"
    },
    "pause_file": {
      "input": "output",
      "relative": "pause-before-next"
    },
    "timeout_ms": 1200000,
    "grace_ms": 180000
  },
  {
    "name": "runtime-image-contract",
    "command": [
      "sh",
      "-c",
      "export GOCACHE=\"$PWD/.cache/go-build\" GOMODCACHE=\"$PWD/.cache/go-mod\"; exec \"$@\"",
      "runtime-image-contract",
      "node",
      "tests/support/docker-test-images.mjs",
      "--image",
      {
        "input": "runtime_test_image"
      },
      "--moved-image",
      {
        "input": "runtime_moved_image"
      },
      "--output",
      {
        "input": "output",
        "relative": "image-contract"
      },
      "--name",
      "runtime-images",
      "--",
      "node",
      "tests/integration/go/run.mjs",
      "runtime-controller",
      "--profile",
      "all",
      "--package",
      "internal/platform/docker",
      "--output",
      {
        "input": "output",
        "relative": "image-contract/go"
      },
      "--",
      "-run",
      "^Test(MovedTagCreatesNewImageWithoutChangingReference|InstalledImageResolution)$",
      "-timeout=2m"
    ],
    "check_resources": true,
    "env": {
      "COMPOSE_PARALLEL_LIMIT": "1",
      "COMPOSE_ENV_FILES": ".env.example"
    },
    "pause_file": {
      "input": "output",
      "relative": "pause-before-next"
    },
    "timeout_ms": 1200000,
    "grace_ms": 180000
  },
