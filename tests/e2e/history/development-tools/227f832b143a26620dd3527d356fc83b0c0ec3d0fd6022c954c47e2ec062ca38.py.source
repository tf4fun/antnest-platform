import hashlib,json,os,pathlib,subprocess,sys,time
P=pathlib.Path(__file__).resolve().parent
PROJECT='antnest-dev-20260915'
PG=PROJECT+'-postgres-1'
RUNTIME='antnest-runtime-agent_13f29da090d9a459c2d6f02576f74705'
CANDIDATE='sha256:c2621d785f7a46e39ad148775870407f561e1b6bf4000b89b3af9ca0b2b0c82d'
COMPOSE=['docker','compose','-p',PROJECT,'-f','compose.yaml','-f','compose.stage3.yaml','-f','compose.controller-development.yaml','--profile','stage3','--profile','observability']
def run(args,**kw):return subprocess.check_output(args,timeout=kw.pop('timeout',200),**kw)
def write(name,v):
 p=P/name;p.write_text(json.dumps(v,indent=2));p.chmod(0o600)
def inspect(name):return json.loads(run(['docker','inspect',name]))[0]
def containers():return json.loads(run(['docker','inspect',*run(['docker','ps','-aq'],text=True).split()]))
def safe(c):return {'id':c['Id'],'name':c['Name'],'image':c['Image'],'started':c['State']['StartedAt'],'restarts':c['RestartCount'],'running':c['State']['Running'],'health':c['State'].get('Health',{}).get('Status'),'mounts':sorted(c['Mounts'],key=lambda x:x['Destination']),'networks':sorted(c['NetworkSettings']['Networks'])}
def sql(db,q):return run(['docker','exec',PG,'psql','-X','-qAt','-v','ON_ERROR_STOP=1','-U','antnest_test_admin','-d',db,'-c',q],text=True).strip()
def rows():return {t:json.loads(sql('antnest_agent_acp',f"SELECT coalesce(jsonb_object_agg(id,md5(row_to_json(t)::text)), '{{}}'::jsonb) FROM {t} t")) for t in ['acp_sessions','runs','session_messages','tool_attempts']}
def idle():
 assert sql('antnest_agent_acp',"SELECT count(*) FROM runs WHERE state IN ('admitting','running')")=='0'
 assert sql('antnest_agent_controller',"SELECT count(*) FROM agent_controller.agents WHERE active_operation_request_id <> ''")=='0'
def workspace():return hashlib.sha256(run(['docker','exec',RUNTIME,'sh','-c','cd /workspace && find . -type f -exec sha256sum {} \\; | sort'])).hexdigest()
def wait(service):
 end=time.monotonic()+180
 while time.monotonic()<end:
  c=inspect(PROJECT+'-'+service+'-1')
  if c['State']['Running'] and c['State'].get('Health',{}).get('Status')=='healthy':return c
  time.sleep(1)
 raise RuntimeError(service+' health deadline exceeded')
def stop(service):
 name=PROJECT+'-'+service+'-1';run(['docker','stop','-t','30',name]);c=inspect(name)
 assert c['State']['Status']=='exited' and c['State']['ExitCode']==0 and not c['State']['OOMKilled']
 return {'service':service,'exit':c['State']['ExitCode'],'finished':c['State']['FinishedAt']}
mode=sys.argv[1]
if mode=='before':
 assert not (P/'before.json').exists()
 cs=containers();assert len(cs)==12;idle()
 cfg=json.loads(run(COMPOSE+['config','--format','json']))
 write('compose.private.json',cfg);write('containers.private.json',cs)
 for service in ['temporal','agent-controller']:
  c=inspect(PROJECT+'-'+service+'-1');assert c['State']['Health']['Status']=='healthy'
  env=dict(x.split('=',1) for x in c['Config']['Env'])
  assert all(env.get(k)==str(v) for k,v in cfg['services'][service]['environment'].items()),service+' environment differs'
  run(['docker','tag',c['Image'],'antnest/'+service+':pre-temporal-sync-20260921'])
 assert inspect('antnest/temporal:local')['Id']==CANDIDATE
 r=rows();write('rows-before.json',r)
 write('before.json',{'containers':[safe(c) for c in cs],'workspace_sha256':workspace(),'row_counts':{k:len(v) for k,v in r.items()}})
 print(json.dumps({'status':'baseline_passed','containers':12,'idle':True,'row_counts':{k:len(v) for k,v in r.items()}}))
elif mode=='deploy':
 idle();stops=[stop('agent-controller'),stop('temporal')];write('deployment-stops.json',stops)
 backups=[]
 for db in ['antnest_temporal','antnest_temporal_visibility','antnest_agent_controller','antnest_agent_acp']:
  path=P/(db+'.dump')
  with path.open('xb') as f:
   path.chmod(0o600);subprocess.run(['docker','exec',PG,'pg_dump','-U','antnest_test_admin','-Fc',db],stdout=f,check=True,timeout=120)
  with path.open('rb') as f:subprocess.run(['docker','exec','-i',PG,'pg_restore','--list'],stdin=f,stdout=subprocess.DEVNULL,check=True,timeout=60)
  backups.append({'database':db,'sha256':hashlib.sha256(path.read_bytes()).hexdigest(),'bytes':path.stat().st_size})
 write('backups.json',backups)
 for service in ['temporal','agent-controller']:
  run(COMPOSE+['up','-d','--no-deps','--no-build','--pull','never','--wait','--wait-timeout','180',service],stderr=subprocess.STDOUT)
  c=wait(service);write(service+'-deployed.private.json',c)
  if service=='temporal':assert c['Image']==CANDIDATE
 print(json.dumps({'status':'deployed','normal_stops':stops,'backups':len(backups)}))
elif mode=='restart':
 idle();before={s:inspect(PROJECT+'-'+s+'-1') for s in ['agent-controller','temporal']}
 stops=[stop('agent-controller'),stop('temporal')];write('restart-stops.json',stops)
 for service in ['temporal','agent-controller']:
  run(['docker','start',PROJECT+'-'+service+'-1'])
  c=wait(service);assert c['Id']==before[service]['Id'] and c['State']['StartedAt']!=before[service]['State']['StartedAt']
 print(json.dumps({'status':'restart_passed','same_containers':True,'normal_stops':stops}))
elif mode=='resume':
 wait('temporal');run(['docker','start',PROJECT+'-agent-controller-1']);wait('agent-controller')
 print(json.dumps({'status':'resumed','temporal_ready_before_controller':True}))
elif mode=='after':
 b=json.loads((P/'before.json').read_text());cs=[safe(c) for c in containers()];assert len(cs)==12
 for old in b['containers']:
  new=next(c for c in cs if c['name']==old['name']);service=new['name'].split(PROJECT+'-')[-1].removesuffix('-1')
  assert new['running'] and (not old['health'] or new['health']=='healthy')
  assert new['mounts']==old['mounts'] and new['networks']==old['networks'],new['name']+' mounts or networks changed'
  assert new['image']==(CANDIDATE if service=='temporal' else old['image'])
  if service not in ['temporal','agent-controller']:
   assert new['id']==old['id'] and new['started']==old['started'] and new['restarts']==old['restarts'],new['name']+' process changed'
 original=json.loads((P/'rows-before.json').read_text());now=rows();assert now==original,'original ACP data changed'
 assert workspace()==b['workspace_sha256'],'retained workspace changed';idle()
 temporal=inspect(PROJECT+'-temporal-1');assert temporal['Config']['Healthcheck']['Test']==['CMD','sh','/etc/temporal/readiness.sh']
 for service in ['temporal','agent-controller']:
  c=inspect(PROJECT+'-'+service+'-1');expected=json.loads((P/'compose.private.json').read_text())['services'][service]['environment'];env=dict(x.split('=',1) for x in c['Config']['Env']);assert all(env.get(k)==str(v) for k,v in expected.items())
 report={'status':'passed','containers':12,'healthy':11,'unaffected_processes':10,'original_rows':b['row_counts'],'workspace_unchanged':True,'runtime_unchanged':True,'active_runs':0,'temporal_image':CANDIDATE}
 write('after.json',report);print(json.dumps(report))
else:raise ValueError(mode)
