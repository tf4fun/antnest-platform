import os,sys,signal,subprocess,pathlib
root=pathlib.Path(__file__).resolve().parent
env=os.environ.copy();env['PATH']='/Users/xiaxilin/.nvm/versions/node/v26.8.2/bin:'+env['PATH']
env['COMPOSE_PARALLEL_LIMIT']='1';env['COMPOSE_ENV_FILES']='.env.example'
os.umask(0o077)
if (root/'pause-before-next').exists():
    print('Coordinator pause before launching next verification');sys.exit(125)
child=None;code=1
def stop(sig,frame):
    if child and child.poll() is None: os.killpg(child.pid,signal.SIGTERM)
    raise SystemExit(128+sig)
signal.signal(signal.SIGTERM,stop);signal.signal(signal.SIGINT,stop)
try:
    with (root/sys.argv[1]).open('x') as log:
        child=subprocess.Popen(sys.argv[2:],env=env,stdout=log,stderr=subprocess.STDOUT,start_new_session=True)
        try:code=child.wait(timeout=1200)
        except subprocess.TimeoutExpired:code=124
finally:
    if child and child.poll() is None:
        os.killpg(child.pid,signal.SIGTERM)
        try:child.wait(timeout=180)
        except subprocess.TimeoutExpired:os.killpg(child.pid,signal.SIGKILL);child.wait()
print('Verification exit: '+str(code));sys.exit(code)
