import json, pathlib, re, subprocess
root=pathlib.Path(__file__).resolve().parent
projects=sorted(set(p for log in root.glob('cost-docker-*.log') for p in re.findall(r'antnest-stage3-e2e-\d+',log.read_text())))
def run(*args): return subprocess.check_output(args,text=True).strip()
for project in projects:
 for label in ['com.docker.compose.project','io.antnest.runtime-controller-scope']:
  for resource, flags in [('ps',['-aq']),('volume',['ls','-q']),('network',['ls','-q'])]:
   assert not run('docker',resource,*flags,'--filter',f'label={label}={project}'), (project,label,resource)
 for resource, flags in [('ps',['-aq']),('volume',['ls','-q']),('network',['ls','-q'])]:
  assert not run('docker',resource,*flags,'--filter',f'name={project}'), (project,resource)
before=json.loads((root/'cost-retained-before.json').read_text())
raw=json.loads(run('docker','inspect',*[r['id'] for r in before]))
after=[dict(name=r['Name'].lstrip('/'),id=r['Id'],image=r['Image'],health=r['State'].get('Health',{}).get('Status')) for r in raw]
assert before==after
assert all(r['State']['Running'] for r in raw)
processes=run('ps','-axo','pid=,ppid=,command=')
assert not any(re.search(r'(?:^|\s)(?:\S*/)?(?:sh|bash|zsh) (?:\S*/)?scripts/e2e-|run-profile\.py e2e-session-cost cost-docker-',line) for line in processes.splitlines())
result=dict(projects=projects,remaining_owned_resources=0,retained_unchanged=len(after),running_verification_children=0)
(root/'cost-cleanup.json').write_text(json.dumps(result,indent=2));print(json.dumps(result))
