import json,pathlib,re,subprocess
root=pathlib.Path('.cache/identity-migration-20260917')
def docker(*args):return subprocess.check_output(['docker',*args],text=True,timeout=30)
before=json.loads((root/'retained-before.json').read_text())
current=json.loads(docker('inspect',*[r['id'] for r in before]))
assert all(r['State']['Running'] for r in current), 'Retained container stopped'
now=[{'name':r['Name'].lstrip('/'),'id':r['Id'],'image':r['Image'],'health':r['State'].get('Health',{}).get('Status')} for r in current]
assert sorted(before,key=lambda x:x['id'])==sorted(now,key=lambda x:x['id']), 'Retained container identity/image/health changed'
projects=sorted({p for f in root.glob('*docker*.log') for p in re.findall(r'antnest-stage3-e2e-\d+',f.read_text())})
for project in projects:
 for label in ['com.docker.compose.project','io.antnest.runtime-controller-scope']:
  for command in [('ps','-aq'),('volume','ls','-q'),('network','ls','-q')]:
   assert not docker(*command,'--filter',f'label={label}={project}').strip(), f'Resources remain: {project} {label} {command[0]}'
result={'retained_containers':len(now),'retained_ids_images_health_unchanged':True,'temporary_projects':projects,'all_owned_containers_networks_volumes_removed':True}
(root/'cleanup.json').write_text(json.dumps(result,indent=2)+'\n')
print(json.dumps(result))
