import json,pathlib,subprocess,re,os
p=pathlib.Path(__file__).resolve().parent
run=lambda a:subprocess.check_output(a,text=True,timeout=30).strip()
scopes=set()
for log in p.glob('component-*.log'):
 scopes.update(re.findall(r'Disposable crash component scope: (antnest-rc-crash-[a-f0-9]{16})',log.read_text()))
scopes.add(json.loads((p/'postgres-cleanup.json').read_text())['project'])
for scope in scopes:
 for args in [['ps','-aq'],['volume','ls','-q'],['network','ls','-q']]:
  assert not run(['docker',*args,'--filter','label=io.antnest.runtime-controller-scope='+scope]),(scope,args)
old=json.loads((p/'retained-before.json').read_text())
rows=json.loads(run(['docker','inspect',*[r['Id'] for r in old]]))
new=[{k:r[k] for k in ['Id','Name','Image','RestartCount','Mounts']}|{'StartedAt':r['State']['StartedAt'],'Running':r['State']['Running'],'Health':r['State'].get('Health',{}).get('Status'),'Networks':sorted(r['NetworkSettings']['Networks'])} for r in rows]
for a,b in zip(old,new):
 for x in [a,b]:x['Mounts']=sorted(x['Mounts'],key=lambda m:m['Destination'])
 assert a==b,a['Name']
ps=run(['ps','-axo','pid=,ppid=,command=']).splitlines()
left=[l for l in ps if any(s in l for s in ['run-command.py','postgres-gate.py','/control.test','ANTNEST_RUNTIME_CRASH_JOB=']) and 'zsh -lc' not in l]
assert not left,left
r={'scopes':sorted(scopes),'owned_resources':0,'verification_children':0,'retained_unchanged':len(new),'running':sum(x['Running'] for x in new),'healthy':sum(x['Health']=='healthy' for x in new)}
f=p/'cleanup.json';f.write_text(json.dumps(r,indent=2));f.chmod(0o600);print(json.dumps(r))
