import json,pathlib,subprocess
p=pathlib.Path(__file__).resolve().parent
projects=[]
for f in ['docker-1.log','docker-2.log','foundation-regression.log']:
 project=next(l.split(': ')[1] for l in (p/f).read_text().splitlines() if l.startswith('Disposable foundation project:'))
 projects.append(project)
 for command in [['ps','-aq'],['volume','ls','-q'],['network','ls','-q']]:
  for label in ['com.docker.compose.project','io.antnest.runtime-controller-scope']:
   assert not subprocess.check_output(['docker',*command,'--filter',f'label={label}={project}'],text=True).strip()
rows=json.loads(subprocess.check_output(['docker','inspect',*subprocess.check_output(['docker','ps','-aq'],text=True).split()]))
current=[{'id':c['Id'],'name':c['Name'],'image':c['Image'],'running':c['State']['Running'],'health':c['State'].get('Health',{}).get('Status'),'mounts':c['Mounts']} for c in rows]
before=json.loads((p/'retained-before.json').read_text())
for rs in [before,current]:
 for c in rs:c['mounts'].sort(key=lambda m:m['Destination'])
 rs.sort(key=lambda c:c['id'])
assert before==current,'retained containers changed'
processes=subprocess.check_output(['ps','-axo','pid=,ppid=,command='],text=True)
markers=['node scripts/lifecycle-closeout/run.mjs','node --test --test-concurrency=1','node scripts/lifecycle-closeout/network-model.mjs','node scripts/lifecycle-closeout/network-target.mjs']
assert not [l for l in processes.splitlines() if any(m in l for m in markers) and not any(x in l for x in ['zsh -lc','python3 - <<'])],'verification children remain'
traces=list(pathlib.Path('.cache/lifecycle-network/antnest-lifecycle-db6c8d75/traces').glob('*.json'));assert len(traces)==20
missing=errors=warning_traces=0
for path in traces:
 t=json.loads(path.read_text());ids={s['spanID'] for s in t['spans']}
 for span in t['spans']:
  for ref in span.get('references') or []:
   if ref['refType']=='CHILD_OF':missing+=int(ref['traceID']!=t['traceID'] or ref['spanID'] not in ids)
  tags={x['key']:x['value'] for x in span.get('tags') or []}
  errors+=int(tags.get('error') is True or tags.get('otel.status_code')=='ERROR')
 warnings=(t.get('warnings') or [])+[w for span in t['spans'] for w in (span.get('warnings') or [])]
 assert all(w.startswith('clock skew adjustment disabled') for w in warnings),'unreviewed network warning'
 warning_traces+=bool(warnings)
assert missing==errors==0
c={'projects_cleaned':projects,'retained_containers_unchanged':len(current),'verification_children':0,'network_raw_traces':len(traces),'network_missing_parent_edges':missing,'network_error_spans':errors,'network_warning_traces':warning_traces}
(p/'cleanup.json').write_text(json.dumps(c,indent=2));print(json.dumps(c))
