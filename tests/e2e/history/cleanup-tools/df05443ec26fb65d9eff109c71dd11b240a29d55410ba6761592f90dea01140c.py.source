import json,os,pathlib,subprocess
root=pathlib.Path(__file__).resolve().parent
import re
projects=[re.search(r'Disposable foundation project: (antnest-lifecycle-[a-f0-9]{8})',(root/name).read_text()).group(1) for name in ['loss.log','foundation.log']]
projects.append(json.loads((root/'service-cleanup.json').read_text())['project'])
def run(*a):return subprocess.check_output(a,text=True).strip()
left={}
for project in projects:
 for label in ['com.docker.compose.project','io.antnest.runtime-controller-scope']:
  for kind,cmd in [('containers',['ps','-aq']),('volumes',['volume','ls','-q']),('networks',['network','ls','-q'])]:
   found=run('docker',*cmd,'--filter',f'label={label}={project}').splitlines()
   left[f'{project}/{label}/{kind}']=found
   assert not found,(project,label,kind,found)
before=json.loads((root/'retained-before.json').read_text())
rows=json.loads(run('docker','inspect',*[r['id'] for r in before]))
now=[dict(id=r['Id'],name=r['Name'],image=r['Image'],running=r['State']['Running'],health=r['State'].get('Health',{}).get('Status'),mounts=r['Mounts']) for r in rows]
for a,b in zip(before,now):
 for v in (a,b):v['mounts']=sorted(v['mounts'],key=lambda x:x['Destination'])
 assert a==b, f'retained changed: {a["name"]}'
processes=run('ps','-axo','pid=,ppid=,command=').splitlines()
own=[p for p in processes if ('node ' in p or 'python3 ' in p or 'make ' in p) and any(x in p for x in ['run-profile.py','run-command.py','run-service.py','scripts/lifecycle-closeout/run.mjs','node --test --test-concurrency=1']) and int(p.split()[0])!=os.getpid()]
assert not own,own
local_before=json.loads((root/'local-image-before.json').read_text())['runtime_controller']
assert run('docker','image','inspect','--format','{{.Id}}','antnest/runtime-controller:local')==local_before
assert run('docker','image','inspect','--format','{{.Id}}','antnest/runtime-controller:inspect-absence-20260921')=='sha256:4612f0bcd3bc86a95bd5b71f0de2c5fb509c9ffce819ef67a49d38bbf26137e0'
assert not run('docker','ps','-aq','--filter','name=antnest-image-reference-test-')
assert not run('docker','image','ls','-q','--filter','reference=antnest-image-reference-test-*')
out=dict(local_image_unchanged=True,candidate_preserved=True,projects=projects,resources=left,retained_containers_unchanged=len(now),retained_running=sum(r['running'] for r in now),retained_healthy=sum(r['health']=='healthy' for r in now),verification_children=own)
p=root/'cleanup.json';p.write_text(json.dumps(out,indent=2)+'\n');p.chmod(0o600)
print(json.dumps({k:v for k,v in out.items() if k!='resources'}))
