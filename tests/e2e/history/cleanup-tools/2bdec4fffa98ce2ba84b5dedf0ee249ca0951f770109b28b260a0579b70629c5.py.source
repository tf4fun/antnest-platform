import json,pathlib,subprocess,re
p=pathlib.Path(__file__).resolve().parent
runs=[]
for name,kind in [('shutdown-1.log','shutdown'),('shutdown-2.log','shutdown'),('foundation.log','foundation')]:
 lines=(p/name).read_text().splitlines()
 project=next(l.split(': ')[1] for l in lines if l.startswith('Disposable foundation project:'))
 result=next(json.loads(l) for l in lines if l.startswith('{'))
 assert result['status']=='business_and_topology_passed'
 for command in [['ps','-aq'],['volume','ls','-q'],['network','ls','-q']]:
  for label in ['com.docker.compose.project','io.antnest.runtime-controller-scope']:
   assert not subprocess.check_output(['docker',*command,'--filter',f'label={label}={project}'],text=True).strip()
 checks=result['traces']+result.get('request_traces',[])+result.get('watch_traces',[])+result.get('active_run_rebuild',{}).get('run_traces',[])
 assert all(t.get('topology','passed')=='passed' and t.get('trace_id') and not t.get('error') for t in checks)
 paths=list(pathlib.Path(f'.cache/lifecycle-{kind}/{project}/traces').glob('*.json'))
 missing=0
 for path in paths:
  t=json.loads(path.read_text());ids={s['spanID'] for s in t['spans']}
  for span in t['spans']:
   for ref in span.get('references') or []:
    if ref['refType']=='CHILD_OF':missing+=int(ref['traceID']!=t['traceID'] or ref['spanID'] not in ids)
  warnings=(t.get('warnings') or [])+[w for s in t['spans'] for w in (s.get('warnings') or [])]
  for w in warnings:
   if w.startswith('clock skew adjustment disabled'):continue
   m=re.fullmatch(r'parent span ID=([a-f0-9]+) is not in the trace; skipping clock skew adjustment',w)
   assert m and m[1] in ids,'unreviewed warning or missing parent'
 assert missing==0
 runs.append({'project':project,'kind':kind,'status':result['status'],'operations':result['operations'],'topologies':len(checks),'raw_traces':len(paths),'missing_parent_edges':missing,'strict_exit':result['strict_exit'],'strict_failed':sum(t['strict_trace']=='failed' for t in checks),'warning_traces':sum(bool(t.get('warning_count')) for t in checks),'error_spans':sum(t.get('error_spans',0) for t in checks),'cleanup':'verified'})
rows=json.loads(subprocess.check_output(['docker','inspect',*subprocess.check_output(['docker','ps','-aq'],text=True).split()]))
current=[{'id':c['Id'],'name':c['Name'],'image':c['Image'],'running':c['State']['Running'],'health':c['State'].get('Health',{}).get('Status'),'mounts':c['Mounts']} for c in rows]
before=json.loads((p/'retained-before.json').read_text())
for rs in [before,current]:
 for c in rs:c['mounts'].sort(key=lambda m:m['Destination'])
 rs.sort(key=lambda c:c['id'])
assert before==current,'retained containers changed'
processes=subprocess.check_output(['ps','-axo','pid=,ppid=,command='],text=True)
markers=['node scripts/lifecycle-closeout/run.mjs','node --test --test-concurrency=1','node scripts/lifecycle-closeout/network-model.mjs']
assert not [l for l in processes.splitlines() if any(m in l for m in markers) and 'zsh -lc' not in l],'verification children remain'
errors=p/'http-errors.private.jsonl'
assert not [r for l in errors.read_text().splitlines() if (r:=json.loads(l))['method']!='GET'],'mutation transport error'
summary={'runs':runs,'retained_containers_unchanged':len(current),'verification_children':0,'mutation_transport_errors':0,'local_tests':{'total':941,'passed':936,'skipped':5,'failed':0}}
f=p/'summary.json';f.write_text(json.dumps(summary,indent=2));f.chmod(0o600);print(json.dumps(summary))
