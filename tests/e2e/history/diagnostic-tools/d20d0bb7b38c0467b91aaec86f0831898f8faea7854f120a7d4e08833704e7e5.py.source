import subprocess,os,pathlib,signal,time,json,re
p=pathlib.Path(__file__).resolve().parent
os.umask(0o077)
env=os.environ.copy();env['ANTNEST_ACP_AUDIT_IMAGE']='antnest/agent-acp-service:local'
child=None
def stop(sig,frame):
    if child and child.poll() is None:child.send_signal(signal.SIGTERM)
    raise SystemExit(128+sig)
signal.signal(signal.SIGINT,stop);signal.signal(signal.SIGTERM,stop)
try:
    child=subprocess.Popen(['node','services/agent-acp-service/scripts/sdk-regressions-docker.mjs'],env=env,start_new_session=True)
    while child.poll() is None:
        names=subprocess.check_output(['docker','ps','-a','--format','{{.Names}}','--filter','name=antnest-acp-sdk-'],text=True,timeout=10).split()
        for name in names:
            if not re.fullmatch(r'antnest-acp-sdk-[0-9a-f]{8}-(postgres|service)',name):continue
            state=subprocess.run(['docker','inspect','--format','{{json .State}}',name],capture_output=True,text=True,timeout=10)
            logs=subprocess.run(['docker','logs',name],capture_output=True,text=True,timeout=10)
            if state.returncode==0:(p/(name+'.state.json')).write_text(state.stdout)
            if logs.returncode==0:(p/(name+'.private.log')).write_text(logs.stdout+logs.stderr)
        time.sleep(.3)
    code=child.returncode
finally:
    if child and child.poll() is None:
        child.send_signal(signal.SIGTERM)
        try:child.wait(timeout=45)
        except subprocess.TimeoutExpired:os.killpg(child.pid,signal.SIGKILL);child.wait()
raise SystemExit(code)
