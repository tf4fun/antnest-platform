from pathlib import Path
import re
from urllib.parse import unquote
files=[Path(p) for p in ["docs/current-status.md","docs/acceptance-asset-migration.md","docs/stage-3-admin-control-plane.md","docs/controller-publication-trace-revalidation.md","docs/acp-persistence-revalidation.md","scripts/acp-persistence/README.md","scripts/acp-persistence/contract.md","scripts/acp-restart/README.md","scripts/acp-closeout/README.md","services/agent-controller/docs/execution-publication.md"]]
count=0
for file in files:
 for target in re.findall(r"\[[^\]]*\]\(([^)]+)\)",file.read_text()):
  target=target.strip("<>").split("#",1)[0]
  if not target or "://" in target or target.startswith("mailto:"):continue
  assert (file.parent/unquote(target)).resolve().exists(),(str(file),target)
  count+=1
print({"documents":len(files),"local_links_checked":count})
