import os, pathlib, signal, subprocess, time, json
out=pathlib.Path('.cache/acp-progress-20260916')
env={**os.environ,'PATH':'/Users/xiaxilin/.nvm/versions/node/v26.8.2/bin:'+os.environ['PATH'],'ANTNEST_E2E_TOOL_PROGRESS':'true'}
def docker(*args):
 return subprocess.check_output(['docker',*args],text=True,timeout=15,stderr=subprocess.DEVNULL).strip()
def processes():
 return {int(x[0]):int(x[1]) for l in subprocess.check_output(['ps','-axo','pid=,ppid='],text=True).splitlines() if len(x:=l.split())==2}
with (out/'interrupted.log').open('w') as log:
 child=subprocess.Popen(['sh','scripts/e2e-stage3a.sh'],env=env,stdout=log,stderr=subprocess.STDOUT,start_new_session=True)
 project=f'antnest-stage3-e2e-{child.pid}'
 captured=set()
 sent=False
 try:
  deadline=time.monotonic()+160
  while child.poll() is None and time.monotonic()<deadline:
   if docker('ps','-aq','--filter','name=^/'+project+'-progress-client$'):
    ps=processes(); captured={child.pid}
    while True:
     expanded=captured|{p for p,parent in ps.items() if parent in captured}
     if expanded==captured:break
     captured=expanded
    os.killpg(child.pid,signal.SIGTERM);sent=True;break
   time.sleep(.25)
  assert sent,'client creation deadline exceeded'
  code=child.wait(timeout=150)
  assert code!=0,'interruption was reported as success'
 finally:
  if child.poll() is None:
   os.killpg(child.pid,signal.SIGTERM)
   try:child.wait(timeout=150)
   except subprocess.TimeoutExpired:
    os.killpg(child.pid,signal.SIGKILL);child.wait();raise
 resources={}
 for kind,args in [('containers',['ps','-aq']),('volumes',['volume','ls','-q']),('networks',['network','ls','-q'])]:
  resources[kind]=sorted({x for label in ['com.docker.compose.project','io.antnest.runtime-controller-scope'] for x in docker(*args,'--filter',f'label={label}={project}').split()})
 remaining=sorted(captured & set(processes()))
 result={'project':project,'trigger':'progress-client created','signal':'SIGTERM','exitCode':code,'resources':resources,'remainingChildPids':remaining}
 (out/'interruption.json').write_text(json.dumps(result,indent=2)+'\n');print(json.dumps(result))
 assert not any(resources.values()),'owned Docker resources remain'
 assert not remaining,'verification child processes remain'
