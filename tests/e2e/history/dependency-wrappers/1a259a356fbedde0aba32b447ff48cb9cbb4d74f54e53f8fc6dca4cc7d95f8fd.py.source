import json, os, pathlib, signal, subprocess, sys, time
root = pathlib.Path(__file__).resolve().parents[2]
name = 'antnest-final-sdk-audit-' + str(os.getpid())
child = None
created = False
def stop(signum, frame):
    raise KeyboardInterrupt
signal.signal(signal.SIGINT, stop)
signal.signal(signal.SIGTERM, stop)
try:
    subprocess.run(['docker','run','-d','--name',name,'--label','antnest.purpose=final-sdk-audit',
                    '-e','POSTGRES_USER=final_audit','-e','POSTGRES_PASSWORD=final_audit',
                    '-e','POSTGRES_DB=final_audit','-p','127.0.0.1::5432','postgres:17-bookworm'],check=True,stdout=subprocess.DEVNULL)
    created=True
    for attempt in range(60):
        if subprocess.run(['docker','exec',name,'pg_isready','-U','final_audit'],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL).returncode==0: break
        time.sleep(.5)
    else: raise RuntimeError('test PostgreSQL unavailable')
    state=json.loads(subprocess.check_output(['docker','inspect',name]))[0]
    port=state['NetworkSettings']['Ports']['5432/tcp'][0]['HostPort']
    env=dict(os.environ,ANTNEST_ACP_AUDIT_DATABASE_URL=f'postgres://final_audit:final_audit@127.0.0.1:{port}/final_audit',
             GOCACHE=str(root/'.cache/go-build'),GOMODCACHE=str(root/'.cache/go-mod'))
    child=subprocess.Popen(sys.argv[1:],cwd=root,env=env,start_new_session=True)
    try: status=child.wait(timeout=900)
    except subprocess.TimeoutExpired: status=124
finally:
    if child and child.poll() is None:
        os.killpg(child.pid,signal.SIGTERM)
        try: child.wait(timeout=15)
        except subprocess.TimeoutExpired: os.killpg(child.pid,signal.SIGKILL);child.wait()
    if created:
        subprocess.run(['docker','rm','-fv',name],check=True,stdout=subprocess.DEVNULL)
        print(json.dumps({'postgres_fixture':name,'removed':True}))
sys.exit(status)
