import os, pathlib, subprocess, signal, uuid, time, json
p=pathlib.Path(__file__).resolve().parent
os.umask(0o077)
env=os.environ.copy();env['PATH']='/Users/xiaxilin/.nvm/versions/node/v26.8.2/bin:'+env['PATH']
env['GOCACHE']=str(pathlib.Path('.cache/go-build').resolve());env['GOMODCACHE']=str(pathlib.Path('.cache/go-mod').resolve())
name='antnest-rc-crash-pg-'+uuid.uuid4().hex[:12]
password=uuid.uuid4().hex
child=None
run=lambda a:subprocess.check_output(a,text=True,stderr=subprocess.DEVNULL,timeout=30).strip()
def interrupt(sig,frame):raise SystemExit(128+sig)
signal.signal(signal.SIGTERM,interrupt);signal.signal(signal.SIGINT,interrupt)
try:
 run(['docker','run','-d','--pull=never','--name',name,'--label','io.antnest.runtime-controller-scope='+name,'-p','127.0.0.1::5432','-e','POSTGRES_PASSWORD='+password,'-e','POSTGRES_DB=crash_gate','postgres:17-bookworm'])
 deadline=time.monotonic()+60
 while subprocess.run(['docker','exec',name,'pg_isready','-U','postgres'],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=10).returncode:
  if time.monotonic()>deadline:raise RuntimeError('PostgreSQL readiness expired')
  time.sleep(.2)
 port=run(['docker','port',name,'5432/tcp'])
 env['ANTNEST_RUNTIME_CONTROLLER_TEST_DATABASE_URL']='postgres://postgres:'+password+'@'+port+'/crash_gate?sslmode=disable'
 with (p/'postgres.log').open('x') as log:
  child=subprocess.Popen(['go','test','-p=1','./services/runtime-controller/internal/repository/postgres','-count=1','-v','-timeout=4m'],env=env,stdout=log,stderr=subprocess.STDOUT,start_new_session=True)
  code=child.wait(timeout=300)
 print('PostgreSQL gate exit:',code)
finally:
 if child and child.poll() is None:
  os.killpg(child.pid,signal.SIGTERM)
  try:child.wait(timeout=10)
  except subprocess.TimeoutExpired:os.killpg(child.pid,signal.SIGKILL);child.wait()
 subprocess.run(['docker','rm','-f','-v',name],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=30,check=True)
 (p/'postgres-cleanup.json').write_text(json.dumps({'project':name,'container_removed':True}))
raise SystemExit(code)
