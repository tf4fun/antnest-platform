{
  "contract": "antnest.agent-ui.workspace-api",
  "version": 1,
  "status": "implemented",
  "base_path": "/api/app/workspace/v1",
  "schema": "workspace-api.schema.json",
  "transport": "same-origin authenticated HTTP; SSE for observation",
  "browser_session_consumer": {
    "browser_session_contract": "../identity/browser-sessions.md",
    "gateway_revision": 24,
    "identity_revision": 18,
    "gateway_routes": [
      "get_session",
      "get_account",
      "session_activity",
      "list_sessions",
      "revoke_sessions",
      "change_password",
      "logout",
      "list_external_identities",
      "unbind_external_identity",
      "acknowledge_external_identity_notices"
    ]
  },
  "routes": {
    "control_command": {
      "method": "POST",
      "path": "/agents/{agentId}/commands",
      "request": "controlCommandRequest",
      "response": "controlCommandResult"
    },
    "bootstrap": {
      "method": "GET",
      "path": "/bootstrap",
      "response": "bootstrap"
    },
    "sessions": {
      "method": "GET",
      "path": "/agents/{agentId}/sessions",
      "response": "sessionPage"
    },
    "create_session": {
      "method": "POST",
      "path": "/agents/{agentId}/sessions",
      "response": "createSessionResponse"
    },
    "agent_view": {
      "method": "GET",
      "path": "/agents/{agentId}/view",
      "response": "agentView"
    },
    "session_view": {
      "method": "GET",
      "path": "/agents/{agentId}/sessions/{sessionId}/view",
      "response": "sessionView"
    },
    "turns": {
      "method": "GET",
      "path": "/agents/{agentId}/sessions/{sessionId}/turns",
      "response": "turnPage"
    },
    "turn_content": {
      "method": "GET",
      "path": "/agents/{agentId}/sessions/{sessionId}/turns/{turnId}/content",
      "response": "contentPage"
    },
    "events": {
      "method": "GET",
      "path": "/agents/{agentId}/events",
      "transport": "SSE",
      "event": "streamEvent"
    },
    "prompt": {
      "method": "POST",
      "path": "/agents/{agentId}/sessions/{sessionId}/prompts",
      "request": "promptRequest",
      "response": "promptAccepted",
      "success_status": 202
    },
    "operation": {
      "method": "GET",
      "path": "/agents/{agentId}/sessions/{sessionId}/operations/{intentId}",
      "response": "operation"
    },
    "cancel": {
      "method": "POST",
      "path": "/agents/{agentId}/sessions/{sessionId}/operations/{intentId}/cancel",
      "request": "cancelRequest",
      "response": "operation"
    },
    "configuration": {
      "method": "POST",
      "path": "/agents/{agentId}/sessions/{sessionId}/configuration",
      "request": "configurationRequest",
      "response": "sessionView"
    },
    "permission_decision": {
      "method": "POST",
      "path": "/agents/{agentId}/permissions/{permissionId}/decision",
      "request": "permissionDecisionRequest",
      "response": "sessionView"
    },
    "turn_process": {
      "method": "GET",
      "path": "/agents/{agentId}/sessions/{sessionId}/turns/{turnId}/process",
      "response": "processPage"
    },
    "process_content": {
      "method": "GET",
      "path": "/agents/{agentId}/sessions/{sessionId}/turns/{turnId}/process/{itemId}/content",
      "response": "processContentPage"
    }
  },
  "errors": "error",
  "maximum_json_request_bytes": 67108864,
  "maximum_control_request_bytes": 16384,
  "prompt_upload_admission": {
    "scope": "per-agent-ui-process",
    "maximum_inflight_bytes": 134217728,
    "maximum_inflight_requests": 16,
    "principal_key": ["organization", "user"],
    "maximum_principal_inflight_bytes": 67108864,
    "maximum_principal_inflight_requests": 4,
    "unknown_length_reservation_bytes": 67108864,
    "lifetime": "receive-through-dispatch-completion",
    "capacity_status": 429,
    "capacity_code": "upload_capacity_exceeded",
    "retry_after_seconds": 1,
    "control_requests_bypass_upload_budget": true
  },
  "prompt_retry": {
    "status": "pending",
    "query_schema": "promptQueryEntries",
    "query_action": "retry",
    "invalid_query_status": 422,
    "invalid_query_code": "invalid_request",
    "request": "promptRequest",
    "response": "promptAccepted",
    "upload_admission": "prompt_upload_admission",
    "single_flight_key": [
      "organization",
      "principal",
      "agent",
      "session",
      "intent"
    ],
    "preserve": ["intentId", "expectedAppendVersion", "prompt"],
    "refresh_only": ["historyToken"],
    "durable_receipt": "adopt_without_dispatch",
    "query_failure": "no_dispatch",
    "in_flight_original": "no_queued_replay",
    "unknown_receipt": "uncertain",
    "original_body_missing": "query_only",
    "automatic_prompt_replay": false
  },
  "ordinary_browser_timeout_ms": 30000,
  "ordinary_node_timeout_ms": 60000,
  "sse_heartbeat_ms": 15000,
  "sse_delegation_deadline": "original_verified_cct_expiry",
  "sse_session_stale_max_ms": 30000,
  "sse_subscriber_queue_max_bytes": 1048576,
  "process_page_max_bytes": 262144
}
