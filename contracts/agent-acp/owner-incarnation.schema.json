{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antnest.dev/contracts/agent-acp/owner-incarnation.schema.json",
  "title": "Private ACP incarnation registration and stop facts (planned producers)",
  "$defs": {
    "member_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "incarnation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "registration_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z$"
    },
    "register_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["member_id", "incarnation_id", "registration_nonce"],
      "properties": {
        "member_id": {
          "$ref": "#/$defs/member_id"
        },
        "incarnation_id": {
          "$ref": "#/$defs/incarnation_id"
        },
        "registration_nonce": {
          "$ref": "#/$defs/nonce"
        }
      }
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registration_id", "member_id", "incarnation_id"],
      "properties": {
        "registration_id": {
          "$ref": "#/$defs/registration_id"
        },
        "member_id": {
          "$ref": "#/$defs/member_id"
        },
        "incarnation_id": {
          "$ref": "#/$defs/incarnation_id"
        }
      }
    },
    "probe_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "member_id",
        "incarnation_id",
        "registration_nonce",
        "challenge"
      ],
      "properties": {
        "member_id": {
          "$ref": "#/$defs/member_id"
        },
        "incarnation_id": {
          "$ref": "#/$defs/incarnation_id"
        },
        "registration_nonce": {
          "$ref": "#/$defs/nonce"
        },
        "challenge": {
          "$ref": "#/$defs/nonce"
        }
      }
    },
    "probe_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "member_id",
        "incarnation_id",
        "registration_nonce",
        "challenge"
      ],
      "properties": {
        "member_id": {
          "$ref": "#/$defs/member_id"
        },
        "incarnation_id": {
          "$ref": "#/$defs/incarnation_id"
        },
        "registration_nonce": {
          "$ref": "#/$defs/nonce"
        },
        "challenge": {
          "$ref": "#/$defs/nonce"
        }
      }
    },
    "stop_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_id", "reason", "observed_at"],
      "properties": {
        "receipt_id": {
          "$ref": "#/$defs/receipt_id"
        },
        "reason": {
          "enum": [
            "container_stopped",
            "container_restarted",
            "container_removed"
          ]
        },
        "observed_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "inspection": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "registration_id",
            "member_id",
            "incarnation_id",
            "observed_at"
          ],
          "properties": {
            "state": {
              "const": "running"
            },
            "registration_id": {
              "$ref": "#/$defs/registration_id"
            },
            "member_id": {
              "$ref": "#/$defs/member_id"
            },
            "incarnation_id": {
              "$ref": "#/$defs/incarnation_id"
            },
            "observed_at": {
              "$ref": "#/$defs/timestamp"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "registration_id", "reason"],
          "properties": {
            "state": {
              "const": "unknown"
            },
            "registration_id": {
              "$ref": "#/$defs/registration_id"
            },
            "reason": {
              "enum": [
                "unregistered",
                "platform_unavailable",
                "engine_changed",
                "membership_unavailable"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "registration_id",
            "member_id",
            "incarnation_id",
            "stop_receipt"
          ],
          "properties": {
            "state": {
              "const": "stopped"
            },
            "registration_id": {
              "$ref": "#/$defs/registration_id"
            },
            "member_id": {
              "$ref": "#/$defs/member_id"
            },
            "incarnation_id": {
              "$ref": "#/$defs/incarnation_id"
            },
            "stop_receipt": {
              "$ref": "#/$defs/stop_receipt"
            }
          }
        }
      ]
    },
    "error": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "retryable"],
          "dependentRequired": {
            "category": ["request_id"],
            "request_id": ["category"]
          },
          "properties": {
            "category": {
              "enum": [
                "invalid_request",
                "unauthenticated",
                "forbidden",
                "not_found",
                "conflict",
                "precondition_failed",
                "rate_limited",
                "unavailable",
                "internal"
              ]
            },
            "request_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,128}$"
            },
            "details": { "type": "object" },
            "code": {
              "enum": [
                "service_unauthenticated",
                "caller_not_allowed",
                "invalid_request",
                "unsupported_media_type",
                "request_too_large",
                "acp_member_not_allowed",
                "acp_incarnation_unverified",
                "acp_incarnation_conflict",
                "acp_probe_intent_mismatch",
                "route_not_found",
                "method_not_allowed"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "retryable": {
              "const": false
            }
          },
          "allOf": [
            {
              "if": {
                "anyOf": [
                  {
                    "required": ["category"],
                    "properties": { "category": {} }
                  },
                  {
                    "required": ["request_id"],
                    "properties": { "request_id": {} }
                  }
                ]
              },
              "then": {
                "required": [
                  "code",
                  "category",
                  "message",
                  "request_id",
                  "retryable"
                ],
                "properties": {
                  "code": {},
                  "category": {},
                  "message": {},
                  "request_id": {},
                  "retryable": {}
                },
                "allOf": [
                  {
                    "$ref": "https://antnest.local/contracts/common/error.schema.json"
                  }
                ]
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "retryable"],
          "dependentRequired": {
            "category": ["request_id"],
            "request_id": ["category"]
          },
          "properties": {
            "category": {
              "enum": [
                "invalid_request",
                "unauthenticated",
                "forbidden",
                "not_found",
                "conflict",
                "precondition_failed",
                "rate_limited",
                "unavailable",
                "internal"
              ]
            },
            "request_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,128}$"
            },
            "details": { "type": "object" },
            "code": {
              "enum": [
                "acp_registration_unavailable",
                "acp_registry_unavailable",
                "deadline_exceeded",
                "internal_error"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "retryable": {
              "const": true
            }
          },
          "allOf": [
            {
              "if": {
                "anyOf": [
                  {
                    "required": ["category"],
                    "properties": { "category": {} }
                  },
                  {
                    "required": ["request_id"],
                    "properties": { "request_id": {} }
                  }
                ]
              },
              "then": {
                "required": [
                  "code",
                  "category",
                  "message",
                  "request_id",
                  "retryable"
                ],
                "properties": {
                  "code": {},
                  "category": {},
                  "message": {},
                  "request_id": {},
                  "retryable": {}
                },
                "allOf": [
                  {
                    "$ref": "https://antnest.local/contracts/common/error.schema.json"
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  }
}
