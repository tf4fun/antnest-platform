  "registration": {
    "identity_source": "locally initiated pending intent before outbound registration",
    "nonce_storage": "one-way digest only",
    "same_tuple_retry": "original receipt before new platform/probe work; never rebind",
    "unknown_outcome": "reconcile same tuple and nonce; no new unrelated registration",
    "scope": "Runtime Controller configured scope; not caller-provided",
    "binding": [
      "docker_engine_id",
      "full_container_id",
      "container_started_at",
      "member_id",
      "incarnation_id"
    ],
    "platform_selectors": "operator catalog only",
    "probe_destination": "exact inspected container; no requester URL, proxy or redirect",
    "probe_consumes_intent": false,
    "before_execution": "registration completes before lease acquisition and dispatch"
  },
  "inspection": {
    "unregistered": "unknown/unregistered; no platform query",
    "registry_failure": "503 acp_registry_unavailable",
    "durable_stop_receipt": "return first persisted fact before fresh platform observations",
    "running": "successful current observation of exact registered engine/container/start",
    "unknown": [
      "platform_unavailable",
      "engine_changed",
      "membership_unavailable"
    ],
    "stop_facts": {
      "container_stopped": "registered exact container start authoritatively stopped",
      "container_restarted": "registered full container ID now has a different StartedAt",
      "container_removed": "registered full container ID authoritatively absent on the same engine"
    },
    "timestamps": "UTC lexical form in schema; producer/consumer validate calendar dates; observation only, never authority by age",
    "receipt_binding": "retain entire stopped response with outer registration/member/incarnation binding",
    "runtime_effects": "ACP process stop does not prove remote Runtime effects stopped"
  },
  "request_boundary": {
    "authenticate_before": ["body", "platform", "storage"],
    "strict_json": [
      "no duplicate fields",
      "no case aliases",
      "no unknown fields",
      "no coercion",
      "no trimming",
      "no multiple values"
    ],
    "probe_listener_excludes": ["workspace", "control", "health"],
    "probe_dependencies": ["local pending intent", "workload authentication"],
    "capture_payload": false,
    "deadline_includes": ["response body", "cancellation", "actual join"]
  },
  "delivery_batches": [
    "shared-contract",
    "runtime-controller",
    "agent-acp-service",
    "peer-and-deployment",
    "two-replica-integration"
  ],
  "pending_acceptance": [
    "actual caller matrix before body/platform/DB",
    "all original lifecycle route grants unchanged",
    "private probe independent of readiness/Identity/DB",
    "original pending intent and both nonces matched",
    "register response loss retries original tuple without rebind",
    "same-engine registered 404 distinct from unregistered 404",
    "container replacement and engine change",
    "concurrent registration and immutable first stop receipt in PostgreSQL",
    "actual HTTP body deadline/cancellation/join and credential redaction",
    "two replicas crash/takeover with no Prompt or Tool replay",
    "Runtime-effect protections and actual resource cleanup preserved"
  ]
