    "POST /internal/acp-peer/control/state-read": {
      "callers": ["agent-acp-service"],
      "authentication": "peer-member",
      "caller_context": {
        "agent-acp-service": "required"
      },
      "request_body": "json",
      "notes": "Dedicated directional member authentication. Reverify the original agent-ui CCT, fixed membership and complete source/target registrations, publication, live owner epoch and admission deadline. Forward state JSON/SSE without local fallback after dispatch; publication joins original streams and bounded delivery cleanup."
    },
    "POST /internal/acp-peer/control/state-watch": {
      "callers": ["agent-acp-service"],
      "authentication": "peer-member",
      "caller_context": {
        "agent-acp-service": "required"
