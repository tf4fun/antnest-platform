      "request_body": "json",
      "notes": "Dedicated directional member authentication. Reverify the original agent-ui CCT, fixed membership and complete source/target registrations, publication, live owner epoch and admission deadline. Forward state JSON/SSE without local fallback after dispatch; publication joins original streams and bounded delivery cleanup."
    },
    "POST /internal/acp-peer/control/settlement": {
      "callers": ["agent-acp-service"],
      "authentication": "peer-member",
      "caller_context": {
        "agent-acp-service": "none"
      },
      "request_body": "json",
      "notes": "Directional member credentials authenticate the fixed peer listener. Reapply the original agent-controller route policy without a user CCT. Validate the body digest, closed operation, fixed assignment, full registrations, private publication and original lifecycle deadline. No ingress lease acquisition; the owner joins its original control task and lease release."
    },
    "POST /internal/acp-peer/control/source-inspect": {
      "callers": ["agent-acp-service"],
      "authentication": "peer-member",
      "caller_context": {
        "agent-acp-service": "none"
      },
      "request_body": "json",
      "notes": "Directional member credentials authenticate the fixed peer listener. Reapply the original skill-registry policy without a user CCT. Validate the body digest, actor/Agent scope, full registrations, private publication, original live epoch and shared 8.5-second deadline. The original owner retains its source-read gate and Runtime authority; cancellation joins original work and independent cleanup failures prevent retirement ACK."
    },
