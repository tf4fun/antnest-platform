{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "applied_revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "outcome": {
      "type": "string",
      "enum": [
        "settled",
        "runtime_barrier_required",
        "not_settled"
      ]
    }
  },
  "required": [
    "applied_revision",
    "outcome"
  ],
  "additionalProperties": false,
  "$id": "https://antnest.local/contracts/agent-acp/settle-agent-result.schema.json",
  "title": "Agent lifecycle settlement result",
  "description": "Local quiescence alone does not prove Runtime foreground calls stopped; see execution-api.md."
}
