{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.antnest.dev/admin-console/runtime-recovery.schema.json",
  "$defs": {
    "runtime_recovery": {
      "$ref": "https://schemas.antnest.dev/agent-controller/runtime-barrier-recovery.schema.json#/$defs/runtime_recovery"
    },
    "rebuild_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template_id", "template_revision", "recovery"],
      "properties": {
        "template_id": {
          "$ref": "https://schemas.antnest.dev/agent-controller/runtime-barrier-recovery.schema.json#/$defs/id"
        },
        "template_revision": { "type": "integer", "minimum": 1 },
        "recovery": {
          "$ref": "https://schemas.antnest.dev/agent-controller/runtime-barrier-recovery.schema.json#/$defs/recovery_request"
        }
      }
    }
  }
}
