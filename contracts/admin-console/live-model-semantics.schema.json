{
  "$id": "https://antnest.local/contracts/admin-console/live-model-semantics.schema.json",
  "title": "Live model semantics",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "model_profile_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["templates", "agents"],
      "properties": {
        "templates": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "agents": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    },
    "effective_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_profile_id", "revision"],
      "properties": {
        "model_profile_id": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    "effective_models": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/effective_model" }
    },
    "audit_model_profile_revision": {
      "anyOf": [
        { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        { "type": "null" }
      ]
    }
  }
}
