{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.antnest.dev/admin-console/model-call-policy.schema.json",
  "title": "Console model call policy",
  "description": "Browser wire for the organization model-call budget and the optional Template model policy. The signed caller context is the only authority; expected_principal is a stale-account precondition, never authorization.",
  "$defs": {
    "run_budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_input_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_cost_usd_micros": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "period_caps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "soft_cost_usd_micros": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "hard_cost_usd_micros": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "model_retry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max", "base_ms", "cap_ms"],
      "properties": {
        "max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "base_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        },
        "cap_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        }
      }
    },
    "template_model_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model_retry": {
          "$ref": "#/$defs/model_retry"
        },
        "failover": {
          "enum": ["never", "before_output"]
        },
        "run_budget": {
          "$ref": "#/$defs/run_budget"
        }
      }
    },
    "model_call_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "unknown_cost",
        "run_caps",
        "daily",
        "monthly"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unknown_cost": {
          "enum": ["allow", "deny"]
        },
        "run_caps": {
          "$ref": "#/$defs/run_budget"
        },
        "daily": {
          "$ref": "#/$defs/period_caps"
        },
        "monthly": {
          "$ref": "#/$defs/period_caps"
        }
      }
    },
    "set_model_call_policy_request": {
      "type": "object",
      "description": "Exactly one canonical expected_version, deprecated expected_revision, or strong If-Match is required by the HTTP boundary. The header alternative permits both body fields to be absent.",
      "additionalProperties": false,
      "required": [
        "unknown_cost",
        "run_caps",
        "daily",
        "monthly",
        "expected_principal"
      ],
      "not": {
        "required": ["expected_version", "expected_revision"],
        "properties": {
          "expected_version": {},
          "expected_revision": {}
        }
      },
      "properties": {
        "expected_version": {
          "allOf": [
            { "$ref": "../common/precondition.schema.json#/$defs/expected_version" }
          ],
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "deprecated": true
        },
        "unknown_cost": {
          "enum": ["allow", "deny"]
        },
        "run_caps": {
          "$ref": "#/$defs/run_budget"
        },
        "daily": {
          "$ref": "#/$defs/period_caps"
        },
        "monthly": {
          "$ref": "#/$defs/period_caps"
        },
        "expected_principal": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 2,
          "maxItems": 2
        }
      }
    }
  }
}
