{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.antnest.dev/admin-console/skill-discovery.ids-v2.schema.json",
  "title": "Console Skill sources and explicit promotion",
  "$defs": {
    "agent_ref": {
      "$ref": "https://schemas.antnest.dev/skill-registry/discovery-api.ids-v2.schema.json#/$defs/agent_ref"
    },
    "digest": {
      "$ref": "https://schemas.antnest.dev/skill-registry/discovery-api.ids-v2.schema.json#/$defs/digest"
    },
    "search_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query"
      ],
      "properties": {
        "query": {
          "$ref": "https://schemas.antnest.dev/skill-registry/discovery-api.ids-v2.schema.json#/$defs/query"
        },
        "limit": {
          "$ref": "https://schemas.antnest.dev/skill-registry/discovery-api.ids-v2.schema.json#/$defs/limit"
        }
      }
    },
    "source_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill_ref",
        "name",
        "description",
        "content_digest"
      ],
      "properties": {
        "skill_ref": {
          "$ref": "#/$defs/agent_ref"
        },
        "name": {
          "$ref": "https://schemas.antnest.dev/skill-registry/discovery-api.ids-v2.schema.json#/$defs/name"
        },
        "description": {
          "$ref": "https://schemas.antnest.dev/skill-registry/discovery-api.ids-v2.schema.json#/$defs/description"
        },
        "content_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "search_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/source_item"
          }
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill_ref",
        "expected_digest"
      ],
      "properties": {
        "skill_ref": {
          "$ref": "#/$defs/agent_ref"
        },
        "expected_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill_ref",
        "content_digest",
        "skill_md",
        "files"
      ],
      "properties": {
        "skill_ref": {
          "$ref": "#/$defs/agent_ref"
        },
        "content_digest": {
          "$ref": "#/$defs/digest"
        },
        "skill_md": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "size",
              "executable"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 8388608
              },
              "executable": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "promote_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill_ref",
        "expected_digest"
      ],
      "properties": {
        "skill_ref": {
          "$ref": "#/$defs/agent_ref"
        },
        "expected_digest": {
          "$ref": "#/$defs/digest"
        },
        "skill_id": {
          "$ref": "https://schemas.antnest.dev/skill-registry/discovery-api.ids-v2.schema.json#/$defs/skill_id"
        },
        "expected_version": {
          "description": "Canonical decimal string; the same-name integer is a one-release deprecated input. A single strong If-Match may replace this body member for append.",
          "anyOf": [
            {
              "type": "string",
              "allOf": [
                {
                  "$ref": "../common/precondition.schema.json#/$defs/expected_version"
                }
              ],
              "pattern": "^[1-9][0-9]*$",
              "maxLength": 20
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "deprecated": true
            }
          ]
        }
      },
      "dependentRequired": {
        "expected_version": [
          "skill_id"
        ]
      }
    },
    "promote_response": {
      "$ref": "https://schemas.antnest.dev/skill-registry/registry-api.ids-v2.schema.json#/$defs/version"
    }
  }
}
