{
  "contract": "antnest.edge-gateway.session",
  "version": 11,
  "session_validation": {
    "invalid_or_expired": "401 unauthenticated; clear browser cookies",
    "identity_unavailable": "503 identity_unavailable; preserve cookies; never admit upstream requests",
    "cache": "no-store"
  },
  "routes": {
    "status": {
      "method": "GET",
      "path": "/status",
      "authentication": "none",
      "scope": "local Gateway readiness; no downstream status requests",
      "success_status": 200
    },
    "login": {
      "method": "POST",
      "path": "/api/session/login",
      "authentication": "none",
      "success_status": 200,
      "request_required": ["organization_slug", "email", "password"],
      "response_required": ["principal", "expires_at"]
    },
    "login_methods": {
      "method": "POST",
      "path": "/api/session/login-methods",
      "authentication": "none",
      "success_status": 200,
      "cache": "no-store",
      "request_required": ["organization_slug"],
      "response_required": ["methods"]
    },
    "start_oidc_login": {
      "method": "POST",
      "path": "/api/session/oidc/start",
      "authentication": "none",
      "success_status": 200,
      "cache": "no-store",
      "request_required": ["organization_slug", "provider_name"],
      "response_required": ["authorization_url", "expires_at"],
      "browser_binding": "HttpOnly SameSite=Lax host-only SHA256(state) cookie; newest attempt replaces prior attempt"
    },
    "get_session": {
      "method": "GET",
      "path": "/api/session",
      "authentication": "browser_session",
      "success_status": 200,
      "response_required": ["principal"]
    },
    "logout": {
      "method": "DELETE",
      "path": "/api/session",
      "authentication": "browser_session",
      "success_status": 204
    },
    "admin": {
      "method": "*",
      "path": "/api/admin/{path...}",
      "authentication": "administrator_session",
      "success_status": "upstream",
      "event_watch_authentication_lease": "bounded"
    },
    "workspace_bootstrap": {
      "method": "GET",
      "path": "/api/app/bootstrap",
      "authentication": "browser_session",
      "success_status": 200,
      "response_required": ["principal", "agents"],
      "forbidden_response_fields": [
        "agent_access_subject",
        "runtime_endpoint",
        "provider_credential",
        "availability",
        "active_session_id"
      ],
      "agent_required": ["agent_id", "name"]
    },
    "workspace_state": {
      "method": "GET",
      "path": "/api/app/agents/{agent_id}/state",
      "authentication": "browser_session; ACP authorizes trusted organization/principal/agent",
      "scope": "original authenticated organization and principal only; no query fields",
      "success_status": 200,
      "response_required": [
        "agent_id",
        "availability",
        "access_allowed",
        "configuration_revision",
        "active_session_id",
        "unavailable_reason"
      ],
      "upstream": {
        "method": "POST",
        "path": "/rpc/agent-acp/get-agent-execution-state",
        "body": {}
      },
      "denied": "200 sanitized offline state; no session or configuration revision disclosure"
    },
    "workspace_state_watch": {
      "method": "GET",
      "path": "/api/app/agents/{agent_id}/state/watch",
      "authentication": "browser_session_at_entry_and_before_each_subsequent_snapshot",
      "success_status": 200,
      "transport": "SSE",
      "event": "workspace_state",
      "replay": "none; reject query fields and Last-Event-ID",
      "lease": "ANTNEST_EDGE_STREAM_LEASE; no automatic Gateway renewal",
      "disconnect": "cancel upstream observation only; never cancel or replay ACP work",
      "response_required": [
        "agent_id",
        "availability",
        "access_allowed",
        "configuration_revision",
        "active_session_id",
        "unavailable_reason"
      ],
      "upstream": {
        "method": "POST",
        "path": "/rpc/agent-acp/watch-agent-execution-state",
        "body": {}
      },
      "source_failure": "503 before first snapshot; after streaming close without inventing state"
    },
    "workspace_acp_http": {
      "method": "POST|GET|DELETE",
      "path": "/api/app/agents/{agent_id}/v1/acp",
      "alias": "/api/app/agents/{agent_id}/acp",
      "transport": "official experimental ACP Streamable HTTP",
      "authentication": "browser_session; direct ACP routing without Controller lookup; ACP owns Agent/Session authorization",
      "csrf": "POST and DELETE require X-Antnest-CSRF-Token matching the cookie",
      "origin": "when supplied must match Gateway; not required for non-browser HTTP clients",
      "forwarded_headers": [
        "Content-Type",
        "Accept",
        "Acp-Connection-Id",
        "Acp-Session-Id"
      ],
      "message_payload": "opaque; no ACP translation or login credential forwarding",
      "streaming": "unbuffered SSE; client disconnect cancels upstream receive request only",
      "connection_authority": "ACP Service; connection ID is not an authentication credential",
      "already_forwarded_work": "same policy as WebSocket; no idle authorization polling"
    },
    "workspace_acp": {
      "method": "GET",
      "path": "/api/app/agents/{agent_id}/acp",
      "transport": "websocket",
      "authentication": "browser_session; direct ACP routing without Controller lookup; ACP owns Agent/Session authorization",
      "upstream_protocol": "ACP v1",
      "versioned_paths": [
        "/api/app/agents/{agent_id}/v1/acp",
        "/api/app/agents/{agent_id}/v2/acp"
      ],
      "same_origin_required": true,
      "message_admission": "resolve original cookie token before forwarding each complete client message; require active original User/Organization/Membership",
      "message_payload": "opaque; no ACP translation or login credential forwarding",
      "invalid_session_close": 1008,
      "identity_unavailable_close": 1013,
      "maximum_message_bytes": 67108864,
      "already_forwarded_work": "ACP owns authorization, Run, cancellation and disconnect semantics",
      "idle_connection": "no Gateway background polling; ACP owns local access updates and output subscriptions"
    },
    "oidc_callback": {
      "method": "GET",
      "path": "/protocol/oidc/callback",
      "authentication": "oidc_state_and_code_and_originating_browser_cookie",
      "success_status": 303,
      "success_location": "/",
      "cache": "no-store",
      "browser_session_established": true,
      "forbidden_response_fields": ["access_token", "token_id", "state", "code"]
    },
    "scim": {
      "method": "*",
      "path": "/scim/v2/{path...}",
      "authentication": "scim_bearer",
      "success_status": "upstream",
      "authorization_forwarded": true,
      "browser_cookies_forwarded": false
    },
    "admin_application": {
      "method": "GET|HEAD",
      "path": "/{path...}",
      "authentication": "none",
      "success_status": "upstream"
    },
    "workspace_application": {
      "method": "GET|HEAD",
      "path": "/workspace/{path...}",
      "authentication": "none",
      "success_status": "upstream",
      "prefix_stripped": true
    }
  },
  "trusted_headers": [
    "X-Antnest-User-ID",
    "X-Antnest-Organization-ID",
    "X-Antnest-Membership-ID",
    "X-Antnest-System-Role",
    "X-Antnest-Organization-Role",
    "X-Antnest-Principal-ID",
    "X-Antnest-Agent-ID",
    "X-Antnest-Agent-Access-Subject"
  ],
  "response_headers": ["X-Antnest-Trace-ID"],
  "upstream_injected_headers": [
    "X-Antnest-Organization-ID",
    "X-Antnest-Principal-ID",
    "X-Antnest-Agent-ID"
  ],
  "error": {
    "required": ["code", "message"],
    "codes": [
      "invalid_request",
      "unauthenticated",
      "forbidden",
      "csrf_failed",
      "identity_unavailable",
      "login_method_unavailable",
      "login_rate_limited",
      "console_unavailable",
      "workspace_unavailable",
      "agent_unavailable"
    ]
  }
}
