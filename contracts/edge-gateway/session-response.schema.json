{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antnest.dev/contracts/edge-gateway/session-response.schema.json",
  "title": "Gateway browser session requests and responses, revision 23",
  "$defs": {
    "principal": {
      "type": "object",
      "required": [
        "user_id",
        "organization_id",
        "organization_slug",
        "organization_name",
        "membership_id",
        "system_role",
        "organization_role",
        "active"
      ],
      "properties": {
        "user_id": {
          "$ref": "#/$defs/id"
        },
        "organization_id": {
          "$ref": "#/$defs/id"
        },
        "organization_slug": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "organization_name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "membership_id": {
          "$ref": "#/$defs/id"
        },
        "system_role": {
          "$ref": "#/$defs/system_role"
        },
        "organization_role": {
          "$ref": "#/$defs/organization_role"
        },
        "active": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "login": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal",
        "expires_at",
        "idle_expires_at",
        "activity_interval_ms"
      ],
      "properties": {
        "principal": {
          "$ref": "#/$defs/principal"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "idle_expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "activity_interval_ms": {
          "$ref": "#/$defs/activity_interval_ms"
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal",
        "expires_at",
        "idle_expires_at",
        "activity_interval_ms"
      ],
      "properties": {
        "principal": {
          "$ref": "#/$defs/principal"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "idle_expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "activity_interval_ms": {
          "$ref": "#/$defs/activity_interval_ms"
        }
      }
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,199}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "system_role": {
      "type": "string",
      "enum": ["user", "admin"]
    },
    "organization_role": {
      "type": "string",
      "enum": ["member", "admin"]
    },
    "source": {
      "type": "string",
      "enum": ["local", "scim"]
    },
    "current_account": {
      "type": "object",
      "required": [
        "user_id",
        "organization_id",
        "membership_id",
        "email",
        "display_name",
        "source",
        "local_password_available"
      ],
      "properties": {
        "user_id": {
          "$ref": "#/$defs/id"
        },
        "organization_id": {
          "$ref": "#/$defs/id"
        },
        "membership_id": {
          "$ref": "#/$defs/id"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "local_password_available": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "browser_session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "organization_id",
        "organization_slug",
        "organization_name",
        "created_at",
        "last_active_at",
        "idle_expires_at",
        "expires_at",
        "user_agent_hint",
        "current"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "organization_id": {
          "$ref": "#/$defs/id"
        },
        "organization_slug": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "organization_name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "last_active_at": {
          "$ref": "#/$defs/timestamp"
        },
        "idle_expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "user_agent_hint": {
          "type": "string",
          "maxLength": 256
        },
        "current": {
          "type": "boolean"
        }
      }
    },
    "activity_interval_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30000
    },
    "password_rotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal",
        "expires_at",
        "idle_expires_at",
        "activity_interval_ms"
      ],
      "properties": {
        "principal": {
          "$ref": "#/$defs/principal"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "idle_expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "activity_interval_ms": {
          "$ref": "#/$defs/activity_interval_ms"
        }
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expires_at", "idle_expires_at", "activity_interval_ms"],
      "properties": {
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "idle_expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "activity_interval_ms": {
          "$ref": "#/$defs/activity_interval_ms"
        }
      }
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": ["account"],
      "properties": {
        "account": {
          "$ref": "#/$defs/current_account"
        }
      }
    },
    "session_list": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessions"],
      "properties": {
        "sessions": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/browser_session"
          }
        },
        "next_after_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "session_revocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revoked_count", "current_revoked"],
      "properties": {
        "revoked_count": {
          "type": "integer",
          "minimum": 0
        },
        "current_revoked": {
          "type": "boolean"
        }
      }
    },
    "password_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_password", "new_password"],
      "properties": {
        "current_password": {
          "type": "string",
          "minLength": 1,
          "secret": true
        },
        "new_password": {
          "type": "string",
          "minLength": 12,
          "secret": true
        }
      }
    },
    "activity_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {}
    },
    "list_sessions_query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limit"],
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "after_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "revoke_sessions_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["others", "all"]
        }
      }
    },
    "oidc_link_policy": {
      "type": "string",
      "enum": ["none", "verified_email_in_domains", "verified_email"]
    },
    "oidc_link_domain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)*[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "external_identity_subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[^\\u0000\\uD800-\\uDFFF]+$"
    },
    "external_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "provider_id",
        "provider_name",
        "provider_display_name",
        "organization_id",
        "organization_slug",
        "organization_name",
        "membership_id",
        "subject",
        "method",
        "provider_enabled",
        "created_at",
        "bound_at",
        "revoked_at"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "provider_id": {
          "$ref": "#/$defs/id"
        },
        "provider_name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "provider_display_name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "organization_id": {
          "$ref": "#/$defs/id"
        },
        "organization_slug": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "organization_name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "membership_id": {
          "$ref": "#/$defs/id"
        },
        "subject": {
          "$ref": "#/$defs/external_identity_subject"
        },
        "method": {
          "type": "string",
          "enum": ["auto", "admin", "scim"]
        },
        "provider_enabled": {
          "type": "boolean"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "bound_at": {
          "$ref": "#/$defs/timestamp"
        },
        "revoked_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "external_identity_notice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "binding_id",
        "provider_id",
        "provider_name",
        "provider_display_name",
        "organization_id",
        "organization_slug",
        "organization_name",
        "membership_id",
        "subject",
        "method",
        "created_at"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "binding_id": {
          "$ref": "#/$defs/id"
        },
        "provider_id": {
          "$ref": "#/$defs/id"
        },
        "provider_name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "provider_display_name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "organization_id": {
          "$ref": "#/$defs/id"
        },
        "organization_slug": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "organization_name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "membership_id": {
          "$ref": "#/$defs/id"
        },
        "subject": {
          "$ref": "#/$defs/external_identity_subject"
        },
        "method": {
          "type": "string",
          "enum": ["auto", "admin", "scim"]
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "external_identity_self_list": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bindings", "notices"],
      "properties": {
        "bindings": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/external_identity"
          }
        },
        "notices": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/external_identity_notice"
          }
        },
        "next_after_id": {
          "$ref": "#/$defs/id"
        },
        "next_notice_after_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "external_identity_organization_list": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bindings"],
      "properties": {
        "bindings": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/external_identity"
          }
        },
        "next_after_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "external_identity_provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "display_name",
        "enabled",
        "link_policy",
        "link_domains",
        "authoritative",
        "link_policy_review_required"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "enabled": {
          "type": "boolean"
        },
        "link_policy": {
          "$ref": "#/$defs/oidc_link_policy"
        },
        "link_domains": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/oidc_link_domain"
          },
          "uniqueItems": true
        },
        "authoritative": {
          "type": "boolean"
        },
        "link_policy_review_required": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["link_policy"],
            "properties": {
              "link_policy": {
                "const": "verified_email_in_domains"
              }
            }
          },
          "then": {
            "properties": {
              "link_domains": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "link_domains": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "external_identity_list": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bindings", "notices"],
      "properties": {
        "bindings": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/external_identity"
          }
        },
        "notices": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/external_identity_notice"
          }
        },
        "next_after_id": {
          "$ref": "#/$defs/id"
        },
        "next_notice_after_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "external_identity_list_query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limit"],
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "after_id": {
          "$ref": "#/$defs/id"
        },
        "notice_after_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "external_identity_unbind_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "allow_lockout": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "external_identity_unbind_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revoked_count", "current_revoked"],
      "properties": {
        "revoked_count": {
          "type": "integer",
          "minimum": 0
        },
        "current_revoked": {
          "type": "boolean"
        }
      }
    },
    "external_identity_acknowledge_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notice_ids"],
      "properties": {
        "notice_ids": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "external_identity_acknowledge_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acknowledged_count"],
      "properties": {
        "acknowledged_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "password_failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {
          "type": "string",
          "enum": ["credential_busy", "credential_rate_limited"]
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "const": true
        }
      },
      "oneOf": [
        {
          "properties": {
            "code": {
              "const": "credential_busy"
            },
            "message": {
              "const": "Password verification is busy"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": "credential_rate_limited"
            },
            "message": {
              "const": "Too many password attempts"
            }
          }
        }
      ]
    }
  }
}
