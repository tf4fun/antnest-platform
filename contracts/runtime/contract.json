{
  "mcp_protocol_version": "2026-07-28",
  "runtime_spec": "runtime-spec.schema.json",
  "status_schema": "runtime-status.schema.json",
  "transport": {
    "status_path": "/status",
    "mcp_path": "/mcp",
    "kind": "streamable-http",
    "host_policy": "owned-alias-and-loopback-with-exact-port",
    "instance_connection_contract": "instance-connection-contract.json",
    "live_status_path": "/status/live",
    "expected_execution_header": "X-Antnest-Expected-Execution-ID"
  },
  "status": {
    "agent_id": "agent-1",
    "generation": 2,
    "execution_id": "execution-1",
    "status": "ready",
    "test_features": []
  },
  "readiness": {
    "scope": "runtime-with-egress-path",
    "egress_dependency_checked": true,
    "executor_identity_checked": true,
    "workspace_access_checked": true,
    "system_skills_access_checked": true
  },
  "lifecycle": {
    "runtime_exit": "restart_or_replace_instance",
    "requires_fresh_network_namespace": false,
    "network_bootstrap": "reconcile_owned_artifacts",
    "preserve_generation_when_spec_unchanged": true
  },
  "lifecycle_errors": {
    "bootstrap": [
      "bootstrap_evidence_failed",
      "entry_failed",
      "environment_verification_failed",
      "executor_initialization_failed",
      "invalid_config",
      "named_roots_failed",
      "network_bootstrap_failed",
      "network_verification_failed",
      "pre_executor_verification_failed",
      "root_verification_failed",
      "unsupported_platform",
      "workspace_initialization_failed",
      "workspace_ownership_failed"
    ],
    "runtime": [
      "child_process_containment_unproven",
      "executor_probe_failed",
      "http_bind_failed",
      "http_service_failed",
      "local_network_failed",
      "managed_mcp_start_failed",
      "managed_mcp_service_failed",
      "managed_mcp_stop_failed",
      "network_transport_failed",
      "orphan_reaper_failed",
      "shutdown_timeout",
      "signal_listener_failed",
      "telemetry_initialization_failed",
      "temporary_cleanup_failed",
      "unexpected_exit"
    ]
  },
  "bootstrap_stages": [
    "entry",
    "runtime_spec",
    "environment_sanitized",
    "network_ready",
    "filesystem",
    "roots_ready",
    "pre_tokio",
    "executor",
    "platform"
  ],
  "error_envelope": "../common/error.schema.json",
  "tool_errors": [
    "canceled",
    "child_process_containment_unproven",
    "content_not_utf8",
    "edit_failed",
    "edit_read_failed",
    "encode_result_failed",
    "invalid_params",
    "invalid_path",
    "old_string_not_found",
    "old_string_not_unique",
    "outcome_unknown",
    "output_capture_failed",
    "read_failed",
    "result_too_large",
    "runtime_busy",
    "runtime_failed",
    "runtime_unavailable",
    "spawn_failed",
    "timeout",
    "temporary_background_not_supported",
    "wait_failed",
    "write_failed"
  ],
  "tool_result": {
    "error_envelope": "../common/error.schema.json",
    "notes": "tool structured errors carry the common envelope fields (code/category/message/retryable/request_id + details duplicating effect fields); error_code remains a one-release N-1 alias; JSON-RPC ErrorData.data adapts common fields without changing the outer numeric code/message",
    "effect_states": ["none", "settled", "unknown"],
    "unknown_effect_source": "runtime_mcp",
    "success_effect_state": "settled",
    "error_code_field": "error_code"
  },
  "execution": {
    "single_flight_enforced_by": "runtime",
    "max_active_calls_per_agent": 1,
    "busy_error": "runtime_busy",
    "subcommands": ["bash", "edit", "info", "read", "write"]
  },
  "tools": ["bash", "edit", "read", "write"],
  "managed_mcp": {
    "config_field": "mcp_servers",
    "executor_subcommand": "mcp-stdio",
    "max_servers": 8,
    "max_config_bytes": 65536,
    "max_tools": 128,
    "max_catalog_bytes": 1048576,
    "tool_name_prefix": "mcp__",
    "lifecycle": "runtime",
    "tool_catalog": "tools/list"
  },
  "information": {
    "uri": "antnest://runtime/info",
    "schema": "runtime-information.schema.json",
    "mime_type": "application/json",
    "read_method": "resources/read",
    "executor_subcommand": "info",
    "max_instruction_bytes": 16384,
    "max_manifest_bytes": 16384,
    "max_scan_entries_per_root": 128,
    "max_skills_per_root": 32,
    "max_warnings": 67
  },
  "container_security": "container-security.json",
  "egress_tunnel": {
    "kind": "udp",
    "payload": "ant2-prefixed-wireguard-message",
    "inner_payload": "one-complete-ipv4-packet",
    "packet_contract": "packet-contract.json",
    "traced": false,
    "policy_owner": "runtime-egress"
  },
  "packet_format": "packet-format.md",
  "packet_fixtures": "packet-fixtures.json"
,
  "routes": [
    {
      "method": "GET",
      "path": "/status",
      "authentication": "workload",
      "callers": ["runtime-controller", "agent-acp-service"],
      "caller_context": {
        "runtime-controller": "none",
        "agent-acp-service": "none"
      },
      "request_body": "none",
      "responses": {
        "200": {
          "body": "runtime-status.schema.json",
          "content_type": "application/json"
        },
        "503": {
          "body": "runtime-status.schema.json",
          "content_type": "application/json"
        }
      },
      "error_schema": "../common/error.schema.json",
      "errors": [
        {
          "code": "runtime_unauthorized",
          "status": 401
        },
        {
          "code": "caller_not_allowed",
          "status": 403
        },
        {
          "code": "host_not_allowed",
          "status": 403
        }
      ]
    },
    {
      "method": "GET",
      "path": "/status/live",
      "authentication": "health",
      "callers": ["local-healthcheck"],
      "caller_context": {
        "local-healthcheck": "none"
      },
      "request_body": "none",
      "responses": {
        "200": {
          "body": "http.schema.json#/$defs/live_status",
          "content_type": "application/json"
        },
        "503": {
          "body": "http.schema.json#/$defs/live_status",
          "content_type": "application/json"
        }
      },
      "error_schema": "../common/error.schema.json",
      "errors": [
        {
          "code": "host_not_allowed",
          "status": 403
        }
      ],
      "notes": "Identity-free reduced liveness; implicit HEAD shares the same handler."
    },
    {
      "method": "HEAD",
      "path": "/status/live",
      "authentication": "health",
      "callers": ["local-healthcheck"],
      "caller_context": {
        "local-healthcheck": "none"
      },
      "request_body": "none",
      "responses": {
        "200": {
          "body": "none"
        },
        "503": {
          "body": "none"
        }
      },
      "error_schema": "../common/error.schema.json",
      "errors": [
        {
          "code": "host_not_allowed",
          "status": 403
        }
      ],
      "notes": "Implicit HEAD served by the GET handler; headers only."
    },
    {
      "method": "*",
      "path": "/mcp",
      "authentication": "workload",
      "callers": ["agent-acp-service"],
      "caller_context": {
        "agent-acp-service": "operation"
      },
      "execution_fence": "X-Antnest-Expected-Execution-ID",
      "request_body": "http.schema.json#/$defs/protocol_request",
      "protocol_methods": {
        "POST": {
          "request_body": "http.schema.json#/$defs/protocol_request",
          "content_type": "application/json",
          "notes": "JSON-RPC request; replies are application/json or a text/event-stream of protocol_response events",
          "response_body": "http.schema.json#/$defs/protocol_response",
          "response_content_types": ["application/json", "text/event-stream"]
        },
        "GET": {
          "request_body": "none",
          "notes": "SSE observation stream carrying protocol_response events",
          "response_body": "http.schema.json#/$defs/protocol_message",
          "response_content_types": ["text/event-stream"]
        },
        "DELETE": {
          "request_body": "none",
          "notes": "session close; the mounted service may report the session as unsupported"
        }
      },
      "responses": {
        "200": {
          "body": "http.schema.json#/$defs/protocol_response",
          "content_type": "application/json"
        },
        "202": {
          "body": "none"
        }
      },
      "error_schema": "../common/error.schema.json",
      "errors": [
        {
          "code": "runtime_unauthorized",
          "status": 401
        },
        {
          "code": "caller_not_allowed",
          "status": 403
        },
        {
          "code": "host_not_allowed",
          "status": 403
        },
        {
          "code": "invalid_request",
          "status": 400
        },
        {
          "code": "runtime_execution_mismatch",
          "status": 409
        },
        {
          "code": "invalid_request",
          "status": 413
        },
        {
          "code": "unsupported_media_type",
          "status": 415
        },
        {
          "code": "runtime_unavailable",
          "status": 503
        }
      ],
      "notes": "Complete authenticated mount. The mounted streamable-http service dispatches POST JSON-RPC, GET observation and DELETE session requests and rejects unsupported methods or paths itself."
    },
    {
      "method": "*",
      "path": "/mcp/{path...}",
      "authentication": "workload",
      "callers": ["agent-acp-service"],
      "caller_context": {
        "agent-acp-service": "operation"
      },
      "request_body": "http.schema.json#/$defs/protocol_request",
      "protocol_methods": {
        "POST": {
          "request_body": "http.schema.json#/$defs/protocol_request",
          "content_type": "application/json",
          "notes": "JSON-RPC request; replies are application/json or a text/event-stream of protocol_response events",
          "response_body": "http.schema.json#/$defs/protocol_response",
          "response_content_types": ["application/json", "text/event-stream"]
        },
        "GET": {
          "request_body": "none",
          "notes": "SSE observation stream carrying protocol_response events",
          "response_body": "http.schema.json#/$defs/protocol_message",
          "response_content_types": ["text/event-stream"]
        },
        "DELETE": {
          "request_body": "none",
          "notes": "session close; the mounted service may report the session as unsupported"
        }
      },
      "responses": {
        "200": {
          "body": "http.schema.json#/$defs/protocol_response",
          "content_type": "application/json"
        },
        "202": {
          "body": "none"
        }
      },
      "error_schema": "../common/error.schema.json",
      "errors": [
        {
          "code": "runtime_unauthorized",
          "status": 401
        },
        {
          "code": "caller_not_allowed",
          "status": 403
        },
        {
          "code": "host_not_allowed",
          "status": 403
        },
        {
          "code": "invalid_request",
          "status": 400
        },
        {
          "code": "invalid_request",
          "status": 413
        },
        {
          "code": "unsupported_media_type",
          "status": 415
        }
      ],
      "notes": "Same mounted service as /mcp for nested paths; the execution fence and managed-health gate apply only to the exact /mcp path."
    },
    {
      "method": "POST",
      "path": "/internal/skill-maintenance/{action}",
      "authentication": "workload",
      "callers": ["agent-acp-service"],
      "caller_context": {
        "agent-acp-service": "operation"
      },
      "signed_authority": "maintenance_ticket",
      "request_body": "skill-maintenance.schema.json",
      "actions": {
        "digest": {
          "request_body": "skill-maintenance.schema.json#/$defs/digest_request",
          "content_type": "application/json"
        },
        "install": {
          "request_body": "skill-maintenance.schema.json#/$defs/install_request",
          "content_type": "multipart/form-data",
          "notes": "metadata part follows install_request; the artifact part is a bounded zip binary"
        }
      },
      "responses": {
        "200": {
          "body": "skill-maintenance.schema.json#/$defs/maintenance_receipt",
          "content_type": "application/json"
        }
      },
      "error_schema": "../common/error.schema.json",
      "errors": [
        {
          "code": "runtime_unauthorized",
          "status": 401
        },
        {
          "code": "maintenance_unauthorized",
          "status": 401
        },
        {
          "code": "caller_not_allowed",
          "status": 403
        },
        {
          "code": "host_not_allowed",
          "status": 403
        },
        {
