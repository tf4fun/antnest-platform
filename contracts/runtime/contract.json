        },
        {
          "code": "invalid_request",
          "status": 400
        },
        {
          "code": "runtime_execution_mismatch",
          "status": 409
        },
        {
          "code": "request_conflict",
          "status": 409
        },
        {
          "code": "atomic_skill_replace_unsupported",
          "status": 409
        },
        {
          "code": "invalid_request",
          "status": 413
        },
        {
          "code": "body_too_large",
          "status": 413
        },
        {
          "code": "limit_exceeded",
          "status": 413
        },
        {
          "code": "unsupported_media_type",
          "status": 415
        },
        {
          "code": "clock_unavailable",
          "status": 503
        },
        {
          "code": "maintenance_unavailable",
          "status": 503
        },
        {
          "code": "runtime_busy",
          "status": 503
        },
        {
          "code": "outcome_unknown",
          "status": 503
        }
      ]
    },
    {
      "method": "POST",
      "path": "/internal/skill-temporary/{action}",
      "authentication": "workload",
      "callers": ["agent-acp-service"],
      "caller_context": {
        "agent-acp-service": "operation"
      },
      "signed_authority": "maintenance_ticket",
      "request_body": "temporary-skills.schema.json",
      "actions": {
        "install": {
          "request_body": "temporary-skills.schema.json#/$defs/install_metadata",
          "content_type": "multipart/form-data",
          "response_body": "temporary-skills.schema.json#/$defs/install_reply",
          "notes": "metadata part follows install_metadata; the artifact part is a bounded binary"
        },
        "release": {
          "request_body": "temporary-skills.schema.json#/$defs/release_request",
          "content_type": "application/json",
          "response_body": "temporary-skills.schema.json#/$defs/release_reply"
