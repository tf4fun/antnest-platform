        },
        {
          "code": "temporary_scope_busy",
          "status": 409
        },
        {
          "code": "limit_exceeded",
          "status": 409
        },
        {
          "code": "invalid_request",
          "status": 413
        },
        {
          "code": "body_too_large",
          "status": 413
        },
        {
          "code": "unsupported_media_type",
          "status": 415
        },
        {
          "code": "clock_unavailable",
          "status": 503
        },
        {
          "code": "temporary_unavailable",
          "status": 503
        },
        {
