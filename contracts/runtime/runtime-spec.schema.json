{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antnest.local/contracts/runtime/runtime-spec.schema.json",
  "title": "Antnest RuntimeSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["agent_id", "generation", "listen", "network", "filesystem"],
  "properties": {
    "agent_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,199}$",
      "description": "Stable deployment-safe Agent identifier used in platform resource names."
    },
    "generation": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "listen": {
      "$ref": "#/$defs/socketAddress"
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packet_contract_revision", "egress_endpoint", "tunnel_ipv4", "resolver_ipv4"],
      "properties": {
        "packet_contract_revision": {
          "type": "integer",
          "const": 1,
          "description": "Exact raw-IP-over-UDP contract revision accepted by this Runtime image."
        },
        "egress_endpoint": {
          "$ref": "#/$defs/ipv4Endpoint"
        },
        "tunnel_ipv4": {
          "type": "string",
          "format": "ipv4",
          "description": "Stable Agent Tunnel IPv4, distinct from resolver_ipv4."
        },
        "resolver_ipv4": {
          "type": "string",
          "format": "ipv4",
          "description": "Egress virtual resolver/gateway IPv4, distinct from tunnel_ipv4."
        }
      }
    },
    "filesystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace", "system_skills"],
      "properties": {
        "workspace": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/",
          "description": "Normalized absolute writable workspace root; must not overlap system_skills."
        },
        "system_skills": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/",
          "description": "Normalized absolute system Skill root; must not overlap workspace."
        }
      }
    }
  },
  "$defs": {
    "socketAddress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port"],
      "properties": {
        "host": {
          "type": "string",
          "const": "0.0.0.0"
        },
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      },
      "description": "Internal Runtime HTTP listener expressed without language-specific socket parsing."
    },
    "ipv4Endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ipv4", "port"],
      "properties": {
        "ipv4": {"type": "string", "format": "ipv4"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      },
      "description": "Controller-resolved usable unicast IPv4 address and UDP port."
    }
  }
}
