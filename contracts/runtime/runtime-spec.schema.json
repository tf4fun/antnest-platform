{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antnest.local/contracts/runtime/runtime-spec.schema.json",
  "title": "Antnest RuntimeSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["agent_id", "generation", "listen", "network", "filesystem"],
  "properties": {
    "skill_maintenance_verifiers": {
      "$ref": "#/$defs/skillMaintenanceVerifiers",
      "description": "Immutable learning verifier bootstrap. RC freezes the bounded public-key set with each accepted lifecycle operation and includes it in the deployment digest. Runtime validates the set and uses it for its private maintenance route. Empty keys disable maintenance."
    },
    "mcp_servers": {
      "type": "array",
      "default": [],
      "maxItems": 8,
      "description": "Required non-root stdio MCP processes, initialized before readiness. IDs must be unique; each configuration is limited to 32 KiB and the encoded array to 64 KiB. Changing this list requires a Runtime rebuild.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,15}$"
          },
          "command": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "args": {
            "type": "array",
            "default": [],
            "maxItems": 64,
            "items": {
              "type": "string",
              "maxLength": 8192
            }
          },
          "env": {
            "type": "object",
            "default": {},
            "maxProperties": 64,
            "propertyNames": {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$",
              "not": {
                "anyOf": [
                  {
                    "enum": ["HOME", "PATH"]
                  },
                  {
                    "pattern": "^ANTNEST_"
                  }
                ]
              }
            },
            "additionalProperties": {
              "type": "string",
              "maxLength": 8192
            }
          }
        }
      }
    },
    "agent_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,199}$",
      "description": "Stable deployment-safe Agent identifier used in platform resource names."
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "listen": {
      "$ref": "#/$defs/socketAddress"
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_contract_revision",
        "egress_endpoint",
        "tunnel_ipv4",
        "resolver_ipv4"
      ],
      "properties": {
        "packet_contract_revision": {
          "type": "integer",
          "const": 1,
          "description": "Exact raw-IP-over-UDP contract revision accepted by this Runtime image."
        },
        "egress_endpoint": {
          "$ref": "#/$defs/ipv4Endpoint"
        },
        "tunnel_ipv4": {
          "type": "string",
          "format": "ipv4",
          "description": "Stable Agent Tunnel IPv4, distinct from resolver_ipv4."
        },
        "resolver_ipv4": {
          "type": "string",
          "format": "ipv4",
          "description": "Egress virtual resolver/gateway IPv4, distinct from tunnel_ipv4."
        }
      }
    },
    "filesystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace", "system_skills"],
      "properties": {
        "workspace": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/",
          "description": "Normalized absolute writable workspace root; must not overlap system_skills."
        },
        "system_skills": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/",
          "description": "Normalized absolute system Skill root; must not overlap workspace."
        }
      }
    },
    "authentication": {
      "$ref": "instance-connection.schema.json#/$defs/bootstrap_descriptor",
      "description": "RC-owned nonsecret bootstrap identity, frozen with accepted generation. Runtime consumer adoption is a separate #30 batch; no bearer enters RuntimeSpec."
    }
  },
  "$defs": {
    "maintenanceKid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "description": "Exact ASCII maintenance key identity shared by RC, Runtime and ACP. No whitespace normalization; see maintenance-kid-fixtures.json."
    },
    "socketAddress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port"],
      "properties": {
        "host": {
          "type": "string",
          "const": "0.0.0.0"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "description": "Internal Runtime HTTP listener expressed without language-specific socket parsing."
    },
    "skillMaintenanceVerifiers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keys"],
      "properties": {
        "keys": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kid", "algorithm", "public_key_base64url"],
            "properties": {
              "kid": {
                "$ref": "#/$defs/maintenanceKid"
              },
              "algorithm": {
                "const": "Ed25519"
              },
              "public_key_base64url": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{43}$"
              }
            }
          }
        }
      }
    },
    "ipv4Endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ipv4", "port"],
      "properties": {
        "ipv4": {
          "type": "string",
          "format": "ipv4"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "description": "Controller-resolved usable unicast IPv4 address and UDP port."
    }
  }
}
