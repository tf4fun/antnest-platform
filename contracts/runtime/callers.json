  "routes": {
    "* /mcp": {
      "callers": [
        "agent-acp-service"
      ],
      "authentication": "workload",
      "caller_context": {
        "agent-acp-service": "operation"
      },
      "request_body": "protocol",
      "notes": "The mounted MCP service dispatches POST JSON RPC (application/json), GET observation and DELETE session requests. Authenticate the complete mount and retain the execution fence; unsupported methods/paths must fail."
    },
    "GET /status": {
      "callers": [
        "runtime-controller",
        "agent-acp-service"
      ],
      "authentication": "workload",
      "caller_context": {
        "runtime-controller": "none",
        "agent-acp-service": "none"
      },
      "request_body": "none"
    },
    "POST /internal/skill-maintenance/{action}": {
      "callers": [
        "agent-acp-service"
      ],
      "authentication": "workload",
      "caller_context": {
        "agent-acp-service": "operation"
      },
      "request_body": "json",
      "notes": "Workload proof supplements the existing signed ticket and execution fence; it never replaces them."
    },
    "POST /internal/skill-temporary/{action}": {
      "callers": [
        "agent-acp-service"
      ],
      "authentication": "workload",
      "caller_context": {
        "agent-acp-service": "operation"
      },
      "request_body": "json",
      "notes": "Workload proof supplements the existing signed ticket and execution fence; it never replaces them."
    },
    "* /mcp/{path...}": {
      "callers": [
        "agent-acp-service"
      ],
      "authentication": "workload",
      "caller_context": {
        "agent-acp-service": "operation"
      },
      "request_body": "protocol",
      "notes": "The mounted MCP service dispatches POST JSON RPC (application/json), GET observation and DELETE session requests. Authenticate the complete mount and retain the execution fence; unsupported methods/paths must fail."
    }
  },
