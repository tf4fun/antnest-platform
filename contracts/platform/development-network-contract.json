  "runtime_management": {
    "subnet_environment": "ANTNEST_RUNTIME_MANAGEMENT_SUBNET",
    "default_subnet": "172.30.255.0/24",
    "dynamic_ip_range_environment": "ANTNEST_RUNTIME_MANAGEMENT_IP_RANGE",
    "default_dynamic_ip_range": "172.30.255.128/25",
    "static_members": [
      "runtime-controller",
      "agent-acp-service",
      "runtime-egress",
      "runtime-telemetry-ingress"
    ],
    "static_addresses": {
      "runtime-egress": 3,
      "runtime-telemetry-ingress": 4,
      "runtime-controller": 5,
      "agent-acp-service": 6
    },
    "dynamic_member": "antnest-runtime",
    "business_listeners": false,
    "jaeger_member": false,
    "diagnostics_member": false,
    "telemetry_exception": "fixed-otlp-data-ingestion-only"
  },
  "infrastructure": {
    "runtime_telemetry_ingress": {
      "service": "runtime-telemetry-ingress",
      "profile": "observability",
      "bind_network": "runtime-management",
      "bind_address_suffix": 4,
      "port": 4318,
      "methods": ["POST"],
      "paths": ["/v1/traces", "/v1/metrics", "/v1/logs"],
      "query_strings": false,
      "upstream": "jaeger",
      "upstream_network": "observability",
      "upstream_port": 4318,
      "max_wire_body_bytes": 8388608,
      "max_upstream_response_bytes": 1048576,
      "max_inflight": 8,
      "timeout_ms": 15000,
      "forwarded_request_headers": ["content-type", "content-encoding"],
      "forward_authority_headers": false,
      "business_credential_mounts": false,
      "host_publications": false,
      "read_only": true,
      "uid": 65532,
      "gid": 65532,
      "capabilities": []
    },
    "diagnostics": {
      "publisher": "diagnostic-relay",
      "profile": "diagnostics",
      "enabled_by_debug_overlay": true,
      "stage3_port_suppression": "explicit-test-override",
      "transport": "opaque-tcp",
      "bind_network": "diagnostic-ingress",
      "bind_address_suffix": 146,
      "listener_ports": {
        "postgres": 5432,
        "temporal": 7233,
        "runtime-controller": 58080,
        "agent-acp-service": 58081,
        "identity-service": 58082,
        "agent-controller": 58083,
        "jaeger": 16686
      },
