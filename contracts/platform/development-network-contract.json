          "address_suffix": 162,
          "port": 5432
        },
        "temporal": {
          "network": "temporal-clients",
          "address_suffix": 98,
          "port": 7233
        },
        "runtime-controller": {
          "network": "controller-runtime",
          "address_suffix": 50,
          "port": 8080
        },
        "agent-acp-service": {
          "network": "edge",
          "address_suffix": 5,
          "port": 8080
        },
        "identity-service": {
          "network": "identity-clients",
          "address_suffix": 66,
          "port": 8080
        },
        "agent-controller": {
          "network": "controller-clients",
          "address_suffix": 18,
          "port": 8080
        },
        "jaeger": {
          "network": "observability",
          "address_suffix": 114,
          "port": 16686
        }
      },
      "arbitrary_targets": false,
      "business_credential_mounts": false,
      "max_connections": 64,
      "max_buffer_bytes_per_stream": 65536,
      "connect_timeout_ms": 5000,
      "idle_timeout_ms": 300000,
