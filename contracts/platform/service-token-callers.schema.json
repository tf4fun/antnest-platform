{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antnest.local/contracts/platform/service-token-callers.schema.json",
  "title": "Token-mode receiver caller hashes",
  "$comment": "Also reject duplicate decoded JSON member names, hashes shared across callers, and the receiver's own identity unless its route catalog explicitly grants it. These checks require more than JSON Schema.",
  "type": "object",
  "maxProperties": 10,
  "propertyNames": {
    "enum": [
      "identity-service",
      "edge-gateway",
      "admin-console",
      "agent-ui",
      "agent-controller",
      "agent-acp-service",
      "runtime-controller",
      "skill-registry",
      "runtime-egress",
      "antnest-runtime"
    ]
  },
  "additionalProperties": {
    "type": "array",
    "minItems": 1,
    "maxItems": 2,
    "uniqueItems": true,
    "items": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
