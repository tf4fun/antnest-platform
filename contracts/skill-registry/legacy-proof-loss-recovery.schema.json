{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antnest.local/skill-registry/legacy-proof-loss-recovery.schema.json",
  "title": "Legacy Skill proof-loss recovery v1",
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization_id", "actor_principal_id", "failed_migration_request_id"],
      "properties": {
        "organization_id": { "type": "string", "pattern": "^org_[0-9a-f]{32}$" },
        "actor_principal_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "failed_migration_request_id": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "agent_id", "failed_migration_request_id", "state", "phase", "target_runtime_revision"],
      "properties": {
        "request_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "agent_id": { "type": "string", "pattern": "^agent_[0-9a-f]{32}$" },
        "failed_migration_request_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "state": { "enum": ["running", "completed", "manual_recovery_required"] },
        "phase": { "enum": ["verify", "disable_runtime", "publish", "done"] },
        "target_runtime_revision": { "type": "string", "pattern": "^rtv_[0-9a-f]{32}$" },
        "child_request_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "disabled_runtime_revision": { "type": "string", "pattern": "^rtv_[0-9a-f]{32}$" },
        "error_code": { "const": "legacy_migration_manual_recovery_required" },
        "manual_reason": { "enum": ["runtime_disable_rejected", "network_attachment_changed", "publication_conflict"] }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "completed" } } },
          "then": {
            "properties": { "phase": { "const": "done" } },
            "required": ["child_request_id", "disabled_runtime_revision"]
          }
        },
        {
          "if": { "properties": { "state": { "const": "manual_recovery_required" } } },
          "then": { "required": ["error_code", "manual_reason"] }
        }
      ]
    }
  }
}
