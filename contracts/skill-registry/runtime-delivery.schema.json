{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antnest.local/contracts/skill-registry/runtime-delivery.schema.json",
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "frozen_skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill_id", "version", "name", "description", "artifact_digest", "content_digest", "artifact_size", "unpacked_size", "package_rules_version"],
      "properties": {
        "skill_id": {"type": "string", "pattern": "^skill_[0-9a-f]{32}$"},
        "version": {"type": "integer", "minimum": 1},
        "name": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
        "description": {"type": "string", "minLength": 1, "maxLength": 512},
        "artifact_digest": {"$ref": "#/$defs/digest"},
        "content_digest": {"$ref": "#/$defs/digest"},
        "artifact_size": {"type": "integer", "minimum": 1, "maximum": 8388608},
        "unpacked_size": {"type": "integer", "minimum": 1, "maximum": 33554432},
        "package_rules_version": {"const": 1}
      }
    },
    "prepare_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization_id", "owner_operation_id", "layout_version", "skill_set_digest", "system_skills"],
      "properties": {
        "organization_id": {"type": "string", "pattern": "^org_[0-9a-f]{32}$"},
        "owner_operation_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "layout_version": {"const": 1},
        "skill_set_digest": {"$ref": "#/$defs/digest"},
        "system_skills": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/frozen_skill"}}
      }
    },
    "prepared_skill_set": {
      "type": "object", "additionalProperties": false,
      "required": ["skill_set_digest", "layout_version"],
      "properties": {"skill_set_digest": {"$ref": "#/$defs/digest"}, "layout_version": {"const": 1}}
    },
    "progress": {
      "type": "object", "additionalProperties": false,
      "required": ["verified_packages", "verified_bytes", "total_packages", "total_bytes"],
      "properties": {
        "verified_packages": {"type": "integer", "minimum": 0},
        "verified_bytes": {"type": "integer", "minimum": 0},
        "total_packages": {"type": "integer", "minimum": 0, "maximum": 32},
        "total_bytes": {"type": "integer", "minimum": 0, "maximum": 134217728}
      }
    },
    "prepare_receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["request_id", "agent_id", "organization_id", "owner_operation_id", "state", "progress"],
      "properties": {
        "request_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "agent_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "organization_id": {"type": "string", "pattern": "^org_[0-9a-f]{32}$"},
        "owner_operation_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "state": {"enum": ["queued", "preparing", "retry_wait", "paused", "ready", "rejected", "invalidated", "cleanup_pending"]},
        "progress": {"$ref": "#/$defs/progress"},
        "prepared_skill_set": {"$ref": "#/$defs/prepared_skill_set"},
        "prepared_reference_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "retry_after": {"type": "string", "format": "date-time"},
        "error_code": {"type": "string"}
      }
    }
  }
}
