{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.antnest.dev/common/error.schema.json",
  "title": "Common API error envelope",
  "type": "object",
  "required": [
    "code",
    "category",
    "message",
    "retryable",
    "request_id"
  ],
  "properties": {
    "code": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "enum": [
        "invalid_request",
        "unauthenticated",
        "forbidden",
        "not_found",
        "conflict",
        "precondition_failed",
        "rate_limited",
        "unavailable",
        "internal"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "retryable": {
      "type": "boolean"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "details": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
