{
  "revision": 5,
  "transport": "json-over-http",
  "trust_boundary": "verified-controller-workload",
  "status_values": ["ready", "degraded"],
  "builtin_policies": {
    "deny_all": {
      "policy_id": "builtin/deny-all",
      "revision": 1
    },
    "allow_all": {
      "policy_id": "builtin/allow-all",
      "revision": 1
    }
  },
  "routes": [
    {
      "method": "GET",
      "path": "/status"
    },
    {
      "method": "GET",
      "path": "/internal/agent-networks/{agent_id}"
    },
    {
      "method": "PUT",
      "path": "/internal/agent-networks/{agent_id}"
    },
    {
      "method": "PUT",
      "path": "/internal/agent-network-attachments/{agent_id}",
      "request_schema": "attachment-state-request.schema.json"
    },
    {
      "method": "POST",
      "path": "/internal/agent-networks/{agent_id}/release",
      "request_schema": "resource-version-request.schema.json"
    },
    {
      "method": "PUT",
      "path": "/internal/policies/{policy_id}/revisions/{revision}"
    },
    {
      "method": "GET",
      "path": "/internal/policies/{policy_id}/revisions/{revision}"
    },
    {
      "method": "GET",
      "path": "/internal/agent-policy-assignments/{agent_id}"
    },
    {
      "method": "PUT",
      "path": "/internal/agent-policy-assignments/{agent_id}"
    }
  ],
  "schemas": {
    "policy": "policy.schema.json",
    "packet": "../runtime/packet-contract.json",
    "attachment_state_request": "attachment-state-request.schema.json",
    "resource_version_request": "resource-version-request.schema.json",
    "service_token": "../platform/service-token-callers.schema.json"
  },
  "error_codes": [
    "service_unauthenticated",
    "caller_not_allowed",
    "unsupported_media_type",
    "invalid_request",
    "route_not_found",
    "agent_network_not_found",
    "policy_revision_not_found",
    "method_not_allowed",
    "agent_network_unavailable",
    "policy_revision_conflict",
    "resource_version_conflict",
    "address_pool_exhausted",
    "cleanup_failed",
    "operation_failed",
    "control_plane_unavailable"
  ]
}
