{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.antnest.dev/egress/attachment-state-request.stored-v2.schema.json",
  "title": "Runtime Egress attachment state request",
  "type": "object",
  "additionalProperties": false,
  "required": ["state"],
  "properties": {
    "state": {"enum": ["closed", "pending", "open"]},
    "expected_resource_version": {"type": "integer", "minimum": 1, "deprecated": true, "maximum": 9223372036854775807},
    "expected_version": {
      "allOf": [
        {"$ref": "../common/precondition.schema.json#/$defs/expected_version"},
        {"type": "string", "pattern": "^([1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$", "maxLength": 19, "not": {"pattern": "[^0-9]"}}
      ]
    },
    "runtime_endpoint": {"type": ["string", "null"], "format": "ipv4"},
    "tunnel_key_id": {"type": ["string", "null"], "pattern": "^rtk_[0-9a-f]{32}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "open"}}, "required": ["state"]},
      "then": {
        "required": ["runtime_endpoint", "tunnel_key_id"],
        "properties": {"runtime_endpoint": {"type": "string"}, "tunnel_key_id": {"type": "string"}}
      },
      "else": {"properties": {"runtime_endpoint": {"type": "null"}, "tunnel_key_id": {"type": "null"}}}
    },
    {
      "oneOf": [
        {
          "required": ["expected_version"],
          "properties": {"expected_version": true},
          "not": {"required": ["expected_resource_version"], "properties": {"expected_resource_version": true}}
        },
        {
          "required": ["expected_resource_version"],
          "properties": {"expected_resource_version": true},
          "not": {"required": ["expected_version"], "properties": {"expected_version": true}}
        }
      ]
    }
  ]
}
