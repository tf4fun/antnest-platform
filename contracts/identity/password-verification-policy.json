{
  "contract": "antnest.identity.password-verification",
  "revision": 1,
  "wire_baseline": {
    "identity_revision": 16,
    "gateway_version": 21
  },
  "activation": {
    "identity_revision": 17,
    "gateway_version": 22,
    "active_catalog_changes_with_owning_implementation": true
  },
  "attempts": {
    "store": "postgresql-credential_attempts",
    "clock": "fresh-database-clock-after-lock-waits",
    "operations": {
      "local_login": ["organization", "login_account"],
      "change_local_password": ["organization", "password_change_user"]
    },
    "scopes": {
      "login_account": {
        "threshold": 5,
        "reset_on_success": true
      },
      "organization": {
        "threshold": 100,
        "reset_on_success": false
      },
      "password_change_user": {
        "threshold": 5,
        "reset_on_success": true
      }
    },
    "keys": {
      "login_account": ["organization-namespace", "normalized-email"],
      "password_change_user": ["global-user-id"],
      "organization": ["organization-namespace"],
      "known_organization": "stable-organization-id",
      "unknown_organization": "separate-normalized-slug-namespace",
      "password_change_organization": "verified-cct-organization",
      "login_organization_frozen_after_lookup": true,
      "slug_reuse_transfers_old_counters": false,
      "encoding": "sha256-of-domain-separated-length-prefixed-utf8"
    },
    "unknown": {
      "applies_to": "local_login",
      "known_organization_uses_real_organization_bucket": true,
      "same_account_threshold_and_backoff": true,
      "dummy_verifications_per_admitted_attempt": 1,
      "dummy_match_is_authentication": false,
      "dummy_match_counts_as_failure": true,
      "inactive_or_missing_credential_uses_dummy": true,
      "busy_and_cancellation_match_known_path": true,
      "resource_error_counts_as_failure": false,
      "raw_identity_in_errors_or_telemetry": false
    },
    "backoff": {
      "first_delay_ms": 1000,
      "multiplier": 2,
      "maximum_delay_ms": 900000,
      "starts_on_threshold_failure": true,
      "rejected_attempt_extends_lock": false,
      "sleep_while_holding_transaction": false,
      "action": "return-429-before-kdf"
    },
    "serialization": "hold-ordered-bucket-locks-through-verification-and-outcome-commit",
    "lock_order": [
      "organization-attempt",
      "account-or-user-attempt",
      "user",
      "organization",
      "membership",
      "credential-update",
      "sorted-browser-tokens",
      "revocation-feed"
    ],
    "lock_wait_max_ms": 2000,
    "organization_lock_precedes_new_account_row": true,
    "outcomes": {
      "bad_password": "commit-counters-then-return-authentication-error",
      "success": "commit-account-reset-with-token-or-rotation",
      "organization_success_reset": false,
      "error_before_commit_returns_authentication_rejection": false,
      "never_count": [
        "backoff-rejection",
        "resource-busy",
        "cancellation",
        "database-error-before-commit",
        "invalid-stored-hash",
        "caller-expired-or-revoked",
        "credential-cas-conflict",
        "issuance-failure"
      ],
      "ambiguous_commit": {
        "verified_failure_or_success_reset_may_be_durable": true,
        "return": "operation-error-without-credential",
        "return_confirmed_authentication_rejection": false,
        "promise_rollback": false,
        "compensate_counters": false,
        "automatically_repeat": false
      }
    },
    "retention": {
      "window_ms": 900000,
      "reset_requires_window_and_lock_expired": true,
      "failure_count_saturates_at_threshold_plus": 10,
      "cleanup_interval_ms": 60000,
      "cleanup_batch_rows": 500,
      "cleanup_skips_locked_rows": true,
      "cleanup_never_deletes_active_lock": true
    }
  },
  "resources": {
    "owner": "single-identity-process-engine",
    "operations": [
      "login-verify",
      "unknown-account-dummy-verify",
      "dummy-initialization",
      "login-rehash",
      "password-change-verify",
      "password-change-hash",
      "create-local-user",
      "bootstrap-administrator"
    ],
    "dummy_initialization": {
      "verifier": "random-salt-and-random-rejection-target",
      "policy": "current-configured-parameters-without-rounding",
      "salt_bytes": 16,
      "key_bytes": 32,
      "preparation_kdf_calls": 0,
      "shares_weighted_admission": true,
      "cancellation_and_shutdown": "join-started-work-discard-result-then-release",
      "verification_kdf_calls_per_admitted_attempt": 1,
      "persist_or_rehash": false,
      "permit_weight_is_actual_allocation": false
    },
    "admission": "joint-fifo-memory-and-operation-permits",
    "weight": "declared-stored-or-configured-memory-kib",
    "count_only_is_memory_limit": false,
    "impossible_weight": "immediate-credential_busy",
    "maximum_queued": 32,
    "wait_max_ms": 2000,
    "clip_wait_to_request_deadline": true,
    "unbounded_fallback": false,
    "queued_cancellation": "remove-waiter-without-starting-kdf",
    "running_cancellation": "join-kdf-discard-result-then-release",
    "release_before_kernel_returns": false,
    "cancelled_result_can_issue_or_mutate": false,
    "shutdown": [
      "reject-new-work",
      "cancel-queued-work",
      "join-started-work",
      "close-repository"
    ]
  },
  "configuration": {
    "memory_kib": {
      "env": "ANTNEST_IDENTITY_ARGON2_MEMORY_KIB",
      "default": 65536,
      "minimum": 8,
      "maximum": 1048576
    },
    "iterations": {
      "env": "ANTNEST_IDENTITY_ARGON2_ITERATIONS",
      "default": 3,
      "minimum": 1,
      "maximum": 10
    },
    "parallelism": {
      "env": "ANTNEST_IDENTITY_ARGON2_PARALLELISM",
      "default": 2,
      "minimum": 1,
      "maximum": 16
    },
    "memory_budget_kib": {
      "env": "ANTNEST_IDENTITY_ARGON2_MEMORY_BUDGET_KIB",
      "default": 131072,
      "minimum": 8,
      "maximum": 4194304
    },
    "max_concurrent": {
      "env": "ANTNEST_IDENTITY_ARGON2_MAX_CONCURRENT",
      "default": "min(64,max(2,GOMAXPROCS))",
      "minimum": 1,
      "maximum": 64
    },
    "policy_memory_must_fit_budget": true,
    "minimum_memory_per_lane_kib": 8,
    "invalid_value": "startup-error-without-secret-values"
  },
  "stored_hash": {
    "algorithm": "argon2id",
    "version": 19,
    "maximum_encoded_bytes": 256,
    "salt_bytes": 16,
    "key_bytes": 32,
    "memory_max_kib": 1048576,
    "iterations_max": 10,
    "parallelism_max": 16,
    "memory_minimum_per_lane_kib": 8,
    "parse_before_resource_admission": true,
    "use_stored_parameters_without_rounding_input": true,
    "canonical_decimal_and_unpadded_base64": true,
    "allow_unknown_duplicate_or_trailing_fields": false,
    "valid_cost_exceeds_budget": "credential_busy",
    "needs_rehash": "valid-encoding-and-any-policy-parameter-differs"
  },
  "rehash": {
    "trigger": "successful-active-local-login-with-different-policy",
    "verify_with_old_parameters_first": true,
    "new_hash_uses_shared_budget_and_original_context": true,
    "expected_hash_cas": true,
    "credential_lock_from_first_acquisition": "update",
    "commit_with_token_and_account_reset": true,
    "cas_conflict": "reject-without-token-or-failure-count",
    "overwrite_concurrent_password_rotation": false,
    "revoke_existing_sessions": false
  },
  "wire": {
    "failure_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "body", "retry_after"],
      "properties": {
        "status": {
          "type": "integer",
          "enum": [429, 503]
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "retryable"],
          "properties": {
            "code": {
              "type": "string",
              "enum": ["credential_rate_limited", "credential_busy"]
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "retryable": {
              "const": true
            }
          }
        },
        "retry_after": {
          "type": "string"
        }
      },
      "oneOf": [
        {
          "properties": {
            "status": {
              "const": 429
            },
            "body": {
              "type": "object",
              "properties": {
                "code": {
                  "const": "credential_rate_limited"
                },
                "message": {
                  "const": "Too many password attempts"
                }
              }
            },
            "retry_after": {
              "type": "string",
              "pattern": "^(?:[1-9]|[1-9][0-9]|[1-8][0-9]{2}|900)$"
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": 503
            },
            "body": {
              "type": "object",
              "properties": {
                "code": {
                  "const": "credential_busy"
                },
                "message": {
                  "const": "Password verification is busy"
                }
              }
            },
            "retry_after": {
              "const": "1"
            }
          }
        }
      ]
    },
    "rate_retry_after": "ceil-max-remaining-bucket-lock-seconds-clamped-1-to-900",
    "busy_retry_after_seconds": 1,
    "header_cardinality": "exactly-one"
  },
  "gateway": {
    "routes": ["/api/session/login", "/api/session/password"],
    "preserve_identity_code_status_and_retryable": true,
    "cookie_writes_on_rate_or_busy": 0,
    "cache_control": "no-store",
    "automatic_request_replay": false,
    "invalid_failure_metadata": "503-identity_unavailable-without-retry-after",
    "existing_edge_admission_code": "login_rate_limited",
    "edge_table_eviction_in_scope": false
  },
  "password_change": {
    "owner": "browsersessions",
    "missing_credential": "invalid_argument-without-dummy-or-failure-count",
    "live_caller_before_and_after_waits": true,
    "live_caller_before_bad_password_commit": true,
    "expected_hash_cas": true,
    "revoke_all_prior_sessions_atomically": true,
    "replacement_preserves_original_absolute_deadline": true,
    "ambiguous_commit_returns_replayable_token": false
  },
  "admin_console": {
    "route": "POST /api/admin/directory/users",
    "identity_operation": "create-local-user",
    "failure_code": "credential_busy",
    "preserve_validated_failure_and_retry_after": true,
    "cookie_writes_on_busy": 0,
    "cache_control": "no-store",
    "automatic_request_replay": false,
    "invalid_failure_metadata": "503-identity_unavailable-without-retry-after",
    "consumer_batch": "admin-console-consumer"
  },
  "admission": {
    "batch_order": [
      "shared-contract",
      "identity-resource-and-hash",
      "identity-attempts-and-rehash",
      "gateway-consumer",
      "admin-console-consumer",
      "integration"
    ],
    "integration_required": [
      "two-identity-instances-shared-postgresql",
      "concurrent-fifth-and-sixth-wrong-password",
      "unknown-account-and-organization-parity",
      "correct-password-after-delay-resets-account-only",
      "password-change-current-password-limit",
      "legacy-hash-rehash-cas-and-rotation-races",
      "200-concurrent-identity-logins-rss-and-recovery",
      "real-https-errors-retry-after-and-cookie-preservation",
      "console-create-user-busy-retry-after-and-recovery"
    ],
    "docker": {
      "concurrent_logins": 200,
      "distinct_organization_scopes": true,
      "credential_lock_isolation": "distinct-global-users-or-unknown-dummy",
      "db_pool_exceeds_running_and_queued_kdf_slots": true,
      "require_kdf_busy_receipts": true,
      "database_busy_alone_proves_kdf_pressure": false,
      "rate_rejections_alone_prove_resource_limit": false,
      "work_budget_kib": 131072,
      "process_baseline_max_bytes": 134217728,
      "gc_and_service_headroom_bytes": 268435456,
      "rss_budget_bytes": 536870912,
      "peak_rss_from_live_process": true,
      "rss_measurement": {
        "process_identity": "container-id-pid-and-proc-starttime",
        "window": "pre-pressure-through-drain-and-recovery",
        "sources": [
          "proc-status-VmHWM",
          "proc-status-VmRSS",
          "proc-smaps_rollup-Rss"
        ],
        "peak": "maximum-kernel-high-water-and-observed-rss",
        "source_unavailable_or_process_changed": "failed-gate",
        "preserve_raw_timestamped_measurements": true,
        "proves_universal_or_byte_exact_bound": false
      },
      "allow_oom_or_restart": false,
      "successful_login_after_pressure": true
    }
  }
}
