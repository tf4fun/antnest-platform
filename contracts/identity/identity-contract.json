{
  "contract": "antnest.identity",
  "revision": 14,
  "transport": "json-over-http",
  "trust": "verified-workload-and-caller-context",
  "base_path": "/rpc/identity",
  "authentication": {
    "profile": "../platform/service-authentication.md",
    "details": "service-authentication.md",
    "workload_header": "Antnest-Service-Authorization",
    "caller_context_header": "Antnest-Caller-Context",
    "actor_principal_id": "Audit echo of the verified CCT sub; mismatch is actor_mismatch. No body-only fallback."
  },
  "definitions": {
    "principal_revocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "user_id", "reason", "occurred_at"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "user_id": { "$ref": "#/definitions/id" },
        "organization_id": { "$ref": "#/definitions/id" },
        "reason": { "type": "string", "enum": ["user_deactivated", "membership_deactivated", "membership_deleted"] },
        "occurred_at": { "$ref": "#/definitions/timestamp" },
        "traceparent": { "type": "string", "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$" }
      },
      "oneOf": [
        { "properties": { "reason": { "const": "user_deactivated" } }, "not": { "required": ["organization_id"] } },
        { "properties": { "reason": { "enum": ["membership_deactivated", "membership_deleted"] } }, "required": ["organization_id"] }
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,199}$"
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "organization_role": { "type": "string", "enum": ["member", "admin"] },
    "system_role": { "type": "string", "enum": ["user", "admin"] },
    "source": { "type": "string", "enum": ["local", "scim"] },
    "scim_scope": { "type": "string", "enum": ["scim:read", "scim:write"] },
    "organization": {
      "type": "object",
      "required": ["id", "slug", "name", "active", "created_at", "updated_at"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "slug": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "active": { "type": "boolean" },
        "created_at": { "$ref": "#/definitions/timestamp" },
        "updated_at": { "$ref": "#/definitions/timestamp" }
      }
    },
    "user": {
      "type": "object",
      "required": ["id", "system_role", "active", "created_at", "updated_at"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "system_role": { "$ref": "#/definitions/system_role" },
        "active": { "type": "boolean" },
        "created_at": { "$ref": "#/definitions/timestamp" },
        "updated_at": { "$ref": "#/definitions/timestamp" }
      }
    },
    "membership": {
      "type": "object",
      "required": [
        "id",
        "organization_id",
        "user_id",
        "email",
        "display_name",
        "role",
        "source",
        "active",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "organization_id": { "$ref": "#/definitions/id" },
        "user_id": { "$ref": "#/definitions/id" },
        "email": { "type": "string", "format": "email" },
        "display_name": { "type": "string", "minLength": 1 },
        "role": { "$ref": "#/definitions/organization_role" },
        "source": { "$ref": "#/definitions/source" },
        "active": { "type": "boolean" },
        "scim_external_id": { "type": "string" },
        "scim_user_name": { "type": "string" },
        "created_at": { "$ref": "#/definitions/timestamp" },
        "updated_at": { "$ref": "#/definitions/timestamp" }
      }
    },
    "group": {
      "type": "object",
      "required": [
        "id",
        "organization_id",
        "display_name",
        "source",
        "active",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "organization_id": { "$ref": "#/definitions/id" },
        "display_name": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/definitions/source" },
        "active": { "type": "boolean" },
        "scim_external_id": { "type": "string" },
        "created_at": { "$ref": "#/definitions/timestamp" },
        "updated_at": { "$ref": "#/definitions/timestamp" }
      }
    },
    "directory_member": {
      "type": "object",
      "required": ["user", "membership"],
      "properties": {
        "user": { "$ref": "#/definitions/user" },
        "membership": { "$ref": "#/definitions/membership" }
      }
    },
    "principal": {
      "type": "object",
      "required": [
        "user_id",
        "organization_id",
        "organization_slug",
        "organization_name",
        "membership_id",
        "system_role",
        "organization_role",
        "active"
      ],
      "properties": {
        "user_id": { "$ref": "#/definitions/id" },
        "organization_id": { "$ref": "#/definitions/id" },
        "organization_slug": { "type": "string", "minLength": 1 },
        "organization_name": { "type": "string", "minLength": 1 },
        "membership_id": { "$ref": "#/definitions/id" },
        "system_role": { "$ref": "#/definitions/system_role" },
        "organization_role": { "$ref": "#/definitions/organization_role" },
        "active": { "type": "boolean" }
      }
    },
    "current_account": {
      "type": "object",
      "required": [
        "user_id",
        "organization_id",
        "membership_id",
        "email",
        "display_name",
        "source",
        "local_password_available"
      ],
      "properties": {
        "user_id": { "$ref": "#/definitions/id" },
        "organization_id": { "$ref": "#/definitions/id" },
        "membership_id": { "$ref": "#/definitions/id" },
        "email": { "type": "string", "format": "email" },
        "display_name": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/definitions/source" },
        "local_password_available": { "type": "boolean" }
      }
    },
    "organization_principal_binding": {
      "type": "object",
      "required": ["user_id", "organization_id", "membership_id", "active"],
      "properties": {
        "user_id": { "$ref": "#/definitions/id" },
        "organization_id": { "$ref": "#/definitions/id" },
        "membership_id": { "$ref": "#/definitions/id" },
        "active": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "scim_token": {
      "type": "object",
      "required": ["id", "organization_id", "name", "scopes", "created_at"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "organization_id": { "$ref": "#/definitions/id" },
        "name": { "type": "string", "minLength": 1 },
        "scopes": {
          "type": "array",
          "items": { "$ref": "#/definitions/scim_scope" }
        },
        "created_at": { "$ref": "#/definitions/timestamp" },
        "revoked_at": { "$ref": "#/definitions/timestamp" }
      }
    },
    "oidc_provider": {
      "type": "object",
      "required": [
        "id",
        "organization_id",
        "name",
        "display_name",
        "issuer",
        "client_id",
        "scopes",
        "enabled",
        "revision",
        "authorization_endpoint",
        "token_endpoint",
        "token_endpoint_auth_method",
        "id_token_signing_algs",
        "jwks_uri",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "organization_id": { "$ref": "#/definitions/id" },
        "name": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string", "minLength": 1 },
        "issuer": { "type": "string", "format": "uri" },
        "client_id": { "type": "string", "minLength": 1 },
        "scopes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "enabled": { "type": "boolean" },
        "revision": { "type": "integer", "minimum": 1 },
        "authorization_endpoint": { "type": "string", "format": "uri" },
        "token_endpoint": { "type": "string", "format": "uri" },
        "token_endpoint_auth_method": {
          "type": "string",
          "enum": ["client_secret_basic", "client_secret_post"]
        },
        "id_token_signing_algs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "userinfo_endpoint": { "type": "string" },
        "jwks_uri": { "type": "string", "format": "uri" },
        "created_at": { "$ref": "#/definitions/timestamp" },
        "updated_at": { "$ref": "#/definitions/timestamp" }
      }
    },
    "login_method": {
      "type": "object",
      "required": ["name", "display_name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string", "minLength": 1 }
      }
    }
  },
  "error": {
    "required": ["code", "message", "retryable"],
    "properties": {
      "code": {
        "type": "string",
        "enum": [
          "invalid_argument",
          "bad_request",
          "unauthenticated",
          "service_unauthenticated",
          "caller_not_allowed",
          "caller_context_required",
          "caller_context_invalid",
          "actor_mismatch",
          "unsupported_media_type",
          "identity_dependency_unavailable",
          "forbidden",
          "inactive_principal",
          "not_found",
          "conflict",
          "last_organization_admin",
          "version_conflict",
          "invalid_reference",
          "oidc_provider_issuer_immutable",
          "oidc_provider_client_id_immutable",
          "oidc_provider_changed",
          "oidc_membership_required",
          "oidc_exchange_in_progress",
          "oidc_exchange_claim_invalid",
          "oidc_session_expired",
          "oidc_session_failed",
          "oidc_completed_token_unavailable",
          "oidc_authorization_failed",
          "oidc_provider_failed",
          "oidc_provider_secret_failed",
          "oidc_exchange_failed",
          "oidc_identity_failed",
          "oidc_token_failed",
          "oidc_persistence_failed",
          "internal_error"
        ]
      },
      "message": { "type": "string", "minLength": 1 },
      "retryable": { "type": "boolean" }
    },
    "http_status_by_code": {
      "invalid_argument": 400,
      "bad_request": 400,
      "unauthenticated": 401,
      "service_unauthenticated": 401,
      "caller_not_allowed": 403,
      "caller_context_required": 401,
      "caller_context_invalid": 401,
      "actor_mismatch": 403,
      "unsupported_media_type": 415,
      "identity_dependency_unavailable": 503,
      "forbidden": 403,
      "inactive_principal": 403,
      "not_found": 404,
      "conflict": 409,
      "last_organization_admin": 409,
      "version_conflict": 409,
      "invalid_reference": 400,
      "oidc_provider_issuer_immutable": 409,
      "oidc_provider_client_id_immutable": 409,
      "oidc_provider_changed": 409,
      "oidc_membership_required": 403,
      "oidc_exchange_in_progress": 409,
      "oidc_exchange_claim_invalid": 400,
      "oidc_session_failed": 400,
      "oidc_session_expired": 410,
      "oidc_completed_token_unavailable": 410,
      "oidc_authorization_failed": 400,
      "oidc_provider_failed": 500,
      "oidc_provider_secret_failed": 500,
      "oidc_exchange_failed": 500,
      "oidc_identity_failed": 500,
      "oidc_token_failed": 500,
      "oidc_persistence_failed": 500,
      "internal_error": 500
    }
  },
  "methods": {
    "resolve_owner_authorization": {
      "method": "POST",
      "path": "/resolve-owner-authorization",
      "request": {
        "required": ["user_id", "organization_id"],
        "properties": { "user_id": { "$ref": "#/definitions/id" }, "organization_id": { "$ref": "#/definitions/id" } }
      },
      "response": {
        "required": ["authorization"],
        "properties": {
          "authorization": {
            "type": "object", "additionalProperties": false,
            "required": ["user_id", "organization_id", "membership_id", "active", "last_revocation_sequence"],
            "properties": {
              "user_id": { "$ref": "#/definitions/id" }, "organization_id": { "$ref": "#/definitions/id" },
              "membership_id": { "$ref": "#/definitions/id" }, "active": { "type": "boolean" },
              "last_revocation_sequence": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "list_principal_revocations": {
      "method": "POST",
      "path": "/list-principal-revocations",
      "request": {
        "additionalProperties": false,
        "required": ["after_sequence", "limit"],
        "properties": {
          "after_sequence": { "type": "integer", "minimum": 0 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 500 }
        }
      },
      "response": {
        "required": ["events", "next_sequence"],
        "properties": {
          "events": { "type": "array", "maxItems": 500, "items": { "$ref": "#/definitions/principal_revocation" } },
          "next_sequence": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "create_organization": {
      "method": "POST",
      "path": "/create-organization",
      "request": {
        "required": [
          "request_id",
          "actor_principal_id",
          "slug",
          "name",
          "owner_email",
          "owner_display_name"
        ],
        "properties": {
          "request_id": { "$ref": "#/definitions/id" },
          "actor_principal_id": { "$ref": "#/definitions/id" },
          "slug": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "owner_email": { "type": "string", "format": "email" },
          "owner_display_name": { "type": "string", "minLength": 1 }
        }
      },
      "response": {
        "required": ["organization"],
        "properties": {
          "organization": { "$ref": "#/definitions/organization" }
        }
      }
    },
    "create_local_user": {
      "method": "POST",
      "path": "/create-local-user",
      "request": {
        "required": [
          "request_id",
          "actor_principal_id",
          "organization_id",
          "email",
          "display_name",
          "password",
          "role"
        ],
        "properties": {
          "request_id": { "$ref": "#/definitions/id" },
          "actor_principal_id": { "$ref": "#/definitions/id" },
          "organization_id": { "$ref": "#/definitions/id" },
          "email": { "type": "string", "format": "email" },
          "display_name": { "type": "string", "minLength": 1 },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 1024,
            "secret": true
          },
          "role": { "$ref": "#/definitions/organization_role" }
        }
      },
      "response": {
        "required": ["user", "membership"],
        "properties": {
          "user": { "$ref": "#/definitions/user" },
          "membership": { "$ref": "#/definitions/membership" }
        }
      }
    },
    "add_organization_membership": {
      "method": "POST",
      "path": "/add-organization-membership",
      "request": {
        "required": [
          "request_id",
          "actor_principal_id",
          "organization_id",
          "user_id",
          "email",
          "display_name",
          "role"
        ],
        "properties": {
          "request_id": { "$ref": "#/definitions/id" },
          "actor_principal_id": { "$ref": "#/definitions/id" },
          "organization_id": { "$ref": "#/definitions/id" },
          "user_id": { "$ref": "#/definitions/id" },
          "email": { "type": "string", "format": "email" },
          "display_name": { "type": "string", "minLength": 1 },
          "role": { "$ref": "#/definitions/organization_role" }
        }
      },
      "response": {
        "required": ["membership"],
        "properties": { "membership": { "$ref": "#/definitions/membership" } }
      }
    },
    "get_current_account": {
      "method": "POST",
      "path": "/get-current-account",
      "audience": "internal-service",
      "request": {
        "required": ["actor_principal_id", "organization_id"],
        "properties": {
          "actor_principal_id": { "$ref": "#/definitions/id" },
          "organization_id": { "$ref": "#/definitions/id" }
        }
      },
      "response": {
        "required": ["account"],
        "properties": {
          "account": { "$ref": "#/definitions/current_account" }
        }
      }
    },
    "change_local_password": {
      "method": "POST",
      "path": "/change-local-password",
      "request": {
        "required": [
          "request_id",
          "actor_principal_id",
          "user_id",
          "current_password",
          "new_password"
        ],
        "properties": {
          "request_id": { "$ref": "#/definitions/id" },
          "actor_principal_id": { "$ref": "#/definitions/id" },
          "user_id": { "$ref": "#/definitions/id" },
          "current_password": {
            "type": "string",
            "minLength": 1,
            "secret": true
          },
          "new_password": { "type": "string", "minLength": 12, "secret": true }
        }
      },
      "response": {
        "required": ["status"],
        "properties": { "status": { "type": "string", "const": "changed" } }
      }
    },
    "update_membership": {
      "method": "POST",
      "path": "/update-membership",
      "request": {
        "required": [
          "request_id",
          "actor_principal_id",
          "organization_id",
          "membership_id",
          "email",
          "display_name",
          "role",
          "active"
        ],
        "properties": {
          "request_id": { "$ref": "#/definitions/id" },
          "actor_principal_id": { "$ref": "#/definitions/id" },
          "organization_id": { "$ref": "#/definitions/id" },
          "membership_id": { "$ref": "#/definitions/id" },
          "email": { "type": "string", "format": "email" },
          "display_name": { "type": "string", "minLength": 1 },
          "role": { "$ref": "#/definitions/organization_role" },
          "active": { "type": "boolean" }
        }
      },
      "response": {
        "required": ["membership"],
        "properties": { "membership": { "$ref": "#/definitions/membership" } }
      }
    },
    "set_user_active": {
      "method": "POST",
      "path": "/set-user-active",
      "request": {
        "required": ["request_id", "actor_principal_id", "user_id", "active"],
        "properties": {
          "request_id": { "$ref": "#/definitions/id" },
          "actor_principal_id": { "$ref": "#/definitions/id" },
          "user_id": { "$ref": "#/definitions/id" },
          "active": { "type": "boolean" }
        }
      },
      "response": {
        "required": ["status"],
        "properties": { "status": { "type": "string", "const": "updated" } }
      }
    },
    "list_directory": {
      "method": "POST",
      "path": "/list-directory",
      "request": {
        "required": ["actor_principal_id", "organization_id"],
        "properties": {
          "actor_principal_id": { "$ref": "#/definitions/id" },
          "organization_id": { "$ref": "#/definitions/id" }
        }
      },
      "response": {
        "required": ["users", "groups"],
        "properties": {
          "users": {
            "type": "array",
            "items": { "$ref": "#/definitions/directory_member" }
          },
          "groups": {
            "type": "array",
            "items": { "$ref": "#/definitions/group" }
          }
        }
      }
    },
    "resolve_principal": {
      "method": "POST",
      "path": "/resolve-principal",
      "audience": "internal-service",
      "request": {
        "required": ["user_id", "organization_id"],
        "properties": {
          "user_id": { "$ref": "#/definitions/id" },
          "organization_id": { "$ref": "#/definitions/id" }
        }
      },
      "response": {
        "required": ["principal"],
        "properties": {
          "principal": { "$ref": "#/definitions/organization_principal_binding" }
        }
      }
    },
    "local_login": {
      "method": "POST",
      "path": "/local-login",
      "request": {
        "required": ["request_id", "organization_slug", "email", "password"],
        "properties": {
          "request_id": { "$ref": "#/definitions/id" },
          "organization_slug": { "type": "string", "minLength": 1 },
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "minLength": 1, "secret": true }
        }
      },
      "response": {
        "required": ["token_id", "access_token", "expires_at", "principal"],
        "properties": {
          "token_id": { "$ref": "#/definitions/id" },
          "access_token": { "type": "string", "minLength": 1, "secret": true },
          "expires_at": { "$ref": "#/definitions/timestamp" },
          "principal": { "$ref": "#/definitions/principal" }
        }
      }
    },
    "resolve_access_token": {
      "method": "POST",
      "path": "/resolve-access-token",
      "request": {
        "required": [
          "access_token",
          "profile"
        ],
        "properties": {
          "access_token": {
            "type": "string",
            "minLength": 1,
            "secret": true
          },
          "profile": {
            "type": "string",
            "enum": [
              "console",
              "workspace",
              "acp"
            ]
          },
          "agent_id": {
            "$ref": "#/definitions/id"
          }
        }
      },
      "response": {
        "required": [
          "principal",
          "caller_context"
        ],
        "properties": {
          "principal": {
            "$ref": "#/definitions/principal"
          },
          "caller_context": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "secret": true
          }
        }
      }
    },
    "revoke_access_token": {
      "method": "POST",
      "path": "/revoke-access-token",
      "request": {
        "required": ["access_token"],
        "properties": {
          "access_token": { "type": "string", "minLength": 1, "secret": true }
        }
      },
      "response": {
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["revoked", "already_invalid"]
          }
        }
      }
    },
    "issue_scim_token": {
      "method": "POST",
      "path": "/issue-scim-token",
      "request": {
        "required": [
          "request_id",
          "actor_principal_id",
          "organization_id",
          "name",
          "scopes"
        ],
        "properties": {
          "request_id": { "$ref": "#/definitions/id" },
          "actor_principal_id": { "$ref": "#/definitions/id" },
          "organization_id": { "$ref": "#/definitions/id" },
          "name": { "type": "string", "minLength": 1 },
          "scopes": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/definitions/scim_scope" }
          }
        }
      },
      "response": {
        "required": ["token", "credential"],
        "properties": {
          "token": { "$ref": "#/definitions/scim_token" },
          "credential": { "type": "string", "minLength": 1, "secret": true }
        }
      }
    },
    "revoke_scim_token": {
      "method": "POST",
      "path": "/revoke-scim-token",
      "request": {
        "required": ["actor_principal_id", "token_id"],
        "properties": {
          "actor_principal_id": { "$ref": "#/definitions/id" },
          "token_id": { "$ref": "#/definitions/id" }
        }
      },
      "response": {
        "required": ["status"],
        "properties": { "status": { "type": "string", "const": "revoked" } }
      }
    },
    "list_scim_tokens": {
      "method": "POST",
      "path": "/list-scim-tokens",
      "request": {
        "required": ["actor_principal_id", "organization_id"],
        "properties": {
          "actor_principal_id": { "$ref": "#/definitions/id" },
          "organization_id": { "$ref": "#/definitions/id" }
        }
      },
      "response": {
        "required": ["tokens"],
        "properties": {
          "tokens": {
            "type": "array",
            "items": { "$ref": "#/definitions/scim_token" }
          }
        }
      }
    },
    "upsert_oidc_provider": {
      "method": "POST",
      "path": "/upsert-oidc-provider",
      "lifecycle": "Provider identity is (organization_id, name). Issuer and Client ID are immutable; a replacement registration uses a new Provider name. Client-secret rotation is supported. Use set_oidc_provider_enabled to retire the old Provider; deletion is not supported.",
      "request": {
        "required": [
          "request_id",
          "actor_principal_id",
          "organization_id",
          "name",
          "issuer",
          "client_id",
          "scopes",
          "enabled"
        ],
        "properties": {
          "request_id": { "$ref": "#/definitions/id" },
          "actor_principal_id": { "$ref": "#/definitions/id" },
          "organization_id": { "$ref": "#/definitions/id" },
          "name": { "type": "string", "minLength": 1 },
          "issuer": { "type": "string", "format": "uri" },
          "client_id": { "type": "string", "minLength": 1 },
          "client_secret": { "type": "string", "secret": true },
          "scopes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "enabled": { "type": "boolean" }
        }
      },
      "response": {
        "required": ["provider"],
        "properties": { "provider": { "$ref": "#/definitions/oidc_provider" } }
      }
    },
    "set_oidc_provider_enabled": {
      "method": "POST",
      "path": "/set-oidc-provider-enabled",
      "lifecycle": "Changes only the local enabled state and never contacts the external Provider. Repeating the desired state is idempotent.",
      "request": {
        "required": [
          "request_id",
          "actor_principal_id",
          "organization_id",
          "name",
          "enabled"
        ],
        "properties": {
          "request_id": { "$ref": "#/definitions/id" },
          "actor_principal_id": { "$ref": "#/definitions/id" },
          "organization_id": { "$ref": "#/definitions/id" },
          "name": { "type": "string", "minLength": 1 },
          "enabled": { "type": "boolean" }
        }
      },
      "response": {
        "required": ["provider"],
        "properties": { "provider": { "$ref": "#/definitions/oidc_provider" } }
      }
    },
    "list_oidc_providers": {
      "method": "POST",
      "path": "/list-oidc-providers",
      "request": {
        "required": ["actor_principal_id", "organization_id"],
        "properties": {
          "actor_principal_id": { "$ref": "#/definitions/id" },
          "organization_id": { "$ref": "#/definitions/id" }
        }
      },
      "response": {
        "required": ["providers"],
        "properties": {
          "providers": {
            "type": "array",
            "items": { "$ref": "#/definitions/oidc_provider" }
          }
        }
      }
    },
    "list_login_methods": {
      "method": "POST",
      "path": "/list-login-methods",
      "request": {
        "required": ["organization_slug"],
        "properties": {
          "organization_slug": { "type": "string", "minLength": 1 }
        }
      },
      "response": {
        "required": ["methods"],
        "properties": {
          "methods": {
            "type": "array",
            "items": { "$ref": "#/definitions/login_method" }
          }
        }
      }
    },
    "start_oidc_login": {
      "method": "POST",
      "path": "/start-oidc-login",
      "request": {
        "required": ["request_id", "organization_slug", "provider_name"],
        "properties": {
          "request_id": { "$ref": "#/definitions/id" },
          "organization_slug": { "type": "string", "minLength": 1 },
          "provider_name": { "type": "string", "minLength": 1 }
        }
      },
      "response": {
        "required": ["authorization_url", "expires_at"],
        "properties": {
          "authorization_url": {
            "type": "string",
            "format": "uri",
            "contains_secret_query": ["state"]
          },
          "expires_at": { "$ref": "#/definitions/timestamp" }
        }
      }
    }
  },
  "protocols": {
    "jwks": {
      "method": "GET",
      "path": "/rpc/identity/jwks",
      "workload_authentication": "required",
      "caller_context": "none",
      "response_schema": "../platform/caller-context-jwks.schema.json"
    },
    "oidc_callback": {
      "method": "GET",
      "path": "/protocol/oidc/callback",
      "query": {
        "required": ["state"],
        "properties": {
          "state": { "type": "string", "minLength": 1, "secret": true },
          "code": { "type": "string", "minLength": 1, "secret": true },
          "error": { "type": "string", "minLength": 1 },
          "error_description": { "type": "string" },
          "error_uri": { "type": "string", "format": "uri" }
        },
        "oneOfRequired": [["code"], ["error"]]
      },
      "initial_response": {
        "required": ["principal", "token_id", "access_token", "expires_at"]
      },
      "replay_response": {
        "required": [
          "principal",
          "token_id",
          "expires_at",
          "already_completed"
        ],
        "forbidden": ["access_token"]
      }
    },
    "scim": {
      "base_path": "/scim/v2",
      "user_profile": {
        "required_schemas": ["urn:ietf:params:scim:schemas:core:2.0:User"],
        "required_attributes": ["userName"],
        "required_profile_fields": ["email"],
        "user_name_is_email": false,
        "filters": ["userName eq", "externalId eq", "emails.value eq"],
        "patch_paths": [
          "active",
          "userName",
          "displayName",
          "name.formatted",
          "externalId",
          "emails",
          "emails.value"
        ],
        "create_semantics": "POST is create-only and conflicts with an active resource ID or organization-scoped externalId",
        "delete_semantics": "hide SCIM membership and allow fresh reprovisioning on the same global User; create a new Membership and repoint durable OIDC identity while preserving audit facts"
      },
      "group_profile": {
        "required_schemas": ["urn:ietf:params:scim:schemas:core:2.0:Group"],
        "required_attributes": ["displayName"],
        "filters": ["displayName eq", "externalId eq"],
        "patch_paths": [
          "displayName",
          "externalId",
          "members",
          "members[value eq value]"
        ],
        "create_semantics": "POST is create-only and conflicts with an active resource ID or organization-scoped externalId"
      },
      "authority": "one logical directory authority per organization; bearer tokens are rotating credentials",
      "unsupported": ["bulk", "sort", "etag", "changePassword"]
    }
  }
}
