{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.antnest.dev/agent-controller/execution-credentials.ids-v2.schema.json",
  "title": "Execution credential resolution",
  "description": "Exact-scope Provider secret resolution for the authenticated agent-acp-service workload; see agent-acp/execution-api.md.",
  "$ref": "#/$defs/request",
  "$defs": {
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "request": {
      "type": "object",
      "properties": {
        "organization_id": {
          "$ref": "../common/ids.schema.json#/$defs/organizationId"
        },
        "connection_id": {
          "$ref": "#/$defs/identity"
        },
        "credential_version": {
          "$ref": "#/$defs/identity"
        }
      },
      "required": [
        "organization_id",
        "connection_id",
        "credential_version"
      ],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "organization_id": {
          "$ref": "../common/ids.schema.json#/$defs/organizationId"
        },
        "connection_id": {
          "$ref": "#/$defs/identity"
        },
        "credential_version": {
          "$ref": "#/$defs/identity"
        },
        "method": {
          "type": "string",
          "const": "api_key"
        },
        "secret": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "organization_id",
        "connection_id",
        "credential_version",
        "method",
        "secret"
      ],
      "additionalProperties": false
    }
  }
}
