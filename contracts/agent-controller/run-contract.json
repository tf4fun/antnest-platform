    "finish_run": {
      "method": "POST",
      "path": "/finish-run",
      "success_status": 200,
      "request_content_type": "application/json",
      "response_content_type": "application/json",
      "request": {
        "type": "object",
        "required": [
          "request_id",
          "admission_id",
          "terminal_class",
          "tool_effect_state",
          "unknown_effect_source",
          "stop_reason",
          "error_class"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1
          },
          "admission_id": {
            "type": "string",
            "minLength": 1
          },
          "terminal_class": {
            "enum": ["completed", "cancelled", "failed", "unresolved"]
          },
          "tool_effect_state": {
            "enum": ["none", "settled", "unknown"]
          },
          "unknown_effect_source": {
            "type": ["string", "null"],
            "enum": ["runtime_mcp", "client_mcp", "unclassified", null]
          },
          "stop_reason": {
            "type": ["string", "null"],
            "enum": [
              "end_turn",
              "max_tokens",
              "max_turn_requests",
              "refusal",
              null
            ]
          },
          "error_class": {
            "type": ["string", "null"],
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          }
        },
        "additionalProperties": false,
        "oneOf": [
          {
            "properties": {
              "terminal_class": {
                "const": "completed"
              },
              "tool_effect_state": {
                "enum": ["none", "settled"]
              },
              "unknown_effect_source": {
                "const": null
              },
              "stop_reason": {
                "enum": [
                  "end_turn",
                  "max_tokens",
                  "max_turn_requests",
                  "refusal"
                ]
              },
              "error_class": {
                "const": null
              }
            }
          },
          {
            "properties": {
              "terminal_class": {
                "const": "cancelled"
              },
              "tool_effect_state": {
                "enum": ["none", "settled"]
              },
              "unknown_effect_source": {
                "const": null
              },
              "stop_reason": {
                "const": null
              },
              "error_class": {
                "const": null
              }
            }
          },
          {
            "properties": {
              "terminal_class": {
                "const": "failed"
              },
              "tool_effect_state": {
                "enum": ["none", "settled"]
              },
              "unknown_effect_source": {
                "const": null
              },
              "stop_reason": {
                "const": null
              },
              "error_class": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "properties": {
              "terminal_class": {
                "const": "unresolved"
              },
              "tool_effect_state": {
                "const": "unknown"
              },
              "unknown_effect_source": {
                "enum": ["runtime_mcp", "client_mcp", "unclassified"]
              },
              "stop_reason": {
                "const": null
              },
              "error_class": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      },
      "response": {
        "type": "object",
        "required": ["status", "admission_state"],
        "properties": {
          "status": {
            "enum": ["finished", "already_finished"]
          },
          "admission_state": {
            "enum": ["released", "blocked_unknown_effect"]
          }
        },
        "additionalProperties": false
      }
    },
