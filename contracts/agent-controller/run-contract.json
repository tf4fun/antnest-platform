{
  "contract": "antnest.agent-controller.run-admission",
  "revision": 13,
  "transport": "json-over-http",
  "trust": "internal-network",
  "schema_dialect": "https://json-schema.org/draft/2020-12/schema",
  "base_path": "/rpc/agent-controller",
  "status": {
    "method": "GET",
    "path": "/status",
    "success_status": 200,
    "response_content_type": "application/json",
    "response": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "const": "ready"
        }
      },
      "additionalProperties": false
    }
  },
  "error": {
    "type": "object",
    "response_content_type": "application/json",
    "status_by_code": {
      "access_denied": 403,
      "agent_not_found": 404,
      "agent_busy": 409,
      "agent_rebuilding": 409,
      "agent_build_failed": 409,
      "agent_not_ready": 409,
      "admission_not_found": 404,
      "credential_not_allowed": 403,
      "invalid_request": 400,
      "dependency_unavailable": 503,
      "internal_error": 500,
      "model_unavailable": 409,
      "configuration_conflict": 409
    },
    "retryable_by_code": {
      "access_denied": false,
      "agent_not_found": false,
      "agent_busy": true,
      "agent_rebuilding": true,
      "agent_build_failed": false,
      "agent_not_ready": true,
      "admission_not_found": false,
      "credential_not_allowed": false,
      "invalid_request": false,
      "dependency_unavailable": true,
      "internal_error": true,
      "model_unavailable": false,
      "configuration_conflict": false
    },
    "required": ["code", "message", "retryable"],
    "properties": {
      "code": {
        "enum": [
          "access_denied",
          "agent_not_found",
          "agent_busy",
          "agent_rebuilding",
          "agent_build_failed",
          "agent_not_ready",
          "admission_not_found",
          "credential_not_allowed",
          "invalid_request",
          "dependency_unavailable",
          "internal_error",
          "model_unavailable",
          "configuration_conflict"
        ]
      },
      "message": {
        "type": "string",
        "minLength": 1
      },
      "retryable": {
        "type": "boolean"
      }
    },
    "additionalProperties": false
  },
  "methods": {
    "list_workspace_agents": {
      "method": "POST",
      "path": "/list-workspace-agents",
      "success_status": 200,
      "request_content_type": "application/json",
      "response_content_type": "application/json",
      "request": {
        "type": "object",
        "required": ["request_id", "organization_id", "principal_id"],
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1
          },
          "organization_id": {
            "type": "string",
            "minLength": 1
          },
          "principal_id": {
            "type": "string",
            "minLength": 1
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "additionalProperties": false
      },
      "response": {
        "type": "object",
        "required": ["agents", "next_cursor"],
        "properties": {
          "agents": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "agent_id",
                "name",
                "availability",
                "agent_access_subject"
              ],
              "properties": {
                "agent_id": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "availability": {
                  "enum": ["ready", "busy", "offline"]
                },
                "agent_access_subject": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "next_cursor": {
            "type": ["string", "null"],
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "additionalProperties": false
      }
    },
