              "image": {
                "type": "boolean"
              },
              "embedded_context": {
                "type": "boolean"
              },
              "audio": {
                "type": "boolean",
                "default": false
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "acquire_run": {
      "method": "POST",
      "path": "/acquire-run",
      "success_status": 200,
      "request_content_type": "application/json",
      "response_content_type": "application/json",
      "request": {
        "type": "object",
        "required": [
          "request_id",
          "agent_id",
          "principal_id",
          "expected_access_revision",
          "session_id"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1
          },
          "agent_id": {
            "type": "string",
            "minLength": 1
          },
          "principal_id": {
            "type": "string",
            "minLength": 1
          },
          "expected_access_revision": {
            "type": "string",
            "minLength": 1
          },
          "session_id": {
            "type": "string",
            "minLength": 1
          },
          "session_configuration": {
            "type": ["object", "null"],
            "required": [],
            "properties": {
              "model_profile_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200,
                    "pattern": "^[a-zA-Z0-9_./:-]{1,200}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "authorization_mode": {
                "anyOf": [
                  {
                    "enum": ["auto", "approve", "smart_approve", "chat"]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "tool_rules": {
                "anyOf": [
                  {
                    "type": "array",
                    "maxItems": 128,
                    "items": {
                      "type": "object",
                      "required": [
                        "source",
                        "source_id",
                        "tool_name",
                        "decision"
                      ],
                      "properties": {
                        "source": {
                          "enum": ["runtime", "agent"]
                        },
                        "source_id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200,
                          "pattern": "^[a-zA-Z0-9_./:-]{1,200}$"
                        },
                        "tool_name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200,
                          "pattern": "^[a-zA-Z0-9_./:-]{1,200}$"
                        },
                        "decision": {
                          "enum": ["allow", "deny"]
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "response": {
        "type": "object",
        "required": [
          "admission_id",
          "admission_deadline",
          "agent_spec_revision",
          "execution_revision",
          "runtime_mcp_source_digest",
          "agent_execution_spec_digest",
          "runtime",
          "execution_spec"
        ],
        "properties": {
          "admission_id": {
            "type": "string",
            "minLength": 1
          },
          "admission_deadline": {
            "type": "string",
            "format": "date-time"
          },
          "agent_spec_revision": {
            "type": "string",
            "minLength": 1
          },
          "execution_revision": {
            "type": "string",
            "minLength": 1
          },
          "runtime_mcp_source_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "agent_execution_spec_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "runtime": {
            "type": "object",
            "required": [
              "runtime_revision",
              "runtime_execution_id",
              "mcp_endpoint"
            ],
            "properties": {
              "runtime_revision": {
                "type": "string",
                "minLength": 1
              },
              "runtime_execution_id": {
                "type": "string",
                "minLength": 1
              },
              "mcp_endpoint": {
                "type": "string",
                "format": "uri"
              }
            },
            "additionalProperties": false
          },
          "execution_spec": {
            "type": "object",
            "required": [
              "system_prompt",
              "context_policy_version",
              "skill_instructions",
              "model",
              "max_model_requests",
              "provider"
            ],
            "properties": {
              "system_prompt": {
                "type": "string"
              },
              "context_policy_version": {
                "const": "context-v1"
              },
              "skill_instructions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["skill_key", "version", "instructions"],
                  "properties": {
                    "skill_key": {
                      "type": "string",
                      "minLength": 1
                    },
                    "version": {
                      "type": "string",
                      "minLength": 1
                    },
                    "instructions": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "model": {
                "type": "object",
                "required": [
                  "base_url",
                  "model",
                  "context_window",
                  "max_output_tokens",
                  "supports_images"
                ],
                "properties": {
                  "base_url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "model": {
                    "type": "string",
                    "minLength": 1
                  },
                  "context_window": {
                    "type": "integer",
                    "minimum": 1024
                  },
                  "max_output_tokens": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "temperature": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 2
                  },
                  "supports_images": {
                    "type": "boolean"
                  },
                  "supports_audio": {
                    "type": "boolean",
                    "default": false
                  },
                  "supports_pdf": {
                    "type": "boolean",
                    "default": false
                  },
                  "pricing": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "currency",
                      "input_per_million",
                      "output_per_million"
                    ],
                    "properties": {
                      "currency": {
                        "const": "USD"
                      },
                      "input_per_million": {
                        "type": "number",
                        "minimum": 0
                      },
                      "output_per_million": {
                        "type": "number",
                        "minimum": 0
                      },
                      "cache_read_per_million": {
                        "type": "number",
                        "minimum": 0
                      },
                      "cache_write_per_million": {
                        "type": "number",
                        "minimum": 0
                      }
                    }
                  }
                },
                "additionalProperties": false
              },
              "max_model_requests": {
                "type": "integer",
                "minimum": 1,
                "maximum": 128
              },
              "configuration": {
                "type": "object",
                "required": [
                  "model_profile_id",
                  "model_profile_revision_id",
                  "authorization",
                  "authorization_revision",
                  "digest"
                ],
                "properties": {
                  "model_profile_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "model_profile_revision_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "authorization": {
                    "type": "object",
                    "required": ["mode", "tool_rules"],
                    "properties": {
                      "mode": {
                        "enum": ["auto", "approve", "smart_approve", "chat"]
                      },
                      "tool_rules": {
                        "type": "array",
                        "maxItems": 256,
                        "items": {
                          "type": "object",
                          "required": [
                            "source",
                            "source_id",
                            "tool_name",
                            "decision"
                          ],
                          "properties": {
                            "source": {
                              "enum": ["runtime", "agent"]
                            },
                            "source_id": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 200,
                              "pattern": "^[a-zA-Z0-9_./:-]{1,200}$"
                            },
                            "tool_name": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 200,
                              "pattern": "^[a-zA-Z0-9_./:-]{1,200}$"
                            },
                            "decision": {
                              "enum": ["allow", "deny"]
                            }
                          },
                          "additionalProperties": false
                        }
                      }
                    },
                    "additionalProperties": false
                  },
                  "authorization_revision": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "additionalProperties": false
              },
              "provider": {
                "type": "object",
                "required": [
                  "connection_id",
                  "provider_key",
                  "credential_method",
                  "request_protocol"
                ],
                "properties": {
                  "connection_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "provider_key": {
                    "const": "deepseek"
                  },
                  "credential_method": {
                    "const": "api_key"
                  },
                  "request_protocol": {
                    "const": "openai_chat_completions"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "resolve_credential": {
      "method": "POST",
      "path": "/resolve-credential",
