{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antnest.local/contracts/agent-controller/model-call-policy.schema.json",
  "title": "Planned model call policy",
  "description": "Planned shared contract. Services are not wired to this policy; this schema does not declare an active route.",
  "$ref": "#/$defs/policy",
  "$defs": {
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "model_retry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max", "base_ms", "cap_ms"],
      "properties": {
        "max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "base_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        },
        "cap_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        }
      }
    },
    "run_budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_input_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_cost_usd_micros": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "period_caps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "soft_cost_usd_micros": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "hard_cost_usd_micros": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "organization_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "unknown_cost", "run_caps", "daily", "monthly"],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unknown_cost": {
          "enum": ["allow", "deny"]
        },
        "run_caps": {
          "$ref": "#/$defs/run_budget"
        },
        "daily": {
          "$ref": "#/$defs/period_caps"
        },
        "monthly": {
          "$ref": "#/$defs/period_caps"
        }
      }
    },
    "template_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model_retry": {
          "$ref": "#/$defs/model_retry"
        },
        "failover": {
          "enum": ["never", "before_output"]
        },
        "run_budget": {
          "$ref": "#/$defs/run_budget"
        }
      }
    },
    "policy_query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization_id"],
      "properties": {
        "organization_id": {
          "$ref": "#/$defs/identity"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organization_id",
        "revision",
        "unknown_cost",
        "run_caps",
        "daily",
        "monthly"
      ],
      "properties": {
        "organization_id": {
          "$ref": "#/$defs/identity"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unknown_cost": {
          "enum": ["allow", "deny"]
        },
        "run_caps": {
          "$ref": "#/$defs/run_budget"
        },
        "daily": {
          "$ref": "#/$defs/period_caps"
        },
        "monthly": {
          "$ref": "#/$defs/period_caps"
        }
      }
    },
    "policy_update_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "organization_id",
        "actor_principal_id",
        "expected_revision",
        "unknown_cost",
        "run_caps",
        "daily",
        "monthly"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/identity"
        },
        "organization_id": {
          "$ref": "#/$defs/identity"
        },
        "actor_principal_id": {
          "$ref": "#/$defs/identity"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unknown_cost": {
          "enum": ["allow", "deny"]
        },
        "run_caps": {
          "$ref": "#/$defs/run_budget"
        },
        "daily": {
          "$ref": "#/$defs/period_caps"
        },
        "monthly": {
          "$ref": "#/$defs/period_caps"
        }
      }
    }
  }
}
