{
  "contract": "antnest.agent-controller.lifecycle",
  "revision": 30,
  "transport": "json-over-http",
  "trust": "internal-network",
  "media_types": {
    "request": "application/json",
    "response": "application/json"
  },
  "schemas": {
    "messages": "control-api.schema.json"
  },
  "status": {
    "method": "GET",
    "path": "/status",
    "success_status": 200
  },
  "resources": {
    "execution_synchronization": {
      "get": {
        "method": "GET",
        "path": "/internal/execution-synchronization",
        "query": ["organization_id"],
        "success_status": 200,
        "response": "control-api.schema.json#/$defs/execution_synchronization"
      }
    },
    "provider_connections": {
      "resolve_access": {
        "method": "GET",
        "path": "/internal/provider-connections/{connection_id}/access",
        "query": ["organization_id"],
        "success_status": 200,
        "response": "control-api.schema.json#/$defs/provider_access"
      },
      "availability": {
        "method": "PUT",
        "path": "/internal/provider-connections/{connection_id}/availability",
        "request": "control-api.schema.json#/$defs/catalog_availability_request",
        "success_status": 200,
        "response": "control-api.schema.json#/$defs/catalog_availability"
      },
      "create": {
        "method": "POST",
        "path": "/internal/provider-connections",
        "request": "control-api.schema.json#/$defs/create_provider_connection_request",
        "success_status": 201,
        "response": "control-api.schema.json#/$defs/provider_connection"
      },
      "rotate_credential": {
        "method": "POST",
        "path": "/internal/provider-connections/{connection_id}/credentials",
        "request": "control-api.schema.json#/$defs/rotate_provider_credential_request",
        "success_status": 201,
        "response": "control-api.schema.json#/$defs/provider_connection"
      },
      "get": {
        "method": "GET",
        "path": "/internal/provider-connections/{connection_id}",
        "query": ["organization_id"],
        "success_status": 200,
        "response": "control-api.schema.json#/$defs/provider_connection"
      },
      "list": {
        "method": "GET",
        "path": "/internal/provider-connections",
        "query": ["organization_id", "after_id", "limit"],
        "success_status": 200,
        "response": "control-api.schema.json#/$defs/provider_connection_list"
      }
    },
    "agent_network_policy": {
      "get": {
        "method": "GET",
        "path": "/internal/agents/{agent_id}/network-policy",
        "query": ["organization_id"],
        "success_status": 200,
        "response": "control-api.schema.json#/$defs/agent_network_policy"
      },
      "set": {
        "method": "PUT",
        "path": "/internal/agents/{agent_id}/network-policy",
        "success_status": 200,
        "request": "control-api.schema.json#/$defs/set_agent_network_policy_request",
        "response": "control-api.schema.json#/$defs/network_policy_assignment"
      }
    },
    "model_profiles": {
      "availability": {
        "method": "PUT",
        "path": "/internal/model-profiles/{model_profile_id}/availability",
        "request": "control-api.schema.json#/$defs/catalog_availability_request",
        "success_status": 200,
        "response": "control-api.schema.json#/$defs/catalog_availability"
      },
      "create": {
        "method": "POST",
        "path": "/internal/model-profiles",
        "request": "control-api.schema.json#/$defs/create_model_profile_request",
        "success_status": 201,
        "response": "control-api.schema.json#/$defs/model_profile"
      },
      "revise": {
        "method": "POST",
        "path": "/internal/model-profiles/{model_profile_id}/revisions",
        "request": "control-api.schema.json#/$defs/revise_model_profile_request",
        "success_status": 201,
        "response": "control-api.schema.json#/$defs/model_profile"
      },
      "get": {
        "method": "GET",
        "path": "/internal/model-profiles/{model_profile_id}",
        "query": ["organization_id"],
        "success_status": 200,
        "response": "control-api.schema.json#/$defs/model_profile"
      },
      "list": {
        "method": "GET",
        "path": "/internal/model-profiles",
        "query": ["organization_id", "after_id", "limit"],
        "success_status": 200,
        "response": "control-api.schema.json#/$defs/model_profile_list"
      }
    },
    "agent_templates": {
      "availability": {
        "method": "PUT",
        "path": "/internal/agent-templates/{template_id}/availability",
        "request": "control-api.schema.json#/$defs/catalog_availability_request",
        "success_status": 200,
        "response": "control-api.schema.json#/$defs/catalog_availability"
      },
      "create": {
        "method": "POST",
        "path": "/internal/agent-templates",
        "request": "control-api.schema.json#/$defs/create_template_request",
        "success_status": 201,
        "response": "control-api.schema.json#/$defs/agent_template"
      },
      "revise": {
        "method": "POST",
        "path": "/internal/agent-templates/{template_id}/revisions",
        "request": "control-api.schema.json#/$defs/revise_template_request",
        "success_status": 201,
        "response": "control-api.schema.json#/$defs/agent_template"
      },
      "get": {
        "method": "GET",
        "path": "/internal/agent-templates/{template_id}",
        "query": ["organization_id"],
        "success_status": 200,
        "response": "control-api.schema.json#/$defs/agent_template"
      },
      "get_revision": {
        "method": "GET",
        "path": "/internal/agent-templates/{template_id}/revisions/{revision}",
        "query": ["organization_id"],
        "success_status": 200,
        "response": "control-api.schema.json#/$defs/agent_template"
      },
      "list": {
        "method": "GET",
        "path": "/internal/agent-templates",
        "query": ["organization_id", "after_id", "limit"],
        "success_status": 200,
        "response": "control-api.schema.json#/$defs/agent_template_list"
      }
    },
    "agents": {
      "create": {
        "method": "POST",
        "path": "/internal/agents",
        "request": "control-api.schema.json#/$defs/create_agent_request",
        "success_status": 202,
        "response": "control-api.schema.json#/$defs/create_agent_response"
      },
      "get": {
        "method": "GET",
        "path": "/internal/agents/{agent_id}",
        "query": ["organization_id"],
        "success_status": 200,
        "response": "control-api.schema.json#/$defs/agent"
      },
      "list": {
        "method": "GET",
        "path": "/internal/agents",
        "query": [
          "organization_id",
          "owner_user_id",
          "lifecycle_state",
          "activation_state",
          "runtime_state",
          "include_deleted",
          "limit",
          "cursor"
        ],
        "success_status": 200,
        "response": "control-api.schema.json#/$defs/agent_list"
      },
      "rebuild": {
        "method": "POST",
        "path": "/internal/agents/{agent_id}/rebuild",
        "request": "control-api.schema.json#/$defs/rebuild_agent_request",
        "success_status": 202,
        "response": "control-api.schema.json#/$defs/operation"
      },
      "disable": {
        "method": "POST",
        "path": "/internal/agents/{agent_id}/disable",
        "request": "control-api.schema.json#/$defs/lifecycle_request",
        "success_status": 202,
        "response": "control-api.schema.json#/$defs/operation"
      },
      "enable": {
        "method": "POST",
        "path": "/internal/agents/{agent_id}/enable",
        "request": "control-api.schema.json#/$defs/lifecycle_request",
        "success_status": 202,
        "response": "control-api.schema.json#/$defs/operation"
      },
      "delete": {
        "method": "POST",
        "path": "/internal/agents/{agent_id}/delete",
        "request": "control-api.schema.json#/$defs/lifecycle_request",
        "success_status": 202,
        "response": "control-api.schema.json#/$defs/operation"
      }
    },
    "operations": {
      "get": {
        "method": "GET",
        "path": "/internal/agent-operations/{request_id}",
        "query": ["organization_id"],
        "success_status": 200,
        "response": "control-api.schema.json#/$defs/operation"
      }
    },
    "events": {
      "list_global": {
        "method": "GET",
        "path": "/internal/agent-events",
        "query": ["organization_id", "after_sequence", "limit"],
        "success_status": 200,
        "response": "control-api.schema.json#/$defs/event_list"
      },
      "watch_global": {
        "method": "GET",
        "path": "/internal/agent-events/watch",
        "query": ["organization_id", "after_sequence"],
        "headers": ["Last-Event-ID"],
        "success_status": 200,
        "content_type": "text/event-stream",
        "event": "agent_event",
        "event_id": "global_sequence",
        "data": "control-api.schema.json#/$defs/agent_event"
      },
      "list": {
        "method": "GET",
        "path": "/internal/agents/{agent_id}/events",
        "query": ["organization_id", "after_sequence", "limit"],
        "success_status": 200,
        "response": "control-api.schema.json#/$defs/event_list"
      },
      "watch": {
        "method": "GET",
        "path": "/internal/agents/{agent_id}/events/watch",
        "query": ["organization_id", "after_sequence"],
        "headers": ["Last-Event-ID"],
        "success_status": 200,
        "content_type": "text/event-stream",
        "event": "agent_event",
        "event_id": "global_sequence",
        "data": "control-api.schema.json#/$defs/agent_event"
      }
    },
    "agent_authorization": {
      "set": {
        "method": "POST",
        "path": "/rpc/agent-controller/set-agent-authorization",
        "request": "control-api.schema.json#/$defs/set_agent_authorization_request",
        "success_status": 200,
        "response": "control-api.schema.json#/$defs/set_agent_authorization_response"
      }
    },
    "workspace_agents": {
      "list": {
        "method": "POST",
        "path": "/rpc/agent-controller/list-workspace-agents",
        "request": "control-api.schema.json#/$defs/list_workspace_agents_request",
        "success_status": 200,
        "response": "control-api.schema.json#/$defs/list_workspace_agents_response"
      }
    }
  },
  "enums": {
    "desired_state": ["enabled", "disabled", "deleted"],
    "lifecycle_state": ["not_created", "created", "deleted"],
    "activation_state": ["enabled", "disabled"],
    "runtime_state": [
      "waiting",
      "available",
      "unhealthy",
      "exited",
      "absent",
      "unknown"
    ],
    "operation_kind": ["create", "rebuild", "disable", "enable", "delete"],
    "operation_state": ["running", "completed", "failed"],
    "event_type": [
      "agent_create_requested",
      "agent_created",
      "agent_ready",
      "agent_rebuild_requested",
      "agent_rebuilt",
      "agent_disable_requested",
      "agent_disabled",
      "agent_disable_failed",
      "agent_enable_requested",
      "agent_enabled",
      "agent_enable_failed",
      "agent_delete_requested",
      "agent_deleted",
      "agent_lifecycle_quarantined",
      "agent_runtime_restarted",
      "agent_runtime_missing",
      "agent_runtime_condition_changed",
      "agent_owner_revoked",
      "agent_authorization_updated",
      "agent_build_failed"
    ]
  },
  "errors": {
    "shape": ["code", "message", "retryable"],
    "response": "control-api.schema.json#/$defs/error",
    "status_by_code": {
      "resource_version_conflict": 409,
      "policy_revision_not_found": 404,
      "agent_network_not_found": 404,
      "agent_network_unavailable": 409,
      "cleanup_failed": 503,
      "dependency_invalid_response": 502,
      "invalid_request": 400,
      "runtime_image_invalid": 400,
      "request_id_conflict": 409,
      "reference_not_found": 404,
      "reference_disabled": 409,
      "resource_in_use": 409,
      "execution_configuration_capacity_exceeded": 409,
      "agent_not_found": 404,
      "agent_not_ready": 409,
      "lifecycle_conflict": 409,
      "operation_not_found": 404,
      "dependency_unavailable": 503,
      "lifecycle_timeout": 504,
      "internal_error": 500,
      "access_denied": 403,
      "configuration_conflict": 409
    },
    "retryable_by_code": {
      "resource_version_conflict": false,
      "policy_revision_not_found": false,
      "agent_network_not_found": false,
      "agent_network_unavailable": false,
      "cleanup_failed": true,
      "dependency_invalid_response": true,
      "invalid_request": false,
      "runtime_image_invalid": false,
      "request_id_conflict": false,
      "reference_not_found": false,
      "reference_disabled": false,
      "resource_in_use": false,
      "execution_configuration_capacity_exceeded": false,
      "agent_not_found": false,
      "agent_not_ready": true,
      "lifecycle_conflict": false,
      "operation_not_found": false,
      "dependency_unavailable": true,
      "lifecycle_timeout": true,
      "internal_error": true,
      "access_denied": false,
      "configuration_conflict": false
    }
  },
  "compatibility": {
    "unknown_request_fields": "rejected",
    "unknown_response_fields": "clients_may_ignore",
    "secrets_in_logs_traces_events": false,
    "cross_service_database_access": false
  }
}
