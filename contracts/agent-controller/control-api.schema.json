{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antnest.local/agent-controller/control-api.schema.json",
  "title": "Antnest Agent Controller lifecycle messages",
  "$defs": {
    "agent_skill_preparation_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "agent_id",
        "kind",
        "state",
        "progress",
        "updated_at"
      ],
      "properties": {
        "request_id": { "type": "string", "minLength": 1 },
        "agent_id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["create", "rebuild", "enable"] },
        "state": {
          "enum": [
            "preparing",
            "queued",
            "retry_wait",
            "paused",
            "ready",
            "rejected",
            "invalidated",
            "cleanup_pending",
            "abandoned",
            "released"
          ]
        },
        "progress": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "verified_packages",
            "verified_bytes",
            "total_packages",
            "total_bytes"
          ],
          "properties": {
            "verified_packages": { "type": "integer", "minimum": 0 },
            "verified_bytes": { "type": "integer", "minimum": 0 },
            "total_packages": { "type": "integer", "minimum": 0 },
            "total_bytes": { "type": "integer", "minimum": 0 }
          }
        },
        "retry_after": { "type": "string", "format": "date-time" },
        "error_code": { "type": "string" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "skill_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill_id", "version"],
      "properties": {
        "skill_id": { "type": "string", "pattern": "^skill_[0-9a-f]{32}$" },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "frozen_skill_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill_id",
        "version",
        "name",
        "description",
        "artifact_digest",
        "content_digest",
        "artifact_size",
        "unpacked_size",
        "package_rules_version"
      ],
      "properties": {
        "skill_id": { "type": "string", "pattern": "^skill_[0-9a-f]{32}$" },
        "version": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "description": { "type": "string", "minLength": 1, "maxLength": 512 },
        "artifact_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "content_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "artifact_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        },
        "unpacked_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 33554432
        },
        "package_rules_version": { "const": 1 }
      }
    },
    "discover_provider_models_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization_id"],
      "properties": {
        "organization_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "discover_draft_provider_models_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization_id", "provider_key", "base_url", "credential"],
      "properties": {
        "organization_id": {
          "$ref": "#/$defs/id"
        },
        "provider_key": {
          "enum": ["deepseek", "openrouter", "openai_compatible"]
        },
        "base_url": {
          "type": "string",
          "minLength": 1
        },
        "credential": {
          "$ref": "#/$defs/provider_credential_input"
        }
      }
    },
    "provider_discovery_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["models"],
      "properties": {
        "models": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/discovered_model"
          }
        }
      }
    },
    "discovered_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "display_name"],
      "properties": {
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "context_window": {
          "type": "integer",
          "minimum": 1
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "supports_images": {
          "type": "boolean"
        },
        "pricing": {
          "$ref": "#/$defs/discovered_pricing"
        }
      }
    },
    "discovered_pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "input_per_million", "output_per_million"],
      "properties": {
        "currency": {
          "const": "USD"
        },
        "input_per_million": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "output_per_million": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "cache_read_per_million": {
          "type": "number",
          "minimum": 0
        },
        "cache_write_per_million": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "execution_synchronization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization_id", "synchronization"],
      "properties": {
        "organization_id": {
          "$ref": "#/$defs/id"
        },
        "synchronization": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/execution_synchronization_record"
            }
          ]
        }
      }
    },
    "execution_synchronization_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "applied_revision", "updated_at", "applied_at"],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "applied_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        },
        "applied_at": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/timestamp"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "applied_revision": {
                "const": 0
              }
            }
          },
          "then": {
            "properties": {
              "applied_at": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "applied_at": {
                "$ref": "#/$defs/timestamp"
              }
            }
          }
        }
      ],
      "description": "Persisted configuration synchronization, not live execution state. The application additionally enforces applied_revision <= revision."
    },
    "model_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "context_window",
        "max_output_tokens",
        "supports_images"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "context_window": {
          "type": "integer",
          "minimum": 1024
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "supports_images": {
          "type": "boolean"
        },
        "supports_audio": {
          "type": "boolean",
          "default": false
        },
        "supports_pdf": {
          "type": "boolean",
          "default": false
        },
        "pricing": {
          "$ref": "#/$defs/model_pricing"
        }
      }
    },
    "provider_credential_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "api_key"],
      "properties": {
        "method": {
          "const": "api_key"
        },
        "api_key": {
          "type": "string",
          "minLength": 1,
          "writeOnly": true
        }
      }
    },
    "model_display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "provider_model_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_key", "display_name", "model"],
      "properties": {
        "profile_key": {
          "$ref": "#/$defs/id"
        },
        "display_name": {
          "$ref": "#/$defs/model_display_name"
        },
        "model": {
          "$ref": "#/$defs/model_parameters"
        }
      }
    },
    "create_provider_connection_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "organization_id",
        "provider_key",
        "display_name",
        "base_url",
        "credential",
        "models"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/id"
        },
        "organization_id": {
          "$ref": "#/$defs/id"
        },
        "provider_key": {
          "enum": ["deepseek", "openrouter"]
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "base_url": {
          "type": "string",
          "format": "uri"
        },
        "credential": {
          "$ref": "#/$defs/provider_credential_input"
        },
        "models": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/provider_model_input"
          }
        }
      }
    },
    "rotate_provider_credential_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "organization_id",
        "expected_version",
        "credential"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/id"
        },
        "organization_id": {
          "$ref": "#/$defs/id"
        },
        "expected_version": {
          "$ref": "#/$defs/id"
        },
        "credential": {
          "$ref": "#/$defs/provider_credential_input"
        }
      }
    },
    "provider_connection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connection_id",
        "organization_id",
        "provider_key",
        "display_name",
        "base_url",
        "credential_method",
        "credential_version",
        "credential_revision",
        "enabled",
        "created_at",
        "updated_at",
        "request_protocol"
      ],
      "properties": {
        "connection_id": {
          "$ref": "#/$defs/id"
        },
        "organization_id": {
          "$ref": "#/$defs/id"
        },
        "provider_key": {
          "enum": ["deepseek", "openrouter"]
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "base_url": {
          "type": "string",
          "format": "uri"
        },
        "credential_method": {
          "const": "api_key"
        },
        "credential_version": {
          "$ref": "#/$defs/id"
        },
        "credential_revision": {
          "type": "integer",
          "minimum": 1
        },
        "enabled": {
          "type": "boolean"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        },
        "request_protocol": {
          "const": "openai_chat_completions"
        }
      }
    },
    "provider_connection_list": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/provider_connection"
          }
        },
        "next_after_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "network_policy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[!-~]+$"
    },
    "network_policy_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "action"],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "action": {
          "enum": ["allow_all", "deny_all"]
        }
      }
    },
    "set_agent_network_policy_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "organization_id",
        "actor_principal_id",
        "policy_id",
        "revision",
        "expected_resource_version"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/id"
        },
        "organization_id": {
          "$ref": "#/$defs/id"
        },
        "actor_principal_id": {
          "$ref": "#/$defs/id"
        },
        "policy_id": {
          "$ref": "#/$defs/network_policy_id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "expected_resource_version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "network_policy_assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "policy_id", "revision", "resource_version"],
      "properties": {
        "agent_id": {
          "$ref": "#/$defs/id"
        },
        "policy_id": {
          "$ref": "#/$defs/network_policy_id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "resource_version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "agent_network_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "policy", "attachment"],
      "properties": {
        "agent_id": {
          "$ref": "#/$defs/id"
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy_id",
            "revision",
            "resource_version",
            "spec",
            "digest"
          ],
          "properties": {
            "policy_id": {
              "$ref": "#/$defs/network_policy_id"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "resource_version": {
              "type": "integer",
              "minimum": 1
            },
            "spec": {
              "$ref": "#/$defs/network_policy_spec"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          }
        },
        "attachment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "resource_version"],
          "properties": {
            "state": {
              "enum": ["open", "closed"]
            },
            "resource_version": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "desired_state": {
      "enum": ["enabled", "disabled", "deleted"]
    },
    "lifecycle_state": {
      "enum": ["not_created", "created", "deleted"]
    },
    "activation_state": {
      "enum": ["enabled", "disabled"]
    },
    "runtime_state": {
      "enum": [
        "waiting",
        "available",
        "unhealthy",
        "exited",
        "absent",
        "unknown"
      ]
    },
    "runtime_resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memory_bytes", "pids_limit", "tmpfs_bytes"],
      "properties": {
        "memory_bytes": {
          "type": "integer",
          "minimum": 134217728
        },
        "pids_limit": {
          "type": "integer",
          "minimum": 16,
          "maximum": 32768
        },
        "tmpfs_bytes": {
          "type": "integer",
          "minimum": 16777216
        }
      }
    },
    "runtime_draft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image_ref",
        "resources"
      ],
      "properties": {
        "image_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Caller-selected image reference, preserved verbatim. Syntax is validated; image availability is checked at Runtime creation."
        },
        "resources": {
          "$ref": "#/$defs/runtime_resources"
        },
        "mcp_servers": {
          "$ref": "../runtime/managed-mcp.schema.json#/$defs/servers_write"
        }
      }
    },
    "runtime_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image_ref",
        "resources"
      ],
      "properties": {
        "image_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Caller-selected image reference, preserved verbatim. Syntax is validated; image availability is checked at Runtime creation."
        },
        "resources": {
          "$ref": "#/$defs/runtime_resources"
        },
        "mcp_servers": {
          "$ref": "../runtime/managed-mcp.schema.json#/$defs/servers_read"
        }
      }
    },
    "model_pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "input_per_million", "output_per_million"],
      "properties": {
        "currency": {
          "const": "USD",
          "type": "string"
        },
        "input_per_million": {
          "type": "number",
          "minimum": 0
        },
        "output_per_million": {
          "type": "number",
          "minimum": 0
        },
        "cache_read_per_million": {
          "type": "number",
          "minimum": 0
        },
        "cache_write_per_million": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "model_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_url",
        "model",
        "context_window",
        "max_output_tokens",
        "supports_images"
      ],
      "properties": {
        "base_url": {
          "type": "string",
          "format": "uri"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "context_window": {
          "type": "integer",
          "minimum": 1024
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "supports_images": {
          "type": "boolean"
        },
        "supports_audio": {
          "type": "boolean",
          "default": false
        },
        "supports_pdf": {
          "type": "boolean",
          "default": false
        },
        "pricing": {
          "$ref": "#/$defs/model_pricing"
        }
      }
    },
    "create_model_profile_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "organization_id",
        "profile_key",
        "display_name",
        "model",
        "provider_connection_id"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/id"
        },
        "organization_id": {
          "$ref": "#/$defs/id"
        },
        "profile_key": {
          "$ref": "#/$defs/id"
        },
        "display_name": {
          "$ref": "#/$defs/model_display_name"
        },
        "model": {
          "$ref": "#/$defs/model_parameters"
        },
        "provider_connection_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "revise_model_profile_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "organization_id",
        "expected_version",
        "display_name",
        "model"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/id"
        },
        "organization_id": {
          "$ref": "#/$defs/id"
        },
        "display_name": {
          "$ref": "#/$defs/model_display_name"
        },
        "expected_version": {
          "type": "integer",
          "minimum": 1
        },
        "model": {
          "$ref": "#/$defs/model_parameters"
        }
      }
    },
    "model_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_profile_id",
        "organization_id",
        "profile_key",
        "display_name",
        "revision_id",
        "revision",
        "enabled",
        "model",
        "created_at",
        "updated_at",
        "provider_connection_id"
      ],
      "properties": {
        "model_profile_id": {
          "$ref": "#/$defs/id"
        },
        "organization_id": {
          "$ref": "#/$defs/id"
        },
        "profile_key": {
          "$ref": "#/$defs/id"
        },
        "display_name": {
          "type": "string"
        },
        "revision_id": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "enabled": {
          "type": "boolean"
        },
        "model": {
          "$ref": "#/$defs/model_input"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        },
        "provider_connection_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "model_profile_list": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "next_after_id"],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/model_profile"
          }
        },
        "next_after_id": {
          "type": ["string", "null"]
        }
      }
    },
    "create_template_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "organization_id",
        "template_key",
        "name",
        "model_profile_id",
        "system_prompt",
        "max_model_requests",
        "context_policy_version",
        "runtime"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/id"
        },
        "organization_id": {
          "$ref": "#/$defs/id"
        },
        "template_key": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "system_prompt": {
          "type": "string",
          "maxLength": 1048576
        },
        "max_model_requests": {
