{
  "name": "@antnest/admin-console-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "tsc -b && vite --config vite.config.ts build",
    "typecheck": "tsc -b --pretty false",
    "test": "npm run test:unit && npm run test:components",
    "test:unit": "node --test --experimental-strip-types src/lib/*.test.ts",
    "test:components": "vitest run --config vitest.config.ts",
    "test:browser:audit": "node ../../../tests/integration/admin-console/execution-audit-browser.mjs",
    "test:browser:catalog": "node ../../../tests/integration/admin-console/catalog-browser.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "jsdom": "^30.0.1",
    "playwright": "1.62.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vitest": "^4.1.11"
  }
}
