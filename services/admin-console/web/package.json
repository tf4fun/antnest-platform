{
  "name": "@antnest/admin-console-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "tsc -b && vite --config vite.config.ts build",
    "typecheck": "tsc -b --pretty false",
    "test": "npm run test:unit && npm run test:components",
    "test:unit": "node --test --experimental-strip-types src/lib/*.test.ts",
    "test:components": "vitest run --config vitest.config.ts",
    "test:browser:audit": "node ../../../tests/integration/admin-console/execution-audit-browser.mjs",
    "test:browser:catalog": "node ../../../tests/integration/admin-console/catalog-browser.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "playwright": "1.63.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
