{
  "name": "@antnest/agent-ui-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "npm run build:bridge && node server/dist/main.js",
    "build": "npm run build:bridge",
    "build:bridge": "npm run build:server && npm run typecheck && npm run build:ssr",
    "build:ssr": "vite build --config vite.ssr-client.config.ts && vite build --ssr src/entry-server.tsx --outDir dist/ssr --emptyOutDir false",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc -b --pretty false",
    "test": "npm run test:server && npm run test:unit && npm run test:components",
    "test:server": "node --test --test-concurrency=1 --experimental-strip-types server/test/*.test.ts",
    "test:bridge:integration": "npm run build:server && node --expose-gc --test --test-concurrency=1 ../../../tests/integration/agent-ui/acp-http-bridge.test.mjs ../../../tests/integration/agent-ui/dev-entry.test.mjs ../../../tests/integration/agent-ui/workspace-http-deadline.test.mjs ../../../tests/integration/agent-ui/workspace-node-http.test.mjs ../../../tests/integration/agent-ui/workspace-sse-backpressure.test.mjs",
    "test:bridge:memory": "node --expose-gc --experimental-strip-types --test ../../../tests/integration/agent-ui/workspace-memory-efficiency.test.mjs",
    "test:bridge:runtime-memory": "node --expose-gc --experimental-strip-types --test ../../../tests/integration/agent-ui/workspace-runtime-memory.test.mjs",
    "test:bridge:soak": "npm run build:server && ANTNEST_UI_SSE_SOAK=1 node --expose-gc --test ../../../tests/integration/agent-ui/workspace-sse-backpressure.test.mjs",
    "test:bridge:docker": "node --test ../../../tests/e2e/agent-ui/bridge-container.test.mjs",
    "test:controls:docker": "node --test ../../../tests/e2e/agent-ui/workspace-controls.test.mjs",
    "test:bridge:docker:soak": "ANTNEST_UI_DOCKER_SOAK=1 node --test ../../../tests/e2e/agent-ui/bridge-container.test.mjs",
    "test:unit": "node --test --test-concurrency=1 --experimental-strip-types src/lib/*.test.ts",
    "test:components": "vitest run --config vitest.config.ts",
    "test:browser": "npm run build && node --test --test-concurrency=1 ../../../tests/integration/agent-ui/workspace-bridge-browser.test.mjs ../../../tests/integration/agent-ui/workspace-ssr-browser.test.mjs",
    "test:bridge:browser": "npm run test:browser"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.5.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
