{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antnest.local/runtime-controller/api/runtime-deployment.schema.json",
  "title": "Antnest Runtime Configuration",
  "description": "Caller-owned Runtime policy. Runtime Controller injects identity, internal generation, listener, filesystem, and platform mapping.",
  "type": "object",
  "additionalProperties": false,
  "required": ["image_ref", "network", "resources"],
  "dependentRequired": {
    "organization_id": ["system_skills", "prepared_skill_set", "prepared_reference_id"],
    "system_skills": ["organization_id", "prepared_skill_set", "prepared_reference_id"],
    "prepared_skill_set": ["organization_id", "system_skills", "prepared_reference_id"],
    "prepared_reference_id": ["organization_id", "system_skills", "prepared_skill_set"]
  },
  "properties": {
    "organization_id": {"type": "string", "pattern": "^org_[0-9a-f]{32}$"},
    "system_skills": {"type": "array", "maxItems": 32, "items": {"$ref": "../../../contracts/skill-registry/runtime-delivery.schema.json#/$defs/frozen_skill"}},
    "prepared_skill_set": {"$ref": "../../../contracts/skill-registry/runtime-delivery.schema.json#/$defs/prepared_skill_set"},
    "prepared_reference_id": {"type": "string", "pattern": "^psr_[0-9a-f]{32}$"},
    "mcp_servers": {
      "$ref": "../../../contracts/runtime/runtime-spec.schema.json#/properties/mcp_servers"
    },
    "image_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^\\S+$",
      "description": "Caller-selected image name, tag or digest; validated using the image reference parser and passed unchanged to container creation."
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packet_contract_revision", "egress_endpoint", "tunnel_ipv4", "resolver_ipv4"],
      "properties": {
        "packet_contract_revision": {"type": "integer", "const": 1},
        "egress_endpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ipv4", "port"],
          "properties": {
            "ipv4": {"type": "string", "format": "ipv4"},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535}
          }
        },
        "tunnel_ipv4": {"type": "string", "format": "ipv4"},
        "resolver_ipv4": {"type": "string", "format": "ipv4"}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memory_bytes", "pids_limit", "tmpfs_bytes"],
      "properties": {
        "memory_bytes": {"type": "integer", "minimum": 134217728, "maximum": 9223372036854775807},
        "pids_limit": {"type": "integer", "minimum": 16, "maximum": 32768},
        "tmpfs_bytes": {"type": "integer", "minimum": 16777216, "maximum": 9223372036854775807}
      }
    }
  }
}
