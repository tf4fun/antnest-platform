# Generate empty secret fields with scripts/generate-dev-env.sh.
ANTNEST_EGRESS_POSTGRES_PASSWORD=
ANTNEST_RUNTIME_CONTROLLER_POSTGRES_PASSWORD=
ANTNEST_AGENT_ACP_POSTGRES_PASSWORD=
ANTNEST_IDENTITY_POSTGRES_PASSWORD=
ANTNEST_AGENT_CONTROLLER_POSTGRES_PASSWORD=
ANTNEST_SKILL_REGISTRY_POSTGRES_PASSWORD=
# Prepare workload/CCT/Runtime credentials with scripts/dev-service-tokens.mjs.
# Source its private deployment.env before Compose/build; never use public tokens.
# --with-skill-learning also configures automatic learning/current-Run discovery.
ANTNEST_ACP_SKILL_MAINTENANCE_SIGNING_KID=
ANTNEST_ACP_SKILL_MAINTENANCE_SIGNING_KEY=
# Public current/next Ed25519 keys, frozen into newly created/rebuilt Runtimes.
ANTNEST_RUNTIME_SKILL_MAINTENANCE_VERIFIERS=
ANTNEST_TEMPORAL_POSTGRES_PASSWORD=
# Diagnostic host ports take effect only with compose.debug.yaml.
ANTNEST_TEMPORAL_HOST_PORT=7233
ANTNEST_IDENTITY_ENCRYPTION_KEY=
ANTNEST_AGENT_CONTROLLER_ENCRYPTION_KEY=
# Alternatively use a ring and active ID, emptying the corresponding single key.
# Exact kid:base64key entries, comma-separated; no whitespace is trimmed.
ANTNEST_IDENTITY_ENCRYPTION_KEYS=
ANTNEST_IDENTITY_ENCRYPTION_ACTIVE_KID=
ANTNEST_AGENT_CONTROLLER_ENCRYPTION_KEYS=
ANTNEST_AGENT_CONTROLLER_ENCRYPTION_ACTIVE_KID=
ANTNEST_BOOTSTRAP_ORGANIZATION_SLUG=engineering
ANTNEST_BOOTSTRAP_ORGANIZATION_NAME=Engineering
ANTNEST_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
ANTNEST_BOOTSTRAP_ADMIN_PASSWORD=
ANTNEST_ACP_CLIENT_MCP_KEY=
ANTNEST_ADMIN_DEFAULT_RUNTIME_IMAGE_REF=antnest/antnest-runtime:local
ANTNEST_AGENT_CONTROLLER_URL=http://agent-controller:8080
# Controller publishes execution configuration. Opt-in Skill maintenance reads
# the existing owner-scoped learning policy through its separate Controller port.
ANTNEST_AGENT_ACP_CONTROL_URL=http://agent-acp-control:8081
ANTNEST_PROVIDER_ALLOW_PRIVATE_ENDPOINTS=false
ANTNEST_ACP_MAX_CONFIGURATION_BYTES=16777216
ANTNEST_ACP_RUN_TIMEOUT=30m
ANTNEST_AGENT_CONTROLLER_EXECUTION_RESYNC_INTERVAL=30s
ANTNEST_AGENT_CONTROLLER_EXECUTION_RETRY_INTERVAL=1s
ANTNEST_AGENT_CONTROLLER_EXECUTION_MAX_RETRY_INTERVAL=30s
ANTNEST_AGENT_CONTROLLER_EXECUTION_REQUEST_TIMEOUT=15s
ANTNEST_RUNTIME_MANAGEMENT_NETWORK=antnest-runtime-management
ANTNEST_RUNTIME_CONTROLLER_SCOPE=antnest-platform
ANTNEST_RUNTIME_CONTROLLER_MONITOR_MAX_RETRY_DELAY=30s
ANTNEST_RUNTIME_SYSTEM_SKILLS_VOLUME=antnest-system-skills
ANTNEST_RUNTIME_MANAGEMENT_SUBNET=172.30.255.0/24
ANTNEST_SERVICE_NETWORK_PREFIX=10.241.0
ANTNEST_RUNTIME_MANAGEMENT_IP_RANGE=172.30.255.128/25
ANTNEST_EGRESS_IPV4=172.30.255.3
ANTNEST_RUNTIME_OTLP_INGRESS_IPV4=172.30.255.4
ANTNEST_RUNTIME_CONTROLLER_MANAGEMENT_IPV4=172.30.255.5
ANTNEST_ACP_MANAGEMENT_IPV4=172.30.255.6
ANTNEST_EGRESS_CONTROL_SUBNET=172.31.255.0/24
ANTNEST_EGRESS_CONTROL_IPV4=172.31.255.3
ANTNEST_AGENT_CONTROLLER_CONTROL_IPV4=172.31.255.4
ANTNEST_RUNTIME_CONTROLLER_CONTROL_IPV4=172.31.255.5
ANTNEST_RUNTIME_MUTATION_TIMEOUT=2m
ANTNEST_EDGE_HOST_PORT=8090
ANTNEST_EDGE_PUBLIC_BASE_URL=http://127.0.0.1:8090
ANTNEST_EDGE_COOKIE_SECURE=false
# Capture complete discrete RPC JSON (may contain secrets). HTTP/streams stay metadata-only.
ANTNEST_TELEMETRY_CAPTURE_RPC_CONTENT=false
ANTNEST_POSTGRES_HOST_PORT=55432
ANTNEST_JAEGER_UI_HOST_PORT=16686
# Enable SDKs only when starting the observability profile/collector.
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
ANTNEST_RUNTIME_OTEL_EXPORTER_OTLP_ENDPOINT=http://172.30.255.4:4318
COMPOSE_PROJECT_NAME=antnest-platform
# PostgreSQL administrator password is generated independently.
ANTNEST_POSTGRES_ADMIN_PASSWORD=
